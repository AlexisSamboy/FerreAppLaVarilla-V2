@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService
@inject NavigationManager Navigation

<PageTitle>FerreAppLaVarilla - Inicio</PageTitle>

<div class="home-page">

    <!-- NAVBAR -->

    <header class="navbar">

        <div class="logo" @onclick="IrAlInicio">
            <span class="logo-icon">⚡</span>

            <div>
                <h1>FerreApp<span>LaVarilla</span></h1>
                <p>Ferretería Inteligente</p>
            </div>
        </div>

        <nav class="nav-links">

            <a href="/">Inicio</a>
            <a href="/productos">Productos</a>
            <a href="#">Ofertas</a>
            <a href="#">Nosotros</a>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a href="/panel-admin" class="admin-link">
                        ⚙️ Panel Admin
                    </a>
                </Authorized>
            </AuthorizeView>

        </nav>

        <div class="nav-actions">

            <AuthorizeView>

                <Authorized>

                    <div class="user-box">

                        <div class="user-avatar">
                            👤
                        </div>

                        <div class="user-info">
                            <strong>
                                @context.User.Identity?.Name
                            </strong>

                            <small>
                                Sesión activa
                            </small>
                        </div>

                    </div>

                    <button class="logout-btn" @onclick="CerrarSesion">
                        Cerrar sesión
                    </button>

                </Authorized>

                <NotAuthorized>

                    <button class="login-btn" @onclick="IrALogin">
                        Iniciar sesión
                    </button>

                </NotAuthorized>

            </AuthorizeView>

        </div>

    </header>

    <!-- HERO -->

    <section class="hero">

        <div class="hero-overlay"></div>

        <div class="hero-content">

            <div class="hero-text">

                <span class="hero-badge">
                    🔥 Ofertas activas esta semana
                </span>

                <h1>
                    Todo lo que necesitas
                    para construir, reparar
                    y transformar.
                </h1>

                <p>
                    Herramientas, materiales y equipos de calidad
                    para profesionales y hogares.
                </p>

                <div class="hero-buttons">

                    <button class="primary-btn" @onclick="IrAProductos">
                        Ver productos
                    </button>

                    <button class="secondary-btn">
                        Ver promociones
                    </button>

                </div>

            </div>

        </div>

    </section>

    <!-- CARRUSEL OFERTAS -->

    <section class="offers-section">

        <div class="section-header">

            <div>
                <h2>🔥 Ofertas destacadas</h2>
                <p>
                    Promociones activas en herramientas,
                    materiales y equipos.
                </p>
            </div>

            <a href="#">
                Ver todas
            </a>

        </div>

        <div class="offers-carousel">

            <div class="offer-card">

                <img src="images/descuento dia del padre.png" />

                <div class="offer-content">

                    <span class="discount">
                        -35%
                    </span>

                    <h3>
                        Especial Día de Padres
                    </h3>

                    <p>
                        Descuentos en herramientas eléctricas
                        y materiales de construcción.
                    </p>

                    <button>
                        Aprovechar oferta
                    </button>

                </div>

            </div>

            <div class="offer-card">

                <img src="images/rifa dia del padre.png" />

                <div class="offer-content">

                    <span class="discount blue">
                        Concurso
                    </span>

                    <h3>
                        Rifa de Vehículo
                    </h3>

                    <p>
                        Participa por compras superiores
                        a RD$5,000.
                    </p>

                    <button>
                        Participar
                    </button>

                </div>

            </div>

            <div class="offer-card">

                <img src="images/materiales contruccion.jpg" />

                <div class="offer-content">

                    <span class="discount green">
                        Combo
                    </span>

                    <h3>
                        Materiales Premium
                    </h3>

                    <p>
                        Precios especiales en cemento,
                        blocks y acero.
                    </p>

                    <button>
                        Ver productos
                    </button>

                </div>

            </div>

        </div>

    </section>

    <!-- BENEFICIOS -->

    <section class="benefits">

        <div class="benefit-card">
            <div class="benefit-icon">🚚</div>
            <h3>Despacho rápido</h3>
            <p>
                Envíos eficientes y organizados.
            </p>
        </div>

        <div class="benefit-card">
            <div class="benefit-icon">🛡️</div>
            <h3>Calidad garantizada</h3>
            <p>
                Solo trabajamos con marcas confiables.
            </p>
        </div>

        <div class="benefit-card">
            <div class="benefit-icon">📦</div>
            <h3>Amplio inventario</h3>
            <p>
                Miles de productos disponibles.
            </p>
        </div>

        <div class="benefit-card">
            <div class="benefit-icon">🎧</div>
            <h3>Atención personalizada</h3>
            <p>
                Soporte rápido y asesoría profesional.
            </p>
        </div>

    </section>

    <!-- INSTALACIONES -->

    <section class="installations">

        <div class="section-center">

            <h2>Nuestras instalaciones</h2>

            <p>
                Conoce nuestros espacios y áreas de atención.
            </p>

        </div>

        <div class="installations-grid">

            <div class="installation-card large">
                <img src="images/ferreapp la varilla.png" />
            </div>

            <div class="installation-card">
                <img src="images/area de caja.png" />
            </div>

            <div class="installation-card">
                <img src="images/pasillos.png" />
            </div>

            <div class="installation-card">
                <img src="images/ubicacion.png" />
            </div>

        </div>

    </section>

    <!-- CATEGORIAS -->

    <section class="categories">

        <div class="section-header">

            <div>
                <h2>Categorías destacadas</h2>
                <p>
                    Explora nuestras líneas principales.
                </p>
            </div>

        </div>

        <div class="categories-grid">

            <div class="category-card">
                <img src="images/herramientas-hogar.png" />
                <p>Herramientas</p>
            </div>

            <div class="category-card">
                <img src="images/materiales.jpg" />
                <p>Materiales</p>
            </div>

            <div class="category-card">
                <img src="images/tornillos.png" />
                <p>Tornillería</p>
            </div>

            <div class="category-card">
                <img src="images/pintura.png" />
                <p>Pinturas</p>
            </div>

            <div class="category-card">
                <img src="images/alambre.png" />
                <p>Electricidad</p>
            </div>

            <div class="category-card">
                <img src="images/plomeria.png" />
                <p>Plomería</p>
            </div>

        </div>

    </section>
    <footer class="modern-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <div class="logo-text footer-logo">
                    <h2>FerreApp<span>LaVarilla</span></h2>
                </div>
                <p>Tu aliado estratégico en construcción y ferretería. Brindamos soluciones inteligentes para cada uno de tus proyectos.</p>
            </div>

            <div class="footer-links">
                <h3>Enlaces Rápidos</h3>
                <ul>
                    <li><a href="/">Inicio</a></li>
                    <li><a href="/productos">Catálogo de Productos</a></li>
                    <li><a href="#">Ofertas de Temporada</a></li>
                    <li><a href="#">Sobre Nosotros</a></li>
                </ul>
            </div>

            <div class="footer-contact">
                <h3>Visítanos</h3>
                <ul class="contact-info">
                    <li>📍 <strong>Dirección:</strong> Profeta Elias, Baní 94000</li>
                    <li>📞 <strong>Teléfono:</strong> +1 (809) 000-0000</li>
                    <li>✉️ <strong>Email:</strong> contacto@ferreapplavarilla.com</li>
                    <li>🕒 <strong>Horario:</strong> Lun - Sáb: 8:00 AM - 6:00 PM</li>
                </ul>
            </div>
        </div>
        
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year FerreApp La Varilla. Todos los derechos reservados.</p>
        </div>
    </footer>

    <style>
            /* VARIABLES (Si ya las tienes en tu CSS global, puedes omitir este bloque :root) */
            :root {
                --secondary-color: #ea580c; /* Naranja ferretero */
                --transition: all 0.3s ease;
            }

            /* FOOTER ESTILOS */
            .modern-footer {
                background: #0f172a;
                color: #f8fafc;
                padding: 4rem 2rem 1rem 2rem;
                margin-top: 4rem;
                font-family: 'Segoe UI', system-ui, sans-serif;
            }
    
            .footer-container {
                max-width: 1200px;
                margin: 0 auto;
                display: grid;
                grid-template-columns: 2fr 1fr 1fr;
                gap: 4rem;
                margin-bottom: 3rem;
            }
    
            .footer-logo h2 {
                color: white;
                margin: 0;
                font-size: 1.5rem;
                font-weight: 800;
            }
    
            .footer-logo span {
                color: var(--secondary-color);
            }
    
            .footer-brand p {
                color: #94a3b8;
                line-height: 1.6;
                margin-top: 1rem;
                max-width: 400px;
            }
    
            .footer-links h3, .footer-contact h3 {
                color: white;
                margin-bottom: 1.5rem;
                font-size: 1.2rem;
            }
    
            .footer-links ul, .footer-contact ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }
    
            .footer-links li {
                margin-bottom: 0.8rem;
            }
    
            .footer-links a {
                color: #94a3b8;
                text-decoration: none;
                transition: var(--transition);
            }
    
                .footer-links a:hover {
                    color: var(--secondary-color);
                    padding-left: 5px;
                }
    
            .contact-info li {
                color: #94a3b8;
                margin-bottom: 1rem;
                display: flex;
                gap: 10px;
            }
    
            .contact-info strong {
                color: white;
            }
    
            .footer-bottom {
                max-width: 1200px;
                margin: 0 auto;
                padding-top: 2rem;
                border-top: 1px solid rgba(255,255,255,0.1);
                text-align: center;
                color: #64748b;
                font-size: 0.9rem;
            }

            /* RESPONSIVE FOOTER */
            @@media (max-width: 768px) {
                .footer-container {
                    grid-template-columns: 1fr;
                    gap: 2rem;
                }
            }
    </style>
</div>

@code {

    private void IrALogin()
    {
        Navigation.NavigateTo("/login");
    }

    private void IrAProductos()
    {
        Navigation.NavigateTo("/productos");
    }

    private void IrAlInicio()
    {
        Navigation.NavigateTo("/");
    }

    private void CerrarSesion()
    {
        AuthService.CerrarSesion();
        Navigation.NavigateTo("/");
    }

}