@page "/mi-tienda"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Data
@using System.Security.Claims

@attribute [Authorize(Roles = "Cliente")]

@inject ApplicationDbContext _context
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject FerreAppLaVarilla.UI.Services.PedidoNotificationService NotificadorPedidos

<PageTitle>Mi Panel - FerreApp La Varilla</PageTitle>

<div class="pos-layout">

    <aside class="sidebar">
        <div class="logo-section">
            <div class="logo-icon">⚡</div>
            <div>
                <h1>FerreApp</h1>
                <span>La Varilla</span>
            </div>
        </div>

        <nav class="sidebar-menu">
            <button class="menu-item @(vistaActual == "Tienda" ? "active" : "")" @onclick='() => CambiarVista("Tienda")'>
                <span class="icon">🛒</span> Tienda y Catálogo
            </button>
            <button class="menu-item @(vistaActual == "Pedidos" ? "active" : "")" @onclick='() => CambiarVista("Pedidos")'>
                <span class="icon">📦</span> Mis Pedidos
            </button>
            <button class="menu-item @(vistaActual == "Perfil" ? "active" : "")" @onclick='() => CambiarVista("Perfil")'>
                <span class="icon">⚙️</span> Mi Perfil
            </button>
        </nav>
        
        <div class="sidebar-footer mt-auto">
            <button class="menu-item text-danger" @onclick="CerrarSesion">
                <span class="icon">🚪</span> Cerrar Sesión
            </button>
            <div class="support-card mt-3">
                <h4>Soporte Técnico</h4>
                <p>¿Necesitas ayuda con tu pedido?</p>
                <button class="btn-support">💬 Contactar a ventas</button>
            </div>
        </div>
    </aside>

    <main class="main-content">
        
        <header class="topbar">
            <div class="topbar-left">
                @if (vistaActual == "Tienda") {
                    <h2>Catálogo de Productos</h2>
                    <p>Agrega los materiales que necesitas a tu carrito</p>
                } else if (vistaActual == "Pedidos") {
                    <h2>Historial de Compras</h2>
                    <p>Revisa el estado de tus pedidos y cotizaciones</p>
                } else {
                    <h2>Mi Perfil</h2>
                    <p>Actualiza tu información personal y de entrega</p>
                }
            </div>
            
            <div class="topbar-right">
                <div class="info-pill">
                    <small>Hora Actual</small>
                    <strong>@DateTime.Now.ToString("hh:mm tt")</strong>
                </div>
                <div class="user-pill">
                    <div class="avatar">👤</div>
                    <div class="user-details">
                        <strong>@nombreCliente</strong>
                        <span>Cliente VIP</span>
                    </div>
                </div>
            </div>
        </header>

        <div class="content-wrapper @(vistaActual == "Tienda" ? "has-cart" : "")">
            
            @if (vistaActual == "Tienda")
            {
                <div class="products-area">
                    
                    <div class="search-container mb-3">
                        <span class="search-icon">🔍</span>
                        <input type="text" placeholder="Buscar herramientas, materiales..." @bind="textoBusqueda" @bind:event="oninput" @onkeyup="AplicarFiltros" class="search-input" />
                    </div>

                    <div class="category-filters mb-4">
                        @foreach (var cat in categoriasDefecto)
                        {
                            <button class="cat-pill @(categoriaSeleccionada == cat ? "active" : "")" @onclick="() => SeleccionarCategoria(cat)">
                                @cat
                            </button>
                        }
                    </div>

                    <div class="products-grid">
                        @if (productosMostrar == null || !productosMostrar.Any())
                        {
                            <div class="empty-state">
                                <span>📦</span>
                                <p>No se encontraron productos con estos filtros.</p>
                            </div>
                        }
                        else
                        {
                            @foreach (var prodVM in productosMostrar)
                            {
                                <div class="product-card">
                                    <div class="product-image">
                                        <img src="images/@(string.IsNullOrEmpty(prodVM.Producto.ImagenUrl) ? "default.png" : prodVM.Producto.ImagenUrl)" onerror="this.src='images/default.png'" />
                                    </div>
                                    <div class="product-info">
                                        <h4>@prodVM.Producto.Nombre</h4>
                                        <h3 class="price">RD$ @prodVM.Producto.Precio.ToString("N2")</h3>
                                        
                                        <div class="action-row">
                                            <span class="stock">Stock: @prodVM.Producto.Stock</span>
                                            
                                            <div class="qty-and-btn">
                                                <div class="qty-selector">
                                                    <button @onclick="() => { if(prodVM.CantidadAdd > 1) prodVM.CantidadAdd--; }">-</button>
                                                    <input type="number" @bind="prodVM.CantidadAdd" min="1" max="@prodVM.Producto.Stock" />
                                                    <button @onclick="() => { if(prodVM.CantidadAdd < prodVM.Producto.Stock) prodVM.CantidadAdd++; }">+</button>
                                                </div>
                                                <button class="add-btn" @onclick="() => AgregarAlCarrito(prodVM)">Agregar</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @if(totalPaginas > 1)
                    {
                        <div class="pagination">
                            <button class="page-btn" disabled="@(paginaActual == 1)" @onclick="PaginaAnterior">Anterior</button>
                            <span class="page-info">Página <strong>@paginaActual</strong> de @totalPaginas</span>
                            <button class="page-btn" disabled="@(paginaActual == totalPaginas)" @onclick="PaginaSiguiente">Siguiente</button>
                        </div>
                    }
                </div>

                <div class="cart-section">
                    <div class="cart-panel">
                        <div class="cart-header">
                            <h3>🛒 Mi Carrito</h3>
                            <span class="cart-badge">@carrito.Sum(x => x.Cantidad)</span>
                        </div>

                        <div class="cart-items">
                            @if (!carrito.Any())
                            {
                                <div class="empty-cart">No hay productos agregados.</div>
                            }
                            @foreach (var item in carrito)
                            {
                                <div class="cart-item">
                                    <div class="item-info">
                                        <h4>@item.Producto.Nombre</h4>
                                        <p>RD$ @item.Producto.Precio.ToString("N2")</p>
                                    </div>
                                    <div class="item-actions">
                                        <div class="qty-box">
                                            <button @onclick="() => RestarCantidad(item)">-</button>
                                            <span>@item.Cantidad</span>
                                            <button @onclick="() => SumarCantidad(item)">+</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="cart-totals">
                            <div class="total-row"><span>Subtotal</span> <strong>RD$ @Subtotal.ToString("N2")</strong></div>
                            <div class="total-row"><span>ITBIS (18%)</span> <strong>RD$ @Itbis.ToString("N2")</strong></div>
                            <div class="total-row grand"><span>Total</span> <h3>RD$ @Total.ToString("N2")</h3></div>
                        </div>
                        
                        @if (!string.IsNullOrEmpty(mensajeErrorPedido))
                        {
                            <div class="alert-error mt-2">@mensajeErrorPedido</div>
                        }

                        <button class="checkout-btn" disabled="@(!carrito.Any())" @onclick="ProcesarPedido">
                            ✅ Solicitar Pedido
                        </button>
                    </div>
                </div>
            }

            @if (vistaActual == "Pedidos")
            {
                <div class="full-panel">
                    <div class="table-container">
                        <table class="modern-table">
                            <thead>
                                <tr>
                                    <th>Factura / Pedido</th>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Total</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!misPedidos.Any())
                                {
                                    <tr><td colspan="5" class="text-center">No has realizado ninguna compra aún.</td></tr>
                                }
                                @foreach (var ped in misPedidos)
                                {
                                    <tr>
                                        <td><strong>FAC-@ped.Id.ToString("D4")</strong></td>
                                        <td>@ped.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                        <td>@ped.TipoDocumento</td>
                                        <td><strong>RD$ @((ped.Articulos?.Sum(a => a.PrecioUnitario * a.Cantidad * 1.18m) ?? 0).ToString("N2"))</strong></td>
                                        <td><span class="status-pill @(ped.Estado == EstadoPedido.Completado ? "completed" : "pending")">@ped.Estado</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (vistaActual == "Perfil")
            {
                <div class="perfil-modern-container">
                    <div class="perfil-modern-card">
                        
                        <div class="perfil-left-col">
                            <div class="gran-avatar">👤</div>
                            <h3>@nombreCliente</h3>
                            <p>@correoUsuario</p>
                            <span class="badge-vip">Cliente Verificado</span>
                        </div>

                        <div class="perfil-right-col">
                            <h4>Datos Personales</h4>
                            <p class="text-muted">Mantén tu información actualizada para evitar problemas con los envíos.</p>

                            @if (!string.IsNullOrEmpty(mensajePerfil))
                            {
                                <div class="alert-success">✅ @mensajePerfil</div>
                            }
                            @if (!string.IsNullOrEmpty(mensajeErrorPerfil))
                            {
                                <div class="alert-error">❌ @mensajeErrorPerfil</div>
                            }

                            <div class="p-grid">
                                <div class="p-input-box">
                                    <label>Nombre Completo</label>
                                    <input type="text" @bind="clienteActual.NombreCompleto" class="p-input" />
                                </div>
                                <div class="p-input-box">
                                    <label>Cédula / RNC</label>
                                    <input type="text" @bind="clienteActual.CedulaRNC" class="p-input" placeholder="Requerido para comprar" />
                                </div>
                                <div class="p-input-box">
                                    <label>Teléfono</label>
                                    <input type="text" @bind="clienteActual.Telefono" class="p-input" />
                                </div>
                                <div class="p-input-box">
                                    <label>Correo Electrónico</label>
                                    <input type="text" value="@clienteActual.CorreoElectronico" class="p-input disabled" disabled />
                                </div>
                                <div class="p-input-box p-full">
                                    <label>Dirección de Entrega</label>
                                    <textarea @bind="clienteActual.DireccionEntrega" class="p-input p-textarea" placeholder="Ciudad, Sector, Calle..."></textarea>
                                </div>
                            </div>
                            
                            <div class="p-actions">
                                <button class="btn-guardar-perfil" @onclick="GuardarPerfil">💾 Guardar Cambios</button>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private string vistaActual = "Tienda";
    private string nombreCliente = "Cargando...";
    private string correoUsuario = "";
    
    private string mensajePerfil = "";
    private string mensajeErrorPerfil = "";
    private string mensajeErrorPedido = "";
    
    private Cliente clienteActual = new Cliente { NombreCompleto = "", CedulaRNC = "", Telefono = "", DireccionEntrega = "", CorreoElectronico = "" };
    
    private List<Producto>? todosLosProductos;
    private List<Pedido> misPedidos = new();
    
    public class ProductoStoreVM {
        public required Producto Producto { get; set; }
        public int CantidadAdd { get; set; } = 1;
    }
    private List<ProductoStoreVM> productosMostrar = new();

    private string textoBusqueda = "";
    private string categoriaSeleccionada = "Todos";
    private List<string> categoriasDefecto = new() { "Todos", "Herramientas", "Materiales", "Electricidad", "Pinturas", "Plomería" };
    
    private int paginaActual = 1;
    private int productosPorPagina = 8;
    private int totalPaginas = 1;

    public class ItemCarrito {
        public required Producto Producto { get; set; }
        public int Cantidad { get; set; } = 1;
        public decimal Subtotal => Producto.Precio * Cantidad;
    }
    private List<ItemCarrito> carrito = new();
    private decimal Subtotal => carrito.Sum(i => i.Subtotal);
    private decimal Itbis => Subtotal * 0.18m;
    private decimal Total => Subtotal + Itbis;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            nombreCliente = user.Identity.Name ?? "Cliente";
            correoUsuario = user.FindFirst(c => c.Type == ClaimTypes.Email)?.Value ?? "";

            if(!string.IsNullOrEmpty(correoUsuario)) 
            {
                var clienteDb = await _context.Clientes.AsNoTracking().FirstOrDefaultAsync(c => c.CorreoElectronico == correoUsuario);
                
                if (clienteDb != null)
                {
                    clienteActual = clienteDb;
                }
                else
                {
                    clienteActual.NombreCompleto = nombreCliente;
                    clienteActual.CorreoElectronico = correoUsuario;
                }
            }
        }

        todosLosProductos = await _context.Productos.Where(x => x.Activo).ToListAsync();
        AplicarFiltros();
        await CargarHistorial();
    }

    private void SeleccionarCategoria(string cat)
    {
        categoriaSeleccionada = cat;
        paginaActual = 1; 
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        if (todosLosProductos == null) return;

        var query = todosLosProductos.AsEnumerable();

        if(categoriaSeleccionada != "Todos") {
            // query = query.Where(p => p.Categoria != null && p.Categoria.Equals(categoriaSeleccionada, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(textoBusqueda)) {
            query = query.Where(p => p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));
        }

        var filtrados = query.ToList();
        
        totalPaginas = (int)Math.Ceiling((double)filtrados.Count / productosPorPagina);
        if (totalPaginas == 0) totalPaginas = 1;
        if (paginaActual > totalPaginas) paginaActual = 1;

        productosMostrar = filtrados
            .Skip((paginaActual - 1) * productosPorPagina)
            .Take(productosPorPagina)
            .Select(p => new ProductoStoreVM { Producto = p, CantidadAdd = 1 })
            .ToList();
    }

    private void PaginaAnterior() { if (paginaActual > 1) { paginaActual--; AplicarFiltros(); } }
    private void PaginaSiguiente() { if (paginaActual < totalPaginas) { paginaActual++; AplicarFiltros(); } }

    private void CambiarVista(string nuevaVista) 
    {
        vistaActual = nuevaVista;
        mensajePerfil = "";
        mensajeErrorPerfil = "";
        mensajeErrorPedido = "";
    }

    private void AgregarAlCarrito(ProductoStoreVM pVM)
    {
        var existe = carrito.FirstOrDefault(x => x.Producto.Id == pVM.Producto.Id);
        if (existe != null) existe.Cantidad += pVM.CantidadAdd;
        else carrito.Add(new ItemCarrito { Producto = pVM.Producto, Cantidad = pVM.CantidadAdd });
        
        pVM.CantidadAdd = 1; 
    }

    private void SumarCantidad(ItemCarrito item) => item.Cantidad++;
    private void RestarCantidad(ItemCarrito item) {
        if (item.Cantidad > 1) item.Cantidad--;
        else carrito.Remove(item);
    }

    private async Task ProcesarPedido()
    {
        mensajeErrorPedido = "";
        
        if (clienteActual.Id == 0 || string.IsNullOrWhiteSpace(clienteActual.CedulaRNC) || string.IsNullOrWhiteSpace(clienteActual.DireccionEntrega)) 
        {
            mensajeErrorPedido = "⚠️ Ve a 'Mi Perfil' y completa tu Cédula y Dirección antes de pedir.";
            return;
        }
        if (!carrito.Any()) return;

        try
        {
            var nuevoPedido = new Pedido
            {
                FechaCreacion = DateTime.Now,
                ClienteId = clienteActual.Id,
                Estado = EstadoPedido.Pendiente,
                TipoDocumento = "Cotizacion",
                RequiereDelivery = true,
                Articulos = carrito.Select(i => new DetallePedido
                {
                    ProductoId = i.Producto.Id,
                    Cantidad = i.Cantidad,
                    PrecioUnitario = i.Producto.Precio
                }).ToList()
            };

            _context.Pedidos.Add(nuevoPedido);
            await _context.SaveChangesAsync();

            // 🔥 NUEVO: Hacemos sonar la campana para el cajero/admin
            NotificadorPedidos.NotificarNuevoPedido($"¡Nuevo pedido web recibido (FAC-{nuevoPedido.Id:D4}) de {clienteActual.NombreCompleto}!");

            carrito.Clear();
            await CargarHistorial();
            CambiarVista("Pedidos");
        }
        catch (Exception ex)
        {
            mensajeErrorPedido = "Error interno al procesar pedido.";
            Console.WriteLine(ex.Message);
        }
    }

    private async Task CargarHistorial()
    {
        if (clienteActual.Id > 0)
        {
            misPedidos = await _context.Pedidos
                .Include(p => p.Articulos)
                .Where(p => p.ClienteId == clienteActual.Id)
                .OrderByDescending(p => p.Id)
                .ToListAsync();
        }
    }

    private async Task GuardarPerfil()
    {
        mensajeErrorPerfil = "";
        mensajePerfil = "";

        if (string.IsNullOrWhiteSpace(clienteActual.CedulaRNC) || string.IsNullOrWhiteSpace(clienteActual.DireccionEntrega))
        {
            mensajeErrorPerfil = "Cédula y Dirección son obligatorias para crear el perfil.";
            return;
        }

        try
        {
            if (clienteActual.Id == 0)
            {
                _context.Clientes.Add(clienteActual);
                await _context.SaveChangesAsync();
                mensajePerfil = "¡Perfil activado correctamente!";
            }
            else
            {
                var dbCliente = await _context.Clientes.FindAsync(clienteActual.Id);
                if (dbCliente != null)
                {
                    dbCliente.NombreCompleto = clienteActual.NombreCompleto;
                    dbCliente.CedulaRNC = clienteActual.CedulaRNC;
                    dbCliente.Telefono = clienteActual.Telefono;
                    dbCliente.DireccionEntrega = clienteActual.DireccionEntrega;
                    
                    await _context.SaveChangesAsync();
                    mensajePerfil = "¡Datos actualizados!";
                }
            }
            
            nombreCliente = clienteActual.NombreCompleto;
            StateHasChanged();
            
            await Task.Delay(3000);
            mensajePerfil = "";
            StateHasChanged();
        }
        catch(Exception ex)
        {
            mensajeErrorPerfil = "Error de base de datos.";
            Console.WriteLine(ex.Message);
        }
    }

    private void CerrarSesion() => Navigation.NavigateTo("/login", forceLoad: true);
}

<style>
/* =======================================================
   ESTILOS GENERALES Y LAYOUT POS
======================================================= */
.pos-layout { display: flex; height: 100vh; overflow: hidden; background: #f5f7fb; font-family: 'Segoe UI', system-ui, sans-serif; font-size: 14px; }
.sidebar { width: 260px; background: #0b1527; color: white; padding: 25px 20px; display: flex; flex-direction: column; flex-shrink: 0; }
.logo-section { display: flex; align-items: center; gap: 15px; margin-bottom: 40px; }
.logo-icon { width: 45px; height: 45px; border-radius: 12px; background: #f4b400; display: flex; align-items: center; justify-content: center; font-size: 22px; color: #0f172a;}
.logo-section h1 { margin: 0; font-size: 20px; font-weight: 700; color: white; line-height:1.2;}
.logo-section span { color: #f4b400; font-size: 13px; }

.sidebar-menu { display: flex; flex-direction: column; gap: 8px; }
.menu-item { background: transparent; border: none; color: #94a3b8; text-align: left; padding: 14px 18px; border-radius: 12px; cursor: pointer; font-weight: 500; font-size: 15px; transition: 0.2s; display: flex; align-items: center; gap: 10px; }
.menu-item:hover { background: rgba(255,255,255,0.05); color: white; }
.menu-item.active { background: #f4b400; color: #0b1527; font-weight: 700; }
.menu-item.text-danger:hover { background: rgba(239, 68, 68, 0.1); color: #ef4444; }

.sidebar-footer { display: flex; flex-direction: column; gap: 15px; }
.support-card { background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px; }
.support-card h4 { margin: 0 0 5px 0; font-size: 14px; color: white;}
.support-card p { margin: 0 0 10px 0; font-size: 12px; color: #94a3b8;}
.btn-support { width: 100%; background: transparent; border: 1px solid rgba(255,255,255,0.2); color: white; padding: 8px; border-radius: 8px; cursor: pointer; transition: 0.2s;}
.btn-support:hover { background: rgba(255,255,255,0.1); }

.main-content { flex: 1; display: flex; flex-direction: column; padding: 25px 35px; overflow-y: auto; }
.topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
.topbar-left h2 { margin: 0; font-size: 26px; font-weight: 700; color: #0f172a; }
.topbar-left p { color: #64748b; font-size: 14px; margin: 5px 0 0 0; }

.topbar-right { display: flex; gap: 15px; align-items: center; }
.info-pill, .user-pill { background: white; padding: 8px 16px; border-radius: 30px; border: 1px solid #e2e8f0; display: flex; align-items: center; gap: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.02);}
.info-pill { flex-direction: column; align-items: flex-end; padding: 8px 16px; }
.info-pill small { font-size: 11px; color: #64748b; line-height: 1;}
.info-pill strong { font-size: 14px; color: #0f172a; }
.user-pill { padding: 6px 20px 6px 6px; }
.user-pill .avatar { width: 38px; height: 38px; border-radius: 50%; background: #3b82f6; color: white; display: flex; align-items: center; justify-content: center; font-size: 18px; }
.user-details { display: flex; flex-direction: column; }
.user-details strong { font-size: 14px; color: #0f172a; line-height: 1.2;}
.user-details span { font-size: 12px; color: #64748b; }

.content-wrapper { display: flex; flex: 1; gap: 25px; }
.content-wrapper.has-cart { grid-template-columns: 1fr 350px; display: grid; }

/* =======================================================
   ESTILOS DE LA TIENDA Y PRODUCTOS
======================================================= */
.products-area { overflow-y: auto; padding-right: 5px; display: flex; flex-direction: column; }
.search-container { position: relative; }
.search-icon { position: absolute; left: 15px; top: 50%; transform: translateY(-50%); font-size: 16px; }
.search-input { width: 100%; padding: 15px 20px 15px 45px; border-radius: 16px; border: 1px solid #e2e8f0; font-size: 15px; outline: none; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
.search-input:focus { border-color: #3b82f6; }
.category-filters { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 5px; }
.cat-pill { background: white; border: 1px solid #e2e8f0; color: #475569; padding: 8px 16px; border-radius: 20px; font-size: 13px; font-weight: 600; cursor: pointer; transition: 0.2s; white-space: nowrap; }
.cat-pill:hover { background: #f8fafc; }
