@page "/PuntoDeVenta"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Data

@attribute [Authorize(Roles = "Cajero,Admin")]

@inject ApplicationDbContext _context
@inject NavigationManager Navigation
@inject IJSRuntime JS
@* @inject FerreAppLaVarilla.UI.Services.PdfService PdfService (Descomenta si lo usas)*@

<PageTitle>Punto de Venta - FerreApp</PageTitle>

<div class="business-layout">
    <aside class="sidebar">
        <div class="logo-section">
            <div class="logo-icon">⚡</div>
            <div>
                <h1>FerreApp</h1>
                <span>La Varilla</span>
            </div>
        </div>

        <nav class="sidebar-menu">
            <NavLink class="menu-item" href="PuntoDeVenta" Match="NavLinkMatch.All">
                🛒 Punto de Venta
            </NavLink>
            <NavLink class="menu-item" href="cotizaciones">
                📄 Cotizaciones
            </NavLink>
            <NavLink class="menu-item" href="Clientes">
                👥 Clientes
            </NavLink>
            <NavLink class="menu-item" href="Productos">
                📦 Productos
            </NavLink>
            <NavLink class="menu-item" href="Inventario">
                📊 Inventario
            </NavLink>
            <NavLink class="menu-item" href="Reportes">
                📈 Reportes
            </NavLink>
            <NavLink class="menu-item" href="facturas">
                🧾 Facturas
            </NavLink>
        </nav>

        <div class="resume-card">
            <h3>Resumen del día</h3>
            <div class="resume-item">
                <span>Ventas Totales</span>
                <strong>RD$ @ventasDelDia.ToString("N2")</strong>
            </div>
            <div class="resume-item">
                <span>Transacciones</span>
                <strong>@transaccionesDelDia</strong>
            </div>
            <div class="resume-item">
                <span>Productos vendidos</span>
                <strong>@itemsFactura.Sum(x => x.Cantidad)</strong>
            </div>
        </div>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div>
                <h2>Vista de Negocio</h2>
                <p>Punto de Venta - FerreApp La Varilla</p>
            </div>
            <div class="topbar-right">
                <div class="info-box">
                    <small>Hora Actual</small>
                    <strong>@DateTime.Now.ToString("hh:mm tt")</strong>
                </div>
                <div class="user-box">
                    <div class="avatar">👨</div>
                    <div>
                        <strong>Cajero</strong>
                        <p>Caja Principal</p>
                    </div>
                </div>
            </div>
        </header>

        <section class="dashboard-grid">
            <div class="products-section">
                <div class="search-bar">
                    <span class="search-icon">🔍</span>
                    <input type="text"
                           placeholder="Buscar producto..."
                           @bind="textoBusqueda"
                           @bind:event="oninput"
                           @onkeyup="FiltrarProductos" />
                </div>

                <div class="categories">
                    <button class="cat-btn active">Todos</button>
                    <button class="cat-btn">Herramientas</button>
                    <button class="cat-btn">Materiales</button>
                    <button class="cat-btn">Electricidad</button>
                    <button class="cat-btn">Pinturas</button>
                </div>

                <div class="products-grid">
                    @if (productosCatalogo == null)
                    {
                        <p>Cargando productos...</p>
                    }
                    else
                    {
                        @foreach (var prod in productosCatalogo)
                        {
                            <div class="product-card">
                                <div class="product-image-container">
                                    <img src="images/@(string.IsNullOrEmpty(prod.ImagenUrl) ? "default.png" : prod.ImagenUrl)"
                                         onerror="this.src='images/default.png'" />
                                </div>
                                <div class="product-info">
                                    <h4>@prod.Nombre</h4>
                                    <p class="price">RD$ @prod.Precio.ToString("N2")</p>
                                    <span class="stock">Stock: @prod.Stock</span>
                                    <div class="quantity-add">
                                        <input type="number" min="1" class="qty-input" @bind="cantidadesTemp[prod.Id]" />
                                        <button class="add-btn" @onclick="() => AgregarAlCarrito(prod)">+</button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <div class="pagination-container">
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        int numeroPagina = i;
                        <button class="page-btn @(paginaActual == numeroPagina ? "active-page" : "")"
                                @onclick="() => CambiarPagina(numeroPagina)">
                            @numeroPagina
                        </button>
                    }
                </div>
            </div>

            <div class="cart-section">
                <div class="cart-card">
                    <div class="cart-header">
                        <h3>🛒 Factura Actual</h3>
                        <span class="cart-count">@itemsFactura.Sum(x => x.Cantidad)</span>
                    </div>

                    <div class="cart-items">
                        @if (!itemsFactura.Any())
                        {
                            <p class="empty-cart">No hay productos agregados.</p>
                        }
                        @foreach (var item in itemsFactura)
                        {
                            <div class="cart-item">
                                <div>
                                    <h4>@item.Producto.Nombre</h4>
                                    <p>RD$ @item.Producto.Precio.ToString("N2")</p>
                                </div>
                                <div class="qty-box">
                                    <button @onclick="() => RestarCantidad(item)">-</button>
                                    <span>@item.Cantidad</span>
                                    <button @onclick="() => SumarCantidad(item)">+</button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="totals">
                        <div>
                            <span>Subtotal</span>
                            <strong>RD$ @SubtotalVenta.ToString("N2")</strong>
                        </div>
                        <div>
                            <span>ITBIS</span>
                            <strong>RD$ @ItbisVenta.ToString("N2")</strong>
                        </div>
                        <div class="grand-total">
                            <span>Total</span>
                            <h2>RD$ @GranTotal.ToString("N2")</h2>
                        </div>
                    </div>

                    <div class="cart-buttons">
                        <button class="clear-btn" @onclick="VaciarCarrito">🗑 Vaciar</button>
                        
                        <button class="quote-btn" 
                                disabled="@(!itemsFactura.Any())" 
                                @onclick="GenerarCotizacionRapida">
                            📄 Cotización
                        </button>
                        
                        <button class="pay-btn" disabled="@(!itemsFactura.Any())" @onclick="AbrirModalVenta">
                            🧾 Facturar
                        </button>
                    </div>
                </div>

                <div class="sales-history">
                    <div class="sales-header">
                        <h3>Últimas Ventas</h3>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>Factura</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var venta in ultimasVentas)
                            {
                                <tr>
                                    <td>FAC-@venta.Id.ToString("D4")</td>
                                    <td>RD$ @(venta.Articulos?.Sum(a => a.PrecioUnitario * a.Cantidad).ToString("N2") ?? "0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </main>
</div>

@if (mostrarModalVenta)
{
    <div class="modal-overlay">
        <div class="sale-modal">
            <div class="modal-header">
                <div>
                    <h2>🧾 Procesar Venta</h2>
                    <p>Complete los datos de la factura</p>
                </div>
                <button class="close-modal-btn" @onclick="CerrarModalVenta">✖</button>
            </div>
            <div class="modal-body">
                <div class="section-box">
                    <h3>👤 Cliente</h3>
                    <input type="text" placeholder="Nombre" @bind="clienteNombre" />
                    <input type="text" placeholder="Teléfono" @bind="clienteTelefono" />
                    <textarea placeholder="Dirección" @bind="clienteDireccion"></textarea>
                </div>
                <div class="section-box">
                    <h3>🚚 Tipo Entrega</h3>
                    <div class="delivery-options">
                        <button class="delivery-option @(tipoEntrega == "Retiro" ? "active-delivery" : "")" @onclick='() => tipoEntrega = "Retiro"'>🏪 Retiro</button>
                        <button class="delivery-option @(tipoEntrega == "Delivery" ? "active-delivery" : "")" @onclick='() => tipoEntrega = "Delivery"'>🚚 Delivery</button>
                    </div>
                    @if (tipoEntrega == "Delivery")
                    {
                        <select @bind="camionSeleccionadoId">
                            <option value="0">Seleccione Camión</option>
                            @foreach (var camion in camionesDisponibles)
                            {
                                <option value="@camion.Id">🚚 @camion.Placa</option>
                            }
                        </select>
                    }
                </div>
                <div class="section-box">
                    <h3>💳 Método Pago</h3>
                    <div class="payment-grid">
                        <button class="pay-method @(metodoPago == "Efectivo" ? "active-pay" : "")" @onclick='() => metodoPago = "Efectivo"'>💵 Efectivo</button>
                        <button class="pay-method @(metodoPago == "Transferencia" ? "active-pay" : "")" @onclick='() => metodoPago = "Transferencia"'>🏦 Transferencia</button>
                        <button class="pay-method @(metodoPago == "Tarjeta" ? "active-pay" : "")" @onclick='() => metodoPago = "Tarjeta"'>💳 Tarjeta</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="cancel-sale-btn" @onclick="CerrarModalVenta">Cancelar</button>
                <button class="confirm-sale-btn" @onclick="ConfirmarVenta">✅ Confirmar Venta</button>
            </div>
        </div>
    </div>
}

@code {
    public class ItemFactura
    {
        public required Producto Producto { get; set; }
        public int Cantidad { get; set; } = 1;
        public decimal Subtotal => Producto.Precio * Cantidad;
    }

    private List<Producto>? todosLosProductos;
    private List<Producto>? productosCatalogo;
    private List<ItemFactura> itemsFactura = new();
    private List<Pedido> ultimasVentas = new();
    private Dictionary<int, int> cantidadesTemp = new();
    private string textoBusqueda = "";
    private decimal ventasDelDia = 0;
    private int transaccionesDelDia = 0;
    private bool mostrarModalVenta = false;
    private string clienteNombre = "";
    private string clienteTelefono = "";
    private string clienteDireccion = "";
    private string tipoEntrega = "Retiro";
    private string metodoPago = "Efectivo";
    private int camionSeleccionadoId = 0;
    private List<Camion> camionesDisponibles = new();
    
    private int paginaActual = 1;
    private int productosPorPagina = 8; // Reducido para que quepa mejor en pantalla
    private int totalPaginas = 1;

    private decimal SubtotalVenta => itemsFactura.Sum(i => i.Subtotal);
    private decimal ItbisVenta => SubtotalVenta * 0.18m;
    private decimal GranTotal => SubtotalVenta + ItbisVenta;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
{
    try
    {
        todosLosProductos = await _context.Productos.Where(x => x.Activo).ToListAsync();

        // 1. LLENAR EL DICCIONARIO PRIMERO (Antes de cualquier renderizado)
        foreach (var p in todosLosProductos)
        {
            // Usamos una validación por si acaso se recargan los datos
            if (!cantidadesTemp.ContainsKey(p.Id))
            {
                cantidadesTemp[p.Id] = 1;
            }
        }

        // 2. LUEGO PREPARAMOS LA PAGINACIÓN Y DIBUJAMOS LA PANTALLA
        if (todosLosProductos.Count == 0)
        {
            totalPaginas = 1;
            productosCatalogo = new List<Producto>();
        }
        else
        {
            totalPaginas = (int)Math.Ceiling(todosLosProductos.Count / (double)productosPorPagina);
            CambiarPagina(1); // Aquí Blazor dibuja la pantalla, y el diccionario ya tiene los datos
        }

        ultimasVentas = await _context.Pedidos
            .Include(p => p.Articulos)
            .ThenInclude(a => a.Producto)
            .Where(p => p.TipoDocumento == "Factura") 
            .OrderByDescending(p => p.Id)
            .Take(5)
            .ToListAsync();

        transaccionesDelDia = ultimasVentas.Count;
        ventasDelDia = ultimasVentas.Sum(v => v.Articulos?.Sum(a => a.PrecioUnitario * a.Cantidad) ?? 0);
    }
    catch (Exception ex)
    {
        Console.WriteLine($"🔥 ERROR AL CARGAR DATOS: {ex.Message}");
        productosCatalogo = new List<Producto>();
    }
}

    private void CambiarPagina(int pagina)
    {
        if (todosLosProductos == null) return;
        
        paginaActual = pagina;
        productosCatalogo = todosLosProductos
            .Skip((paginaActual - 1) * productosPorPagina)
            .Take(productosPorPagina)
            .ToList();
            
        StateHasChanged(); // FUERZA LA ACTUALIZACIÓN VISUAL
    }

    private void FiltrarProductos()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
        {
            totalPaginas = (int)Math.Ceiling(todosLosProductos!.Count / (double)productosPorPagina);
            CambiarPagina(1);
        }
        else
        {
            var filtrados = todosLosProductos?
                .Where(p => p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
                .ToList() ?? new List<Producto>();
                
            totalPaginas = (int)Math.Ceiling(filtrados.Count / (double)productosPorPagina);
            if (totalPaginas == 0) totalPaginas = 1;
            
            paginaActual = 1;
            productosCatalogo = filtrados.Take(productosPorPagina).ToList();
        }
    }

    private void AgregarAlCarrito(Producto p)
    {
        int cantidad = cantidadesTemp.ContainsKey(p.Id) ? cantidadesTemp[p.Id] : 1;
        var existe = itemsFactura.FirstOrDefault(x => x.Producto.Id == p.Id);

        if (existe != null)
        {
            existe.Cantidad += cantidad;
        }
        else
        {
            itemsFactura.Add(new ItemFactura { Producto = p, Cantidad = cantidad });
        }

        cantidadesTemp[p.Id] = 1;
    }

    private void SumarCantidad(ItemFactura item) => item.Cantidad++;
    
    private void RestarCantidad(ItemFactura item)
    {
        if (item.Cantidad > 1) item.Cantidad--;
        else itemsFactura.Remove(item);
    }

    private void VaciarCarrito() => itemsFactura.Clear();

    private async Task AbrirModalVenta()
    {
        // camionesDisponibles = await _context.Camiones.Where(c => c.Disponible).ToListAsync(); // Descomentar cuando exista la tabla
        mostrarModalVenta = true;
        await JS.InvokeVoidAsync("document.body.classList.add", "modal-open");
    }

    private async Task CerrarModalVenta()
    {
        mostrarModalVenta = false;
        await JS.InvokeVoidAsync("document.body.classList.remove", "modal-open");
    }

    // NUEVO MÉTODO: Generar Cotización directamente desde el POS
    private async Task GenerarCotizacionRapida()
    {
        try
        {
            var clienteGeneral = await _context.Clientes.FirstOrDefaultAsync(c => c.NombreCompleto == "Cliente General");
            if(clienteGeneral == null)
{
    clienteGeneral = new Cliente 
    { 
        NombreCompleto = "Cliente General", 
        Telefono = "N/A", 
        CedulaRNC = "N/A",
        DireccionEntrega = "N/A" // <--- ¡Esta es la línea que faltaba!
    };
    _context.Clientes.Add(clienteGeneral);
    await _context.SaveChangesAsync();
}

            var nuevaCotizacion = new Pedido
            {
                FechaCreacion = DateTime.Now,
                ClienteId = clienteGeneral.Id,
                Estado = EstadoPedido.Pendiente,
                TipoDocumento = "Cotizacion",
                RequiereDelivery = false,
                Articulos = itemsFactura.Select(i => new DetallePedido
                {
                    ProductoId = i.Producto.Id,
                    Cantidad = i.Cantidad,
                    PrecioUnitario = i.Producto.Precio
                }).ToList()
            };

            _context.Pedidos.Add(nuevaCotizacion);
            await _context.SaveChangesAsync();

            VaciarCarrito();
            
            // Opcional: Redirigir a la vista de cotizaciones o mostrar un mensaje
            Navigation.NavigateTo("/cotizaciones");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task ConfirmarVenta()
    {
        try
        {
            var nuevoCliente = new Cliente
            {
                NombreCompleto = string.IsNullOrWhiteSpace(clienteNombre) ? "Cliente General" : clienteNombre,
                Telefono = string.IsNullOrWhiteSpace(clienteTelefono) ? "N/A" : clienteTelefono,
                CedulaRNC = "00000000000",
                DireccionEntrega = string.IsNullOrWhiteSpace(clienteDireccion) ? "Retiro en tienda" : clienteDireccion
            };

            _context.Clientes.Add(nuevoCliente);
            await _context.SaveChangesAsync();

            var nuevaVenta = new Pedido
            {
                FechaCreacion = DateTime.Now,
                ClienteId = nuevoCliente.Id,
                Estado = tipoEntrega == "Delivery" ? EstadoPedido.Pendiente : EstadoPedido.Completado,
                TipoDocumento = "Factura", // Esencial definirlo
                RequiereDelivery = tipoEntrega == "Delivery",
                // CamionAsignadoId = tipoEntrega == "Delivery" ? camionSeleccionadoId : null, // Descomentar cuando exista
                Articulos = itemsFactura.Select(i => new DetallePedido
                {
                    ProductoId = i.Producto.Id,
                    Cantidad = i.Cantidad,
                    PrecioUnitario = i.Producto.Precio
                }).ToList()
            };

            // Restar inventario
            foreach (var item in itemsFactura)
            {
                var prodDb = await _context.Productos.FindAsync(item.Producto.Id);
                if (prodDb != null) prodDb.Stock -= item.Cantidad;
            }

            _context.Pedidos.Add(nuevaVenta);
            await _context.SaveChangesAsync();

            VaciarCarrito();
            await CerrarModalVenta();
            await CargarDatos();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}

