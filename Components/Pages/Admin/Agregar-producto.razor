@page "/admin/agregar-producto"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using FerreAppLaVarilla.UI.Models
@attribute [Authorize(Roles = "Admin")]
@inject FerreAppLaVarilla.UI.Services.ProductoService ProductoService
@inject NavigationManager Navigation
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService

<PageTitle>Agregar Producto - FerreAppLaVarilla</PageTitle>

<div class="admin-layout">

    <aside class="sidebar">
        <div class="logo">
            <span class="logo-icon">⚡</span>
            <div>
                <h2>FerreApp<span>LaVarilla</span></h2>
                <p>Panel de Administración</p>
            </div>
        </div>

        <nav class="menu">
            <a href="/panel-admin" class="menu-item">📊 Dashboard</a>
            <a href="/admin/agregar-producto" class="menu-item active" style="color: #f4b400; font-weight: bold; border: 1px dashed #f4b400;">➕ Nuevo Producto</a>
            <a href="/productos" class="menu-item">📦 Ver Catálogo</a>
            <a href="#" class="menu-item">📁 Categorías</a>
            <a href="#" class="menu-item">🛒 Pedidos</a>
            <a href="#" class="menu-item">👥 Clientes</a>
            <a href="#" class="menu-item">👤 Usuarios</a>
        </nav>

        <button class="logout-btn" @onclick="CerrarSesion">Cerrar sesión</button>
    </aside>

    <main class="main-content">
        <EditForm Model="producto" OnSubmit="GuardarProducto">
            
            <header class="topbar">
                <div class="left-topbar">
                    <div class="menu-toggle">☰</div>
                    <input type="text" class="search-box" placeholder="Buscar en el sistema..." />
                </div>
                <div class="right-topbar">
                    <span class="notification">🔔</span>
                    <div class="admin-user">
                        <div class="avatar">👤</div>
                        <div>
                            <strong>Administrador</strong>
                            <p>admin@ferreapp.com</p>
                        </div>
                    </div>
                </div>
            </header>

            <section class="page-header">
                <div>
                    <h1>Agregar nuevo producto</h1>
                    <p>Inicio > Productos > Agregar nuevo</p>
                </div>
                <div class="header-buttons">
                    <button type="button" class="cancel-btn" @onclick="Cancelar">Cancelar</button>
                    <button type="submit" class="save-btn">Guardar producto</button>
                </div>
            </section>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div style="background: #ffebee; color: #d32f2f; padding: 15px; border-radius: 8px; margin-bottom: 20px; border-left: 5px solid #d32f2f; font-weight: bold;">
                    ⚠️ @mensajeError
                </div>
            }

            <section class="form-grid">

                <div class="left-column">
                    <div class="card">
                        <h2>Información básica</h2>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Nombre del producto *</label>
                                <input type="text" @bind="producto.Nombre" required placeholder="Ej. Taladro Percutor" />
                            </div>
                            <div class="form-group">
                                <label>SKU / Código *</label>
                                <input type="text" @bind="producto.Sku" required placeholder="Ej. TAL-001" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Categoría *</label>
                                <select @bind="producto.Categoria">
                                    <option value="">Selecciona una categoría</option>
                                    <option value="Herramientas">Herramientas</option>
                                    <option value="Materiales">Materiales</option>
                                    <option value="Pinturas">Pinturas</option>
                                    <option value="Plomeria">Plomería</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Marca *</label>
                                <select @bind="producto.Marca">
                                    <option value="">Selecciona una marca</option>
                                    <option value="Truper">Truper</option>
                                    <option value="Dewalt">Dewalt</option>
                                    <option value="Lanco">Lanco</option>
                                    <option value="Genérica">Genérica</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Descripción *</label>
                            <textarea @bind="producto.Descripcion" required placeholder="Describe las características..."></textarea>
                        </div>
                    </div>

                    <div class="card">
                        <h2>Precios e inventario</h2>
                        <div class="form-row three">
                            <div class="form-group">
                                <label>Precio de compra *</label>
                                <input type="number" step="0.01" @bind="producto.PrecioCompra" @bind:event="oninput" required />
                            </div>
                            <div class="form-group">
                                <label>Precio de venta *</label>
                                <input type="number" step="0.01" @bind="producto.Precio" @bind:event="oninput" required />
                            </div>
                            <div class="form-group">
                                <label>Stock actual *</label>
                                <input type="number" @bind="producto.Stock" required />
                            </div>
                        </div>

                        <div class="form-row three">
                            <div class="form-group">
                                <label>Stock mínimo</label>
                                <input type="number" @bind="producto.StockMinimo" />
                            </div>
                            <div class="form-group">
                                <label>Unidad de medida</label>
                                <select @bind="producto.UnidadMedida">
                                    <option value="Unidad">Unidad</option>
                                    <option value="Libra">Libra</option>
                                    <option value="Galon">Galón</option>
                                    <option value="Metro">Metro</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Estado</label>
                                <div class="switch-box">
                                    <input type="checkbox" @bind="producto.Activo" />
                                    <span>@(producto.Activo ? "Sí, activo" : "No, inactivo")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="right-column">
                    <div class="card">
                        <h2>Imagen del producto</h2>
                        
                        <div class="upload-box" style="position: relative; margin-top:15px; overflow: hidden; cursor: pointer; border: 2px dashed #2f80ed; background: #f0f4ff;">
                            <InputFile OnChange="CargarImagen" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" accept="image/png, image/jpeg, image/webp" />
                            <div class="upload-icon" style="color: #2f80ed;">☁</div>
                            <p style="font-weight: bold; color: #0d1b2a; margin-top: 10px;">@nombreArchivoVista</p>
                            <small>Haz clic para seleccionar desde tu PC</small>
                        </div>
                        
                        <p style="text-align: center; margin-top: 10px; font-size: 12px; color: gray;">
                            Archivo a guardar: @producto.ImagenUrl
                        </p>
                    </div>

                    <div class="card">
                        <h2>Análisis de rentabilidad</h2>
                        <div class="mini-stats">
                            <div class="mini-box"><small>Inversión</small><strong>$@producto.PrecioCompra.ToString("N2")</strong></div>
                            <div class="mini-box"><small>Venta</small><strong>$@producto.Precio.ToString("N2")</strong></div>
                            <div class="mini-box"><small>Margen</small><strong>@CalcularMargen().ToString("N0")%</strong></div>
                        </div>

                        <div class="profit-circle" style="@($"background: conic-gradient(#8b5cf6 0% {CalcularMargen():N0}%, #ececec {CalcularMargen():N0}% 100%);")">
                            <div class="circle-inner">
                                <h3>@CalcularMargen().ToString("N0")%</h3>
                                <p>Ganancia</p>
                            </div>
                        </div>
                    </div>
                </div>

            </section>
        </EditForm>
    </main>
</div>

@code {
    private Producto producto = new Producto();
    private string mensajeError = "";
    private string nombreArchivoVista = "Sube una imagen aquí";

    // Cálculo dinámico para la gráfica
    private decimal CalcularMargen()
    {
        if (producto.Precio <= 0 || producto.PrecioCompra <= 0) return 0;
        return ((producto.Precio - producto.PrecioCompra) / producto.Precio) * 100;
    }

    // Lector de archivos
    private void CargarImagen(InputFileChangeEventArgs e)
    {
        if (e.File != null)
        {
            nombreArchivoVista = "✔️ " + e.File.Name;
            producto.ImagenUrl = e.File.Name;
        }
    }

    private async Task GuardarProducto()
    {
        try
        {
            mensajeError = ""; 

            // Verificación de integridad: Evitar que el objeto llegue vacío
            if (string.IsNullOrWhiteSpace(producto.Nombre) || producto.Precio <= 0)
            {
                mensajeError = "Por favor, completa los campos obligatorios (Nombre y Precio de venta).";
                return;
            }

            if (string.IsNullOrEmpty(producto.ImagenUrl)) 
                producto.ImagenUrl = "default.png";
            
            // Inserción en la base de datos
            await ProductoService.AgregarProductoAsync(producto);
            
            // Redirección al catálogo
            Navigation.NavigateTo("/productos");
        }
        catch (Exception ex)
        {
            mensajeError = "Fallo al guardar: " + ex.Message;
            if (ex.InnerException != null)
            {
                mensajeError += " - " + ex.InnerException.Message;
            }
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/panel-admin");
    private void CerrarSesion() { AuthService.CerrarSesion(); Navigation.NavigateTo("/"); }
}

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: "Segoe UI"; }
    body { background: #f7f9fc; }
    .admin-layout { display: flex; min-height: 100vh; }
    
    .sidebar { width: 280px; background: linear-gradient(to bottom, #03182d, #061f3b); color: white; padding: 30px 20px; display: flex; flex-direction: column; }
    .logo { display: flex; gap: 15px; align-items: center; margin-bottom: 40px; }
    .logo-icon { font-size: 28px; }
    .logo h2 { font-size: 26px; }
    .logo span { color: #f4b400; }
    .logo p { font-size: 14px; opacity: .8; }
    
    .menu { display: flex; flex-direction: column; gap: 10px; }
    .menu-item { text-decoration: none; color: white; padding: 14px 18px; border-radius: 12px; transition: .3s; }
    .menu-item:hover { background: rgba(255,255,255,.08); }
    .menu-item.active { background: #0b3d91; }
    .logout-btn { margin-top: auto; background: transparent; border: 1px solid rgba(255,255,255,.2); color: white; padding: 16px; border-radius: 12px; cursor: pointer; }
    
    .main-content { flex: 1; padding: 30px; }
    .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 35px; }
    .left-topbar { display: flex; align-items: center; gap: 20px; }
    .menu-toggle { font-size: 24px; cursor: pointer; }
    .search-box { width: 420px; padding: 14px 18px; border: 1px solid #ddd; border-radius: 12px; outline: none; }
    .right-topbar { display: flex; align-items: center; gap: 25px; }
    .admin-user { display: flex; align-items: center; gap: 12px; }
    .avatar { width: 45px; height: 45px; background: #eef2f7; border-radius: 50%; display: flex; justify-content: center; align-items: center; }
    
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .page-header h1 { font-size: 34px; margin-bottom: 8px; }
    .page-header p { color: #666; }
    .header-buttons { display: flex; gap: 15px; }
    .cancel-btn, .save-btn { padding: 14px 22px; border-radius: 10px; border: none; cursor: pointer; font-weight: 600; }
    .cancel-btn { background: white; border: 1px solid #ddd; }
    .save-btn { background: #2f80ed; color: white; }
    
    .form-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 25px; }
    .left-column, .right-column { display: flex; flex-direction: column; gap: 25px; }
    
    .card { background: white; border-radius: 18px; padding: 28px; box-shadow: 0 5px 20px rgba(0,0,0,.04); }
    .card h2 { margin-bottom: 25px; color: #0d1b2a; font-size: 20px; }
    
    .form-row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 20px; }
    .form-row.three { grid-template-columns: repeat(3, 1fr); }
    .form-group label { display: block; margin-bottom: 10px; font-weight: 600; font-size: 14px;}
    
    input, select, textarea { width: 100%; padding: 15px; border: 1px solid #ddd; border-radius: 10px; outline: none; transition: .3s;}
    input:focus, textarea:focus { border-color: #2f80ed; }
    textarea { min-height: 140px; resize: none; }
    .switch-box { display: flex; align-items: center; gap: 10px; margin-top: 15px; }
    
    .upload-box { border: 2px dashed #d8dce6; border-radius: 16px; padding: 50px 20px; text-align: center; }
    .upload-icon { font-size: 42px; margin-bottom: 15px; }
    
    .mini-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom: 30px; }
    .mini-box { background: #f8fafc; padding: 18px; border-radius: 12px; text-align: center; }
    .mini-box strong { display: block; margin-top: 8px; font-size: 20px; color: #0d1b2a;}
    
    .profit-circle { width: 240px; height: 240px; margin: auto; border-radius: 50%; display: flex; justify-content: center; align-items: center; transition: background 0.3s; }
    .circle-inner { width: 170px; height: 170px; background: white; border-radius: 50%; display: flex; flex-direction: column; justify-content: center; align-items: center; box-shadow: inset 0 0 10px rgba(0,0,0,.03); }
    .circle-inner h3 { font-size: 40px; color: #0d1b2a;}
</style>