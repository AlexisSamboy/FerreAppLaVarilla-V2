@page "/admin/configuracion"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using FerreAppLaVarilla.UI.Data
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Services

@attribute [Authorize(Roles = "Admin")]

@inject ApplicationDbContext _context
@inject NavigationManager Navigation
@inject AutenticacionService AuthService

<PageTitle>Configuración - FerreApp La Varilla</PageTitle>

<div class="admin-layout">

    <aside class="sidebar @(menuOculto ? "oculto" : "")">
        <div class="logo">
            <div class="logo-icon">⚡</div>
            <div>
                <h2>FerreApp<span>LaVarilla</span></h2>
            </div>
        </div>
        
        <nav class="menu">
            <NavLink class="menu-item" href="/panel-admin" Match="NavLinkMatch.All">
                <span class="menu-icon">📊</span> Dashboard
            </NavLink>
            <NavLink class="menu-item" href="/admin/pedidos">
                <span class="menu-icon">🛒</span> Pedidos
            </NavLink>
            <NavLink class="menu-item" href="/admin/gestionar-productos">
                <span class="menu-icon">📦</span> Productos
            </NavLink>
            <NavLink class="menu-item" href="/admin/clientes">
                <span class="menu-icon">👥</span> Clientes
            </NavLink>
            <NavLink class="menu-item" href="/admin/usuarios">
                <span class="menu-icon">👤</span> Usuarios
            </NavLink>
            <NavLink class="menu-item" href="/admin/despacho">
                <span class="menu-icon">🚚</span> Despacho
            </NavLink>
            <NavLink class="menu-item" href="/admin/configuracion">
                <span class="menu-icon">⚙️</span> Configuración
            </NavLink>
        </nav>

        <button class="logout-btn" @onclick="CerrarSesion">
            Cerrar Sesión
        </button>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div class="left-topbar">
                <div class="menu-toggle" @onclick="ToggleMenu">☰</div>
                <input type="text" placeholder="Buscar en el sistema..." class="search-box" />
            </div>

            <div class="right-topbar">
                <span class="notification">🔔</span>
                <div class="admin-user">
                    <div class="avatar">👤</div>
                    <div>
                        <strong>Administrador</strong>
                        <p style="margin: 0; font-size: 13px; color: #64748b;">admin@ferreapp.com</p>
                    </div>
                </div>
            </div>
        </header>

        <div class="header-titles" style="margin-bottom: 30px;">
            <h1 style="font-size: 28px; color: #0f172a; font-weight: 800; margin-bottom: 5px;">Configuración del Sistema ⚙️</h1>
            <p style="color: #64748b; font-size: 15px; margin: 0;">Ajusta los parámetros de negocio y gestiona el acceso del personal.</p>
        </div>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert-success-premium">
                <span>✅ @mensajeExito</span>
                <button class="close-alert" @onclick='() => mensajeExito = ""'>✕</button>
            </div>
        }

        <div class="settings-grid">
            
            <div class="premium-card">
                <div class="card-header" style="margin-bottom: 20px;">
                    <h3>🏢 Datos de la Ferretería</h3>
                </div>
                <div class="form-body">
                    <div class="form-group-admin">
                        <label>Nombre Comercial</label>
                        <input type="text" @bind="configNegocio.Nombre" class="admin-input" />
                    </div>
                    <div class="form-group-admin mt-3">
                        <label>RNC / Cédula</label>
                        <input type="text" @bind="configNegocio.Rnc" class="admin-input" placeholder="101-00000-1" />
                    </div>
                    <div class="form-group-admin mt-3">
                        <label>Ubicación Principal</label>
                        <textarea @bind="configNegocio.Direccion" class="admin-input" rows="2"></textarea>
                    </div>
                    <div class="row-flex mt-3">
                        <div class="form-group-admin w-50">
                            <label>ITBIS (%)</label>
                            <input type="number" @bind="configNegocio.Itbis" class="admin-input" />
                        </div>
                        <div class="form-group-admin w-50">
                            <label>Moneda Base</label>
                            <select class="admin-input" @bind="configNegocio.Moneda">
                                <option value="DOP">Pesos (RD$)</option>
                                <option value="USD">Dólares (US$)</option>
                            </select>
                        </div>
                    </div>
                    <button class="btn-save-settings mt-4" @onclick="GuardarConfig">
                        💾 Guardar Parámetros
                    </button>
                </div>
            </div>

            <div class="premium-card">
                <div class="card-header" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
                    <h3>👤 Gestión de Personal</h3>
                    <span class="badge-security">Seguridad</span>
                </div>
                <div class="form-body">
                    <EditForm Model="nuevoUsuario" OnValidSubmit="RegistrarUsuario">
                        <DataAnnotationsValidator />
                        
                        <div class="form-group-admin">
                            <label>Nombre Completo</label>
                            <input type="text" @bind="nuevoUsuario.NombreCompleto" class="admin-input" placeholder="Ej: Josué González" />
                        </div>

                        <div class="form-group-admin mt-3">
                            <label>Email de Acceso</label>
                            <input type="email" @bind="nuevoUsuario.CorreoElectronico" class="admin-input" placeholder="empleado@ferreapp.com" />
                        </div>

                        <div class="row-flex mt-3">
                            <div class="form-group-admin w-50">
                                <label>Rol de Usuario</label>
                                <select class="admin-input" @bind="nuevoUsuario.Rol">
                                    <option value="Admin">Administrador</option>
                                    <option value="Cajero">Cajero / Ventas</option>
                                    <option value="Logistica">Despacho</option>
                                </select>
                            </div>
                            <div class="form-group-admin w-50">
                                <label>Password Temporal</label>
                                <input type="password" @bind="nuevoUsuario.Password" class="admin-input" />
                            </div>
                        </div>

                        <button type="submit" class="btn-add-user mt-4">
                            <span>➕ Registrar en SQL Server</span>
                        </button>
                    </EditForm>

                    <div class="server-info-box mt-4">
                        <div class="info-row">
                            <small style="color: #64748b;">Estado SQL:</small>
                            <span class="dot-online"></span>
                            <strong>Conectado</strong>
                        </div>
                        <div class="info-row" style="margin-top: 5px;">
                            <small style="color: #64748b;">Instancia:</small>
                            <strong>FerreApp_Primary</strong>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-3" style="border-top: 1px dashed #cbd5e1;">
                    <p style="font-size: 13px; color: #64748b; margin-bottom: 12px;">
                        ¿Necesitas editar o eliminar usuarios existentes?
                    </p>
                    <button class="btn-primary-outline w-100" style="padding: 12px; border: 1px solid #0b1527; background: transparent; color: #0b1527; border-radius: 12px; font-weight: 600; cursor: pointer;" @onclick='() => Navigation.NavigateTo("/admin/usuarios")'>
                        👤 Ver listado completo de usuarios
                    </button>
                </div>
            </div>

        </div>
    </main>
</div>

@code {
    private bool menuOculto = true;
    private void ToggleMenu() => menuOculto = !menuOculto;

    private Usuario nuevoUsuario = new Usuario { Rol = "Cajero" };
    private ConfigData configNegocio = new();
    private string mensajeExito = "";

    protected override void OnInitialized()
    {
        configNegocio.Nombre = "FerreApp La Varilla";
        configNegocio.Direccion = "Baní, Peravia, República Dominicana";
        configNegocio.Itbis = 18;
        configNegocio.Moneda = "DOP";
    }

    private async Task RegistrarUsuario()
    {
        try
        {
            _context.Usuarios.Add(nuevoUsuario);
            await _context.SaveChangesAsync();
            mensajeExito = $"Usuario '{nuevoUsuario.NombreCompleto}' registrado exitosamente.";
            nuevoUsuario = new Usuario { Rol = "Cajero" };
        }
        catch (Exception ex)
        {
            mensajeExito = "Error al conectar con SQL: " + ex.Message;
        }
    }

    private void GuardarConfig() => mensajeExito = "Parámetros globales actualizados correctamente.";
    private void CerrarSesion() { AuthService.CerrarSesion(); Navigation.NavigateTo("/"); }

    public class ConfigData {
        public string Nombre { get; set; } = "";
        public string Rnc { get; set; } = "";
        public string Direccion { get; set; } = "";
        public int Itbis { get; set; }
        public string Moneda { get; set; } = "DOP";
    }
}

<style>
    /* =========================================
       ESTILOS DEL TOPBAR Y CONTENEDOR PRINCIPAL
       ========================================= */
    .main-content { flex: 1; padding: 25px 35px; background: #fafbfd; overflow-y: auto; transition: width 0.4s; }
    
    .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .left-topbar { display: flex; align-items: center; gap: 20px; }
    .menu-toggle { font-size: 24px; cursor: pointer; color: #0d1b2a; padding: 5px; border-radius: 8px; transition: 0.2s; }
    .menu-toggle:hover { background: #e2e8f0; }
    .search-box { width: 350px; padding: 10px 16px; border: 1px solid #e2e8f0; border-radius: 10px; outline: none; background: white; font-size: 13px; }
    
    .right-topbar { display: flex; align-items: center; gap: 20px; }
    .notification { font-size: 20px; cursor: pointer; }
    .admin-user { display: flex; align-items: center; gap: 12px; }
    .admin-user strong { color: #0d1b2a; display: block; font-size: 14px; }
    .avatar { width: 40px; height: 40px; background: #e2e8f0; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 16px; }

    /* =========================================
       ESTILOS ESPECÍFICOS DE CONFIGURACIÓN
       ========================================= */
    .settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(450px, 1fr)); gap: 30px; }
    .premium-card { background: white; border-radius: 20px; padding: 30px; box-shadow: 0 4px 15px rgba(0,0,0,0.02); border: 1px solid #f1f5f9; }
    .premium-card h3 { font-size: 18px; font-weight: 700; color: #0b1527; margin: 0; }

    /* FORMULARIOS */
    .form-group-admin label { display: block; font-size: 13px; font-weight: 700; color: #475569; margin-bottom: 8px; }
    .admin-input { width: 100%; padding: 12px 16px; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 14px; outline: none; transition: 0.3s; background: #f8fafc; }
    .admin-input:focus { border-color: #f59e0b; background: white; box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.05); }

    .row-flex { display: flex; gap: 15px; }
    .w-50 { width: 50%; }
    .w-100 { width: 100%; }
    .mt-3 { margin-top: 15px; }
    .mt-4 { margin-top: 25px; }
    .pt-3 { padding-top: 15px; }

    /* BOTONES INTERNOS */
    .btn-save-settings { width: 100%; background: #0b1527; color: white; padding: 14px; border-radius: 12px; border: none; font-weight: 700; cursor: pointer; transition: 0.3s; }
    .btn-save-settings:hover { background: #f59e0b; color: #0b1527; }

    .btn-add-user { width: 100%; background: white; color: #0b1527; border: 2px solid #0b1527; padding: 14px; border-radius: 12px; font-weight: 800; cursor: pointer; transition: 0.3s; }
    .btn-add-user:hover { background: #0b1527; color: white; }

    /* ALERTAS E INFO */
    .alert-success-premium { background: #f0fdf4; border-left: 5px solid #16a34a; padding: 15px 20px; border-radius: 12px; color: #166534; font-weight: 600; display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .close-alert { background: none; border: none; cursor: pointer; color: #166534; font-size: 18px; }

    .server-info-box { background: #f8fafc; padding: 15px; border-radius: 14px; border: 1px solid #e2e8f0; }
    .info-row { display: flex; align-items: center; font-size: 13px; gap: 8px;}
    .dot-online { width: 10px; height: 10px; background: #10b981; border-radius: 50%; display: inline-block; }
    .badge-security { background: #fee2e2; color: #991b1b; padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 800; }
</style>