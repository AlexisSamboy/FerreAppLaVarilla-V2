@page "/confirmacion-exito"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService

<PageTitle>Pedido Confirmado - FerreApp La Varilla</PageTitle>

<div class="premium-success-page">

    <header class="top-navbar">
        <div class="nav-brand" @onclick='() => Navigation.NavigateTo("/")' style="cursor: pointer;">
            <div class="brand-icon">⚡</div>
            <div class="brand-text">
                <h1>FerreApp<span>LaVarilla</span></h1>
                <p>Ferretería Inteligente</p>
            </div>
        </div>

          <nav class="sidebar-menu">
            <a href="/panel-admin" class="menu-link @GetActive("/panel-admin")"><span class="menu-icon">🏠</span> Inicio</a>
            <a href="/admin/pedidos" class="menu-link @GetActive("/admin/pedidos")"><span class="menu-icon">🛒</span> Pedidos</a>
            <a href="/admin/gestionar-productos" class="menu-link @GetActive("/admin/gestionar-productos")"><span class="menu-icon">📦</span> Productos</a>
            <a href="/admin/clientes" class="menu-link @GetActive("/admin/clientes")"><span class="menu-icon">👤</span> Clientes</a>
            <a href="/admin/usuarios" class="menu-link @GetActive("/admin/usuarios")"><span class="menu-icon">👥</span> Usuarios</a>
            <a href="/admin/despacho" class="menu-link @GetActive("/admin/despacho")"><span class="menu-icon">🚚</span> Despacho</a>
            <a href="/admin/reportes" class="menu-link @GetActive("/admin/reportes")"><span class="menu-icon">📊</span> Reportes</a>
            <a href="/admin/configuracion" class="menu-link @GetActive("/admin/configuracion")"><span class="menu-icon">⚙️</span> Configuración</a>
        </nav>

        <div class="nav-auth">
            <AuthorizeView>
                <Authorized>
                    <div class="user-pill">
                        <div class="avatar">👤</div>
                        <div class="user-info">
                            <strong>@context.User.Identity?.Name</strong>
                            <small>Sesión activa</small>
                        </div>
                    </div>
                    <button class="btn-logout" @onclick="CerrarSesion">Salir</button>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="success-main">
        <div class="success-card bounce-in">
            <div class="success-icon-container">
                <div class="success-ring"></div>
                <span class="check-mark">✅</span>
            </div>

            <h1>¡Pedido Recibido!</h1>
            <p class="subtitle">Gracias por confiar en <strong>FerreApp La Varilla</strong>. Tu solicitud ya está siendo procesada por nuestro equipo en Baní.</p>

            <div class="order-info-box">
                <div class="info-row">
                    <span>Número de Pedido:</span>
                    <strong class="highlight">#@numeroPedido</strong>
                </div>
                <div class="info-row">
                    <span>Tiempo estimado:</span>
                    <strong>30 - 60 minutos</strong>
                </div>
                <div class="info-row">
                    <span>Estado inicial:</span>
                    <span class="status-badge">Pendiente</span>
                </div>
            </div>

            <div class="next-steps">
                <h3>¿Qué sigue ahora?</h3>
                <ul>
                    <li>🏢 Prepararemos tus artículos en nuestro almacén.</li>
                    <li>📞 Te llamaremos si hay alguna duda con tu dirección.</li>
                    <li>🚚 El repartidor se pondrá en camino lo antes posible.</li>
                </ul>
            </div>

            <div class="action-buttons">
                <button class="btn-primary-yellow" @onclick='() => Navigation.NavigateTo("/")'>🏠 Volver al Inicio</button>
                <button class="btn-outline-dark" @onclick='() => Navigation.NavigateTo("/productos")'>📦 Seguir Comprando</button>
            </div>
        </div>
    </main>
</div>

@code {
    private string numeroPedido = "";

    protected override void OnInitialized()
    {
        // Generamos un número aleatorio para que se vea real
        // En un futuro, podrías pasar el ID real del pedido por la URL
        Random rnd = new Random();
        numeroPedido = "FAC-" + rnd.Next(1000, 9999).ToString();
    }

    private void CerrarSesion()
    {
        AuthService.CerrarSesion();
        Navigation.NavigateTo("/", true);
    }
    private string GetActive(string path) 
    {
        return Navigation.Uri.Contains(path) ? "active" : "";
    }
}

<style>
    @((MarkupString)FerreAppLaVarilla.UI.Services.AdminTheme.EstilosGlobales)
</style>