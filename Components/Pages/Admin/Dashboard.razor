@page "/panel-admin"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Services
@attribute [Authorize(Roles = "Admin")]

@inject DashboardService _dashboardService
@inject NavigationManager _navigation
@inject AutenticacionService _authService

<PageTitle>Admin Dashboard - FerreApp La Varilla</PageTitle>

<div class="admin-container">
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <div class="logo-icon">⚡</div>
            <div class="logo-text">
                <h2>FerreApp</h2>
                <span>La Varilla</span>
            </div>
        </div>

        <nav class="sidebar-nav">
            <a href="/panel-admin" class="nav-link active"><span>🏠</span> Inicio</a>
            <a href="/admin/pedidos" class="nav-link"><span>🛒</span> Pedidos</a>
            <a href="/admin/gestionar-productos" class="nav-link"><span>📦</span> Productos</a>
            <a href="/admin/clientes" class="nav-link"><span>👤</span> Clientes</a>
            <a href="/admin/reportes" class="nav-link"><span>📊</span> Reportes</a>
            <a href="/admin/configuracion" class="nav-link"><span>⚙️</span> Configuración</a>
        </nav>

        <div class="sidebar-footer">
            <div class="admin-pill">
                <div class="avatar">AD</div>
                <div class="admin-info">
                    <strong>Administrador</strong>
                    <small>admin@ferreapp.com</small>
                </div>
            </div>
            <button class="btn-logout-minimal" @onclick="CerrarSesion">Cerrar Sesión</button>
        </div>
    </aside>

    <main class="admin-main">
        <header class="admin-topbar">
            <div class="welcome-text">
                <h1>¡Bienvenido, Administrador! 👋</h1>
                <p>Resumen general - @DateTime.Now.ToString("dd MMMM, yyyy")</p>
            </div>
            <div class="topbar-actions">
                <div class="notification-badge">🔔<span>3</span></div>
                <div class="date-display">📅 @DateTime.Now.ToString("dddd")</div>
            </div>
        </header>

        @if (stats == null)
        {
            <div class="loader-container">
                <div class="custom-spinner"></div>
                <p>Cargando datos del sistema...</p>
            </div>
        }
        else
        {
            <section class="stats-cards-grid">
                <div class="card-stat">
                    <div class="card-body">
                        <small>Ventas Hoy</small>
                        <h2>RD$ @stats.VentasHoy.ToString("N2")</h2>
                        <span class="trend positive">↗ 12.5%</span>
                    </div>
                    <div class="card-icon blue">🛒</div>
                </div>

                <div class="card-stat">
                    <div class="card-body">
                        <small>Pedidos Pendientes</small>
                        <h2>@stats.PedidosPendientes</h2>
                        <span class="trend positive">↗ Activos</span>
                    </div>
                    <div class="card-icon green">📋</div>
                </div>

                <div class="card-stat">
                    <div class="card-body">
                        <small>Productos en Stock</small>
                        <h2>@stats.StockTotal</h2>
                        <span class="trend">Total Unidades</span>
                    </div>
                    <div class="card-icon orange">📦</div>
                </div>

                <div class="card-stat">
                    <div class="card-body">
                        <small>Inversión Total</small>
                        <h2>RD$ @stats.InversionTotal.ToString("N2")</h2>
                    </div>
                    <div class="card-icon purple">💰</div>
                </div>
            </section>

            <div class="dashboard-lower-grid">
                <div class="data-card table-card">
                    <div class="card-header-flex">
                        <h3>Últimos pedidos</h3>
                        <button class="btn-text" @onclick='() => _navigation.NavigateTo("/admin/pedidos")'>Ver todos</button>
                    </div>
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Pedido</th>
                                <th>Cliente</th>
                                <th>Estado</th>
                                <th style="text-align:right;">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in stats.UltimosPedidos)
                            {
                                <tr>
                                    <td><strong>@p.Id</strong></td>
                                    <td>@p.Cliente</td>
                                    <td><span class="badge @p.Estado.ToLower().Replace(" ", "-")">@p.Estado</span></td>
                                    <td style="text-align:right; font-weight:700;">RD$ @p.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="data-card actions-card">
                    <h3>Acciones Rápidas</h3>
                    <div class="actions-buttons-vertical">
                        <button class="btn-action primary" @onclick='() => _navigation.NavigateTo("/admin/gestionar-productos")'>
                            📥 Actualizar Inventario
                        </button>
                        <button class="btn-action secondary" @onclick='() => _navigation.NavigateTo("/admin/agregar-producto")'>
                            ➕ Agregar Nuevo Producto
                        </button>
                        <button class="btn-action outline" @onclick='() => _navigation.NavigateTo("/productos")'>
                            🌐 Ver Tienda Pública
                        </button>
                    </div>
                </div>
            </div>
        }
    </main>
</div>

@code {
    // CORRECCIÓN: Dejamos una sola declaración limpia
    private DashboardStats? stats;

    protected override async Task OnInitializedAsync()
    {
        stats = await _dashboardService.ObtenerEstadisticasAsync();
    }

    private void CerrarSesion()
    {
        _authService.CerrarSesion();
        _navigation.NavigateTo("/", true);
    }
}
<style>
    @((MarkupString)FerreAppLaVarilla.UI.Services.AdminTheme.EstilosGlobales)
</style>