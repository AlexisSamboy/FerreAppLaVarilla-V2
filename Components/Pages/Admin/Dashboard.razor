@page "/panel-admin"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService

<PageTitle>Panel de Administración - FerreApp La Varilla</PageTitle>

<div class="admin-layout">

    <aside class="sidebar">

        <div class="logo">
            <span class="logo-icon">⚡</span>
            <div>
                <h2>FerreApp<span>LaVarilla</span></h2>
                <p>Panel de Administración</p>
            </div>
        </div>

        <nav class="menu">
            <a href="/panel-admin" class="menu-item active">📊 Dashboard</a>
            
            <a href="/admin/agregar-producto" class="menu-item" style="color: #f4b400; font-weight: bold; border: 1px dashed #f4b400;">➕ Nuevo Producto</a>
            <a href="/productos" class="menu-item">📦 Ver Catálogo</a>
            
            <a href="#" class="menu-item">📁 Categorías</a>
            <a href="#" class="menu-item">🛒 Pedidos</a>
            <a href="#" class="menu-item">👥 Clientes</a>
            <a href="/admin/usuarios" class="menu-item">👤 Usuarios</a>
            <a href="#" class="menu-item">🏷️ Ofertas</a>
            <a href="#" class="menu-item">📈 Reportes</a>
            <a href="#" class="menu-item">⚙️ Configuración</a>
            <a href="#" class="menu-item">🛡️ Límites y Permisos</a>
        </nav>

        <button class="logout-btn" @onclick="CerrarSesion">
            Cerrar sesión
        </button>

    </aside>

    <main class="main-content">

        <header class="topbar">
            <div class="left-topbar">
                <div class="menu-toggle">☰</div>
                <input type="text" placeholder="Buscar en el sistema..." class="search-box" />
            </div>

            <div class="right-topbar">
                <span class="notification">🔔</span>
                <div class="admin-user">
                    <div class="avatar">👤</div>
                    <div>
                        <strong>Administrador</strong>
                        <p>admin@ferreapp.com</p>
                    </div>
                </div>
            </div>
        </header>

        <section class="welcome">
            <h1>¡Bienvenido, Administrador!</h1>
            <p>Aquí tienes un resumen general de tu tienda.</p>
        </section>

        <section class="stats-grid">
            <div class="stat-card">
                <h3>Pedidos Totales</h3>
                <h2>1,245</h2>
                <span>↑ 12.5% vs mes anterior</span>
            </div>
            <div class="stat-card" style="position: relative;">
                <h3>Productos</h3>
                <h2>328</h2>
                <span>↑ 8.3% vs mes anterior</span>
                
                <button @onclick="IrAAgregarProducto" style="position: absolute; top: 25px; right: 25px; background: #0d1b2a; color: white; border: none; padding: 8px 12px; border-radius: 8px; cursor: pointer; font-weight: bold; transition: 0.3s;">
                    + Agregar
                </button>
            </div>
            <div class="stat-card">
                <h3>Clientes</h3>
                <h2>856</h2>
                <span>↑ 15.7% vs mes anterior</span>
            </div>
            <div class="stat-card">
                <h3>Ventas Totales</h3>
                <h2>$45,230.50</h2>
                <span>↑ 18.6% vs mes anterior</span>
            </div>
        </section>

        <section class="charts">
            <div class="chart-box large">
                <h3>Ventas de los últimos 7 días</h3>
                <div class="fake-chart"></div>
            </div>
            <div class="chart-box">
                <h3>Ventas por categoría</h3>
                <div class="circle-chart"></div>
            </div>
        </section>

        <section class="tables">
            <div class="table-box">
                <h3>Pedidos recientes</h3>
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Estado</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#1025</td>
                            <td>Juan Pérez</td>
                            <td>Entregado</td>
                            <td>$1,250</td>
                        </tr>
                        <tr>
                            <td>#1024</td>
                            <td>María García</td>
                            <td>En proceso</td>
                            <td>$860</td>
                        </tr>
                        <tr>
                            <td>#1023</td>
                            <td>Carlos López</td>
                            <td>Pendiente</td>
                            <td>$540</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="table-box">
                <h3>Actividad reciente</h3>
                <ul class="activity-list">
                    <li>Nuevo pedido #1025</li>
                    <li>Producto actualizado</li>
                    <li>Nuevo cliente registrado</li>
                    <li>Oferta creada</li>
                    <li>Pedido cancelado</li>
                </ul>
            </div>
        </section>

    </main>
</div>

@code {
    private void CerrarSesion()
    {
        AuthService.CerrarSesion();
        Navigation.NavigateTo("/");
    }

    private void IrAAgregarProducto()
    {
        Navigation.NavigateTo("/admin/agregar-producto");
    }
    
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: "Segoe UI";
    }

    body {
        background: #f5f7fa;
    }

    .admin-layout {
        display: flex;
        min-height: 100vh;
    }

    /* SIDEBAR */

    .sidebar {
        width: 280px;
        background: linear-gradient(to bottom, #03182d, #061f3b);
        color: white;
        padding: 30px 20px;
        display: flex;
        flex-direction: column;
    }

    .logo {
        display: flex;
        gap: 15px;
        align-items: center;
        margin-bottom: 40px;
    }

    .logo-icon {
        font-size: 30px;
    }

    .logo h2 {
        font-size: 28px;
    }

    .logo span {
        color: #f4b400;
    }

    .logo p {
        font-size: 14px;
        opacity: .8;
    }

    .menu {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .menu-item {
        text-decoration: none;
        color: white;
        padding: 14px 18px;
        border-radius: 12px;
        transition: .3s;
    }

        .menu-item:hover {
            background: rgba(255,255,255,.08);
        }

        .menu-item.active {
            background: #0b3d91;
        }

    .logout-btn {
        margin-top: auto;
        background: transparent;
        border: 1px solid rgba(255,255,255,.2);
        color: white;
        padding: 16px;
        border-radius: 12px;
        cursor: pointer;
    }

    /* MAIN */

    .main-content {
        flex: 1;
        padding: 30px;
        background: #fafbfd;
    }

    /* TOPBAR */

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px;
    }

    .left-topbar {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .menu-toggle {
        font-size: 24px;
        cursor: pointer;
    }

    .search-box {
        width: 420px;
        padding: 14px 18px;
        border: 1px solid #ddd;
        border-radius: 12px;
        outline: none;
    }

    .right-topbar {
        display: flex;
        align-items: center;
        gap: 25px;
    }

    .notification {
        font-size: 22px;
    }

    .admin-user {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .avatar {
        width: 45px;
        height: 45px;
        background: #eef2f7;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* WELCOME */

    .welcome {
        margin-bottom: 30px;
    }

        .welcome h1 {
            font-size: 36px;
            color: #0d1b2a;
        }

        .welcome p {
            color: #666;
            margin-top: 8px;
        }

    /* STATS */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 28px;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(0,0,0,.04);
    }

        .stat-card h3 {
            color: #666;
            margin-bottom: 10px;
        }

        .stat-card h2 {
            font-size: 34px;
            margin-bottom: 10px;
        }

        .stat-card span {
            color: #1aa251;
            font-size: 14px;
        }

    /* CHARTS */

    .charts {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .chart-box {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(0,0,0,.04);
    }

    .fake-chart {
        height: 280px;
        margin-top: 20px;
        background: linear-gradient(to top, #dfe8f7, #ffffff);
        border-radius: 12px;
    }

    .circle-chart {
        width: 220px;
        height: 220px;
        border-radius: 50%;
        margin: 30px auto;
        background: conic-gradient( #2f80ed 0% 40%, #27ae60 40% 65%, #f2c94c 65% 80%, #9b51e0 80% 90%, #d9d9d9 90% 100% );
    }

    /* TABLES */

    .tables {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    .table-box {
        background: white;
        padding: 25px;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(0,0,0,.04);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    th, td {
        text-align: left;
        padding: 14px 10px;
        border-bottom: 1px solid #eee;
    }

    .activity-list {
        margin-top: 20px;
        list-style: none;
    }

        .activity-list li {
            padding: 14px 0;
            border-bottom: 1px solid #eee;
        }
</style>