@page "/admin/despacho"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Data

@attribute [Authorize(Roles = "Admin")]

@* INYECCIONES REALES *@
@inject ApplicationDbContext _context
@inject FerreAppLaVarilla.UI.Models.ServicioDespacho _servicioDespacho
@inject NavigationManager Navigation
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService

<PageTitle>Área de Despacho</PageTitle>

<div class="layout admin-layout">

    <aside class="sidebar">
        <div class="logo">
            <span class="logo-icon">⚡</span>
            <div>
                <h2>FerreApp<span>LaVarilla</span></h2>
                <p>Módulo Logístico</p>
            </div>
        </div>
        <nav class="menu">
            <a href="/panel-admin" class="menu-item">📊 Dashboard</a>
            <a href="/admin/gestionar-productos" class="menu-item">📦 Inventario</a>
            <a href="/admin/despacho" class="menu-item active">🚚 Despacho</a>
        </nav>
        <button class="logout-btn" @onclick="CerrarSesion">Cerrar sesión</button>
    </aside>

    <main class="content main-content">

        <header class="topbar">
            <h1>Panel de Control de Despachos</h1>
        </header>

        @if (!string.IsNullOrEmpty(mensajeAlerta))
        {
            <div style="padding: 15px; margin-bottom: 20px; border-radius: 8px; font-weight: bold; 
                 background-color: @(huboError ? "#ffebee" : "#e8f5e9"); 
                 color: @(huboError ? "#d32f2f" : "#2e7d32");">
                @(huboError ? "❌ " : "✅ ") @mensajeAlerta
            </div>
        }

        <div class="cards" style="display: flex; gap: 15px; margin-bottom: 20px;">
            <div class="card-metric" style="flex:1; padding: 20px; border-radius: 10px; background: #e3f2fd; border-left: 5px solid #2196f3;">
                <h4>Pendientes</h4>
                <h2>@PedidosPendientes()</h2>
            </div>
            <div class="card-metric" style="flex:1; padding: 20px; border-radius: 10px; background: #fff3e0; border-left: 5px solid #ff9800;">
                <h4>En Ruta</h4>
                <h2>@PedidosEnRuta()</h2>
            </div>
            <div class="card-metric" style="flex:1; padding: 20px; border-radius: 10px; background: #e8f5e9; border-left: 5px solid #4caf50;">
                <h4>Entregados</h4>
                <h2>@PedidosEntregados()</h2>
            </div>
        </div>

        <div style="margin-bottom: 20px;">
            <label style="font-weight: bold; margin-right: 10px;">Filtrar por estado:</label>
            <select @bind="filtroEstado" style="padding: 10px; border-radius: 8px; border: 1px solid #ccc; outline: none;">
                <option value="Todos">Todos</option>
                <option value="Pendiente">Pendiente</option>
                <option value="EnRuta">En Ruta</option>
                <option value="Entregado">Entregado</option>
            </select>
        </div>

        <div class="main-grid" style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">

            <div class="tabla" style="background: white; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); overflow: hidden;">
                @if (pedidos == null)
                {
                    <p style="padding: 20px;">Cargando pedidos de SQL Server...</p>
                }
                else if (!PedidosFiltrados().Any())
                {
                    <p style="padding: 20px;">No hay pedidos con este estado.</p>
                }
                else
                {
                    @foreach (var pedido in PedidosFiltrados())
                    {
                        <div class="fila" @onclick="() => SeleccionarPedido(pedido)" 
                             style="display: grid; grid-template-columns: 1fr 2fr 1fr 1fr; padding: 15px 20px; border-bottom: 1px solid #eee; cursor: pointer; transition: 0.2s;">
                            
                            <div>
                                <strong>#@pedido.Id</strong><br />
                                <small style="color: #666;">@pedido.FechaCreacion.ToString("dd/MM/yyyy")</small>
                            </div>

                            <div>Cliente ID: @(pedido.Cliente?.Id ?? 0)</div> 

                            <div>
                                <strong>RD$ @(pedido.Articulos?.Sum(a => (double)a.Producto.Precio * a.Cantidad).ToString("N2") ?? "0.00")</strong>
                            </div>

                            <div>
                                <span style="padding: 5px 10px; border-radius: 50px; font-size: 12px; font-weight: bold;
                                      background: @ObtenerColorEstado(pedido.Estado); color: white;">
                                    @pedido.Estado.ToString()
                                </span>
                            </div>

                        </div>
                    }
                }
            </div>

            <div class="detalle" style="background: white; border-radius: 15px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); align-self: start;">

                @if (pedidoSeleccionado != null)
                {
                    <h3 style="border-bottom: 2px solid #eee; padding-bottom: 10px; margin-bottom: 15px;">
                        Detalle del Pedido #@pedidoSeleccionado.Id
                    </h3>

                    <p><strong>Fecha:</strong> @pedidoSeleccionado.FechaCreacion.ToString("dd/MM/yyyy")</p>
                    <p><strong>Estado Actual:</strong> @pedidoSeleccionado.Estado.ToString()</p>

                    <h4 style="margin-top: 20px; margin-bottom: 10px;">Artículos Solicitados</h4>
                    <div style="background: #f8fafc; padding: 10px; border-radius: 8px;">
                        @if (pedidoSeleccionado.Articulos != null)
                        {
                            @foreach (var item in pedidoSeleccionado.Articulos)
                            {
                                <div style="display: flex; justify-content: space-between; margin-bottom: 5px; font-size: 14px;">
                                    <span>@item.Producto?.Nombre</span>
                                    <strong>x @item.Cantidad</strong>
                                </div>
                            }
                        }
                    </div>

                    <hr style="margin: 20px 0; border: none; border-top: 1px solid #eee;" />

                    @if (pedidoSeleccionado.Estado.ToString() == "Pendiente")
                    {
                        <div style="margin-bottom: 15px;">
                            <label style="font-weight: bold; font-size: 13px;">Asignar Camión Disponible:</label>
                            <select @bind="camionSeleccionadoId" style="width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; margin-top: 5px;">
                                <option value="0">-- Seleccionar --</option>
                                @foreach (var cam in camionesLibres)
                                {
                                    <option value="@cam.Id">@cam.Placa (Cap: @cam.CapacidadMaxima kg)</option>
                                }
                            </select>
                        </div>

                        <button style="width: 100%; padding: 12px; background: #0b3d91; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer; transition: 0.2s;" 
                                @onclick="DespacharPedidoLogica">
                            🚀 Procesar y Despachar
                        </button>
                    }
                    else if (pedidoSeleccionado.Estado.ToString() == "EnRuta" || pedidoSeleccionado.Estado.ToString() == "EnTransito")
                    {
                        <button style="width: 100%; padding: 12px; background: #28a745; color: white; border: none; border-radius: 8px; font-weight: bold; cursor: pointer;" 
                                @onclick="MarcarComoEntregado">
                            ✅ Confirmar Entrega
                        </button>
                    }
                    else
                    {
                        <div style="text-align: center; color: #28a745; font-weight: bold; padding: 15px; background: #e8f5e9; border-radius: 8px;">
                            Este pedido ya fue procesado.
                        </div>
                    }
                }
                else
                {
                    <div style="text-align: center; color: #999; padding: 40px 0;">
                        <span style="font-size: 40px;">📦</span>
                        <p style="margin-top: 10px;">Selecciona un pedido de la lista para ver sus detalles y gestionarlo.</p>
                    </div>
                }

            </div>

        </div>

    </main>
</div>

@code {
    private List<Pedido> pedidos = new();
    private List<Camion> camionesLibres = new();
    
    private Pedido? pedidoSeleccionado;
    private int camionSeleccionadoId;
    
    private string filtroEstado = "Todos";
    
    private string mensajeAlerta = "";
    private bool huboError = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            pedidos = await _context.Pedidos
                .Include(p => p.Cliente)
                .Include(p => p.Articulos).ThenInclude(a => a.Producto)
                .Include(p => p.CamionAsignado)
                .ToListAsync();

            camionesLibres = await _context.Camiones
                .Where(c => c.Disponible == true)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            huboError = true;
            mensajeAlerta = "Error cargando la BD: " + ex.Message;
        }
    }

    private void SeleccionarPedido(Pedido p)
    {
        pedidoSeleccionado = p;
        mensajeAlerta = ""; 
        camionSeleccionadoId = 0;
    }

    private IEnumerable<Pedido> PedidosFiltrados()
    {
        if (pedidos == null || !pedidos.Any()) return Enumerable.Empty<Pedido>();

        if (filtroEstado == "Todos")
            return pedidos;

        return pedidos.Where(p => p.Estado.ToString() == filtroEstado);
    }

    // CONEXIÓN CON LA LÓGICA DE NEGOCIO
    private async Task DespacharPedidoLogica()
    {
        mensajeAlerta = "";
        huboError = false;

        if (camionSeleccionadoId == 0)
        {
            huboError = true;
            mensajeAlerta = "Debes seleccionar un camión para despachar.";
            return;
        }

        var camionElegido = camionesLibres.FirstOrDefault(c => c.Id == camionSeleccionadoId);

        try
        {
            // Ejecutamos las validaciones matemáticas
            _servicioDespacho.ProcesarDespacho(pedidoSeleccionado!, camionElegido!);

            pedidoSeleccionado!.CamionAsignado = camionElegido!;
            _context.Pedidos.Update(pedidoSeleccionado);
            _context.Camiones.Update(camionElegido!);
            
            await _context.SaveChangesAsync();

            huboError = false;
            mensajeAlerta = "Pedido puesto en tránsito correctamente.";
            pedidoSeleccionado = null; 
            await CargarDatos(); 
        }
        catch (Exception ex)
        {
            huboError = true;
            mensajeAlerta = ex.Message; 
        }
    }

    private async Task MarcarComoEntregado()
    {
        try 
        {
            // Aseguramos que cambie al estado entregado (Entregado o Completado)
            if(Enum.TryParse<EstadoPedido>("Entregado", out var estadoEntregado))
            {
                pedidoSeleccionado!.Estado = estadoEntregado;
            }
            else if(Enum.TryParse<EstadoPedido>("Completado", out var estadoCompletado))
            {
                pedidoSeleccionado!.Estado = estadoCompletado;
            }

            if (pedidoSeleccionado!.CamionAsignado != null)
            {
                pedidoSeleccionado.CamionAsignado.Disponible = true;
                _context.Camiones.Update(pedidoSeleccionado.CamionAsignado);
            }

            _context.Pedidos.Update(pedidoSeleccionado);
            await _context.SaveChangesAsync();

            mensajeAlerta = "Pedido entregado y camión liberado.";
            pedidoSeleccionado = null;
            await CargarDatos();
        }
        catch(Exception ex)
        {
            huboError = true;
            mensajeAlerta = "Error al entregar: " + ex.Message;
        }
    }

    // UTILIDADES VISUALES Y MATEMÁTICAS
    private int PedidosPendientes() => pedidos?.Count(p => p.Estado.ToString() == "Pendiente") ?? 0;
    private int PedidosEnRuta() => pedidos?.Count(p => p.Estado.ToString() == "EnRuta" || p.Estado.ToString() == "EnTransito") ?? 0;
    private int PedidosEntregados() => pedidos?.Count(p => p.Estado.ToString() == "Entregado" || p.Estado.ToString() == "Completado") ?? 0;

    private string ObtenerColorEstado(EstadoPedido estado)
    {
        var e = estado.ToString();
        if (e == "Pendiente") return "#f39c12"; // Naranja
        if (e == "EnRuta" || e == "EnTransito") return "#3498db"; // Azul
        if (e == "Entregado" || e == "Completado") return "#28a745"; // Verde
        if (e == "Cancelado" || e == "Retrasado") return "#dc3545"; // Rojo
        return "#6c757d"; // Gris por defecto
    }

    private void CerrarSesion()
    {
        AuthService.CerrarSesion();
        Navigation.NavigateTo("/");
    }
}

<style>
    /* ESTILOS GLOBALES DE LA FERREAPP (ESTILO ADMIN) */
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; }
    body { background: #f7f9fc; color: #333; }
    .admin-layout { display: flex; min-height: 100vh; }
    
    /* SIDEBAR */
    .sidebar { width: 280px; background: linear-gradient(to bottom, #03182d, #061f3b); color: white; padding: 30px 20px; display: flex; flex-direction: column; }
    .logo { display: flex; gap: 15px; align-items: center; margin-bottom: 40px; }
    .logo-icon { font-size: 28px; }
    .logo h2 { font-size: 24px; }
    .logo h2 span { color: #f4b400; }
    .logo p { font-size: 13px; opacity: 0.7; }
    .menu { display: flex; flex-direction: column; gap: 10px; }
    .menu-item { text-decoration: none; color: white; padding: 14px 18px; border-radius: 12px; transition: 0.3s ease; font-size: 15px; }
    .menu-item:hover { background: rgba(255, 255, 255, 0.08); }
    .menu-item.active { background: #0b3d91; font-weight: bold; }
    .logout-btn { margin-top: auto; padding: 15px; border: 1px solid rgba(255,255,255,0.2); background: transparent; color: white; border-radius: 12px; cursor: pointer; transition: 0.3s; }
    .logout-btn:hover { background: rgba(255,255,255,0.05); }

    /* CONTENT & TOPBAR */
    .main-content { flex: 1; padding: 30px; }
    .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid #eee; }
    .topbar h1 { font-size: 26px; color: #0d1b2a; }

    /* TABLA */
    .fila:hover { background-color: #f8fafc; transform: translateX(5px); }
</style>