@page "/admin/despacho"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Data

@attribute [Authorize(Roles = "Admin")]

@inject ApplicationDbContext _context
@inject FerreAppLaVarilla.UI.Models.ServicioDespacho _servicioDespacho
@inject NavigationManager Navigation
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService

<PageTitle>Área de Despacho - FerreApp La Varilla</PageTitle>

<div class="admin-container">

    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <div class="logo-icon">⚡</div>
            <div class="logo-text">
                <h2>FerreApp</h2>
                <span>La Varilla</span>
            </div>
        </div>
        <nav class="sidebar-nav">
            <a href="/panel-admin" class="nav-link"><span>🏠</span> Inicio</a>
            <a href="/admin/pedidos" class="nav-link"><span>🛒</span> Pedidos</a>
            <a href="/admin/gestionar-productos" class="nav-link"><span>📦</span> Productos</a>
            <a href="/admin/clientes" class="nav-link"><span>👤</span> Clientes</a>
            <a href="/admin/despacho" class="nav-link active"><span>🚚</span> Despacho</a>
            <a href="/admin/reportes" class="nav-link"><span>📊</span> Reportes</a>
            <a href="/admin/configuracion" class="nav-link"><span>⚙️</span> Configuración</a>
        </nav>
        <div class="sidebar-footer">
            <div class="admin-pill">
                <div class="avatar">AD</div>
                <div class="admin-info">
                    <strong>Administrador</strong>
                    <small>admin@ferreapp.com</small>
                </div>
            </div>
            <button class="btn-logout-minimal" @onclick="CerrarSesion">Cerrar Sesión</button>
        </div>
    </aside>

    <main class="admin-main">

        <header class="admin-topbar">
            <div class="welcome-text">
                <h1>Control de Despachos 🚚</h1>
                <p>Asigna camiones y monitorea el estado de las entregas en tiempo real.</p>
            </div>
            <div class="topbar-actions">
                <div class="date-display">📅 @DateTime.Now.ToString("dddd, dd MMM")</div>
            </div>
        </header>

        @if (!string.IsNullOrEmpty(mensajeAlerta))
        {
            <div class="alert-banner @(huboError ? "error" : "success")">
                @(huboError ? "❌ " : "✅ ") @mensajeAlerta
            </div>
        }

        <section class="stats-cards-grid" style="margin-bottom: 30px;">
            <div class="card-stat">
                <div class="card-body">
                    <small>Pendientes de envío</small>
                    <h2>@PedidosPendientes()</h2>
                </div>
                <div class="card-icon orange">📦</div>
            </div>
            <div class="card-stat">
                <div class="card-body">
                    <small>En Ruta (Tránsito)</small>
                    <h2>@PedidosEnRuta()</h2>
                </div>
                <div class="card-icon blue">🚚</div>
            </div>
            <div class="card-stat">
                <div class="card-body">
                    <small>Entregados Hoy</small>
                    <h2>@PedidosEntregados()</h2>
                </div>
                <div class="card-icon green">✅</div>
            </div>
        </section>

        <div class="despacho-grid">
            
            <div class="data-card list-card">
                <div class="card-header-flex" style="margin-bottom: 20px;">
                    <h3>Cola de Pedidos</h3>
                    <select class="admin-input-sm" @bind="filtroEstado" style="width: auto;">
                        <option value="Todos">Todos los estados</option>
                        <option value="Pendiente">Pendientes</option>
                        <option value="EnRuta">En Ruta</option>
                        <option value="Entregado">Entregados</option>
                    </select>
                </div>

                @if (pedidos == null)
                {
                    <div class="loader-container" style="height: 200px;">
                        <div class="custom-spinner"></div>
                        <p>Cargando pedidos...</p>
                    </div>
                }
                else if (!PedidosFiltrados().Any())
                {
                    <div style="text-align: center; padding: 40px; color: #64748b;">
                        <p>No hay pedidos con el estado seleccionado.</p>
                    </div>
                }
                else
                {
                    <div class="order-list">
                        @foreach (var pedido in PedidosFiltrados())
                        {
                            <div class="order-list-item @(pedidoSeleccionado?.Id == pedido.Id ? "selected" : "")" @onclick="() => SeleccionarPedido(pedido)">
                                <div class="order-list-header">
                                    <strong>#PED-@pedido.Id.ToString().PadLeft(5, '0')</strong>
                                    <span class="badge @pedido.Estado.ToString().ToLower()">@pedido.Estado.ToString()</span>
                                </div>
                                <div class="order-list-body">
                                    <span>👤 @(pedido.Cliente?.CorreoElectronico ?? "Consumidor Final")</span>
                                    <strong>RD$ @pedido.Total.ToString("N2")</strong>
                                </div>
                                <small class="order-date">📅 @pedido.FechaCreacion.ToString("dd MMM yyyy - HH:mm")</small>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="data-card action-panel-card">
                
                @if (pedidoSeleccionado != null)
                {
                    <div class="action-panel-header">
                        <h2>Detalle del Pedido #@pedidoSeleccionado.Id.ToString().PadLeft(5, '0')</h2>
                        <span class="badge @pedidoSeleccionado.Estado.ToString().ToLower()">@pedidoSeleccionado.Estado.ToString()</span>
                    </div>

                    <div class="order-details-section">
                        <h4>📋 Artículos a despachar</h4>
                        <div class="items-container">
                            @if (pedidoSeleccionado.Articulos != null)
                            {
                                @foreach (var item in pedidoSeleccionado.Articulos)
                                {
                                    <div class="item-row">
                                        <span>@item.Producto?.Nombre</span>
                                        <strong>@item.Cantidad uds.</strong>
                                    </div>
                                }
                            }
                        </div>
                        <div class="total-row">
                            <span>Monto Total:</span>
                            <strong>RD$ @pedidoSeleccionado.Total.ToString("N2")</strong>
                        </div>
                    </div>

                    <div class="logistics-action-section">
                        
                        @if (pedidoSeleccionado.Estado.ToString() == "Pendiente")
                        {
                            <h4>🚚 Asignación de Unidad</h4>
                            <p>Selecciona un camión disponible para enviar este pedido.</p>
                            
                            <select class="admin-input" @bind="camionSeleccionadoId" style="margin-bottom: 15px;">
                                <option value="0">-- Seleccionar Camión --</option>
                                @foreach (var cam in camionesLibres)
                                {
                                    <option value="@cam.Id">Placa: @cam.Placa | Capacidad: @cam.CapacidadMaxima kg</option>
                                }
                            </select>

                            <button class="btn-action primary" style="width: 100%;" @onclick="DespacharPedidoLogica">
                                🚀 Iniciar Despacho
                            </button>
                        }
                        else if (pedidoSeleccionado.Estado.ToString() == "EnRuta" || pedidoSeleccionado.Estado.ToString() == "EnTransito")
                        {
                            <div class="transit-info">
                                <h4>📍 Información de Tránsito</h4>
                                <p><strong>Unidad Asignada:</strong> @(pedidoSeleccionado.CamionAsignado?.Placa ?? "N/A")</p>
                                <p>El pedido está actualmente en camino hacia el cliente.</p>
                            </div>
                            
                            <button class="btn-action" style="width: 100%; background: #10b981; color: white;" @onclick="MarcarComoEntregado">
                                ✅ Confirmar Entrega Realizada
                            </button>
                        }
                        else
                        {
                            <div class="success-info">
                                <h4>🎉 Proceso Completado</h4>
                                <p>Este pedido ya fue entregado al cliente y el proceso logístico está cerrado.</p>
                                @if(pedidoSeleccionado.CamionAsignado != null)
                                {
                                    <p><strong>Entregado por unidad:</strong> @pedidoSeleccionado.CamionAsignado.Placa</p>
                                }
                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="empty-state-panel">
                        <div class="icon">📦</div>
                        <h3>Ningún pedido seleccionado</h3>
                        <p>Haz clic en un pedido de la lista izquierda para ver sus detalles y gestionar su despacho.</p>
                    </div>
                }

            </div>
        </div>

    </main>
</div>

@code {
    private List<Pedido> pedidos = new();
    private List<Camion> camionesLibres = new();
    
    private Pedido? pedidoSeleccionado;
    private int camionSeleccionadoId;
    
    private string filtroEstado = "Todos";
    private string mensajeAlerta = "";
    private bool huboError = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            pedidos = await _context.Pedidos
                .Include(p => p.Cliente)
                .Include(p => p.Articulos).ThenInclude(a => a.Producto)
                .Include(p => p.CamionAsignado)
                .OrderByDescending(p => p.FechaCreacion) // Mostramos los más recientes primero
                .ToListAsync();

            camionesLibres = await _context.Camiones
                .Where(c => c.Disponible == true)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            huboError = true;
            mensajeAlerta = "Error cargando datos: " + ex.Message;
        }
    }

    private void SeleccionarPedido(Pedido p)
    {
        pedidoSeleccionado = p;
        mensajeAlerta = ""; 
        camionSeleccionadoId = 0;
    }

    private IEnumerable<Pedido> PedidosFiltrados()
    {
        if (pedidos == null || !pedidos.Any()) return Enumerable.Empty<Pedido>();

        if (filtroEstado == "Todos") return pedidos;
        
        return pedidos.Where(p => p.Estado.ToString() == filtroEstado);
    }

    private async Task DespacharPedidoLogica()
    {
        mensajeAlerta = "";
        huboError = false;

        if (camionSeleccionadoId == 0)
        {
            huboError = true;
            mensajeAlerta = "Debes seleccionar un camión para despachar.";
            return;
        }

        var camionElegido = camionesLibres.FirstOrDefault(c => c.Id == camionSeleccionadoId);

        try
        {
            _servicioDespacho.ProcesarDespacho(pedidoSeleccionado!, camionElegido!);

            pedidoSeleccionado!.CamionAsignado = camionElegido!;
            // Aseguramos que el estado cambie usando el Enum
            if(Enum.TryParse<EstadoPedido>("EnRuta", out var estadoRuta))
            {
               pedidoSeleccionado.Estado = estadoRuta;
            }
            
            _context.Pedidos.Update(pedidoSeleccionado);
            _context.Camiones.Update(camionElegido!);
            
            await _context.SaveChangesAsync();

            huboError = false;
            mensajeAlerta = "Pedido asignado al camión y puesto en ruta.";
            pedidoSeleccionado = null; 
            await CargarDatos(); 
        }
        catch (Exception ex)
        {
            huboError = true;
            mensajeAlerta = ex.Message; 
        }
    }

    private async Task MarcarComoEntregado()
    {
        try 
        {
            if(Enum.TryParse<EstadoPedido>("Entregado", out var estadoEntregado))
            {
                pedidoSeleccionado!.Estado = estadoEntregado;
            }

            if (pedidoSeleccionado!.CamionAsignado != null)
            {
                pedidoSeleccionado.CamionAsignado.Disponible = true;
                _context.Camiones.Update(pedidoSeleccionado.CamionAsignado);
            }

            _context.Pedidos.Update(pedidoSeleccionado);
            await _context.SaveChangesAsync();

            mensajeAlerta = "Pedido marcado como entregado. Camión liberado.";
            pedidoSeleccionado = null;
            await CargarDatos();
        }
        catch(Exception ex)
        {
            huboError = true;
            mensajeAlerta = "Error al confirmar entrega: " + ex.Message;
        }
    }

    private int PedidosPendientes() => pedidos?.Count(p => p.Estado.ToString() == "Pendiente") ?? 0;
    private int PedidosEnRuta() => pedidos?.Count(p => p.Estado.ToString() == "EnRuta" || p.Estado.ToString() == "EnTransito") ?? 0;
    private int PedidosEntregados() => pedidos?.Count(p => p.Estado.ToString() == "Entregado" || p.Estado.ToString() == "Completado") ?? 0;

    private void CerrarSesion()
    {
        AuthService.CerrarSesion();
        Navigation.NavigateTo("/");
    }
}

<style>
    /* Estilos Globales heredados de AdminTheme */
    @((MarkupString)FerreAppLaVarilla.UI.Services.AdminTheme.EstilosGlobales)

    /* ALERTAS */
    .alert-banner { padding: 15px 20px; border-radius: 12px; margin-bottom: 25px; font-weight: 600; font-size: 14px; }
    .alert-banner.success { background: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; }
    .alert-banner.error { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }

    /* LAYOUT MAESTRO-DETALLE */
    .despacho-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: 25px; align-items: start; }
    
    /* COLUMNA IZQUIERDA (LISTA) */
    .list-card { padding: 20px; max-height: 800px; overflow-y: auto; }
    .order-list { display: flex; flex-direction: column; gap: 10px; }
    
    .order-list-item { border: 1px solid #e2e8f0; border-radius: 12px; padding: 15px; cursor: pointer; transition: 0.2s; background: white; }
    .order-list-item:hover { border-color: #3b82f6; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.08); }
    .order-list-item.selected { border-color: #0b1527; border-left: 4px solid #0b1527; background: #f8fafc; }
    
    .order-list-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .order-list-header strong { font-size: 16px; color: #0f172a; }
    
    .order-list-body { display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: #475569; margin-bottom: 8px; }
    .order-list-body strong { color: #0f172a; }
    
    .order-date { font-size: 12px; color: #94a3b8; }

    /* COLUMNA DERECHA (PANEL DE ACCIÓN) */
    .action-panel-card { padding: 30px; position: sticky; top: 20px; }
    
    .action-panel-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #e2e8f0; padding-bottom: 15px; margin-bottom: 20px; }
    .action-panel-header h2 { margin: 0; font-size: 22px; color: #0f172a; }
    
    .order-details-section h4 { font-size: 15px; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 15px; }
    
    .items-container { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 15px; margin-bottom: 15px; }
    .item-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px dashed #cbd5e1; font-size: 14px; color: #334155; }
    .item-row:last-child { border-bottom: none; }
    
    .total-row { display: flex; justify-content: space-between; align-items: center; padding: 15px; background: #eff6ff; border-radius: 10px; color: #1e3a8a; font-size: 18px; margin-bottom: 30px; }
    
    .logistics-action-section { border-top: 1px solid #e2e8f0; padding-top: 25px; }
    .logistics-action-section h4 { font-size: 16px; color: #0f172a; margin-bottom: 8px; }
    .logistics-action-section p { color: #64748b; font-size: 14px; margin-bottom: 15px; line-height: 1.5; }
    
    .transit-info { background: #e0f2fe; padding: 20px; border-radius: 12px; border-left: 4px solid #0ea5e9; margin-bottom: 20px; }
    .transit-info h4 { color: #0369a1; margin-bottom: 10px; }
    .transit-info p { color: #075985; margin: 0 0 5px 0; }
    
    .success-info { background: #ecfdf5; padding: 20px; border-radius: 12px; border-left: 4px solid #10b981; text-align: center; }
    .success-info h4 { color: #047857; margin-bottom: 10px; font-size: 18px; }
    .success-info p { color: #065f46; margin: 0; }

    .empty-state-panel { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 400px; text-align: center; color: #94a3b8; }
    .empty-state-panel .icon { font-size: 60px; margin-bottom: 15px; opacity: 0.5; }
    .empty-state-panel h3 { color: #475569; margin-bottom: 10px; }
    .empty-state-panel p { max-width: 300px; line-height: 1.5; }

    /* ESTILOS DE ESTADOS (BADGES) */
    .badge { padding: 6px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge.pendiente { background: #fffbeb; color: #d97706; border: 1px solid #fde68a; }
    .badge.enruta, .badge.entransito { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }
    .badge.entregado, .badge.completado { background: #f0fdf4; color: #059669; border: 1px solid #a7f3d0; }
    .badge.cancelado { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }

    @@media (max-width: 1100px) {
        .despacho-grid { grid-template-columns: 1fr; }
        .action-panel-card { position: static; }
    }
</style>