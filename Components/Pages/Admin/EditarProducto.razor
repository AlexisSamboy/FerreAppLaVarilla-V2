@page "/admin/editar-producto/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Services

@attribute [Authorize(Roles = "Admin")]

@inject ProductoService ProductoService
@inject NavigationManager Navigation
@inject AutenticacionService AuthService

<PageTitle>Editar Producto - FerreApp La Varilla</PageTitle>

<div class="ferreapp-admin-layout">

    <aside class="ferreapp-sidebar">
        <div class="sidebar-logo">
            <div class="logo-icon-bg">
                <span class="logo-icon">⚡</span>
            </div>
            <div class="logo-text">
                <h2>FerreApp</h2>
                <span>LA VARILLA</span>
            </div>
        </div>
        
        <nav class="sidebar-menu">
            <a href="/panel-admin" class="menu-link">
                <span class="menu-icon">🏠</span> Inicio
            </a>
            <a href="/admin/pedidos" class="menu-link">
                <span class="menu-icon">🛒</span> Pedidos
            </a>
            <a href="/admin/gestionar-productos" class="menu-link active">
                <span class="menu-icon">📦</span> Productos
            </a>
            <a href="/admin/clientes" class="menu-link">
                <span class="menu-icon">👤</span> Clientes
            </a>
            <a href="/admin/reportes" class="menu-link">
                <span class="menu-icon">📊</span> Reportes
            </a>
            <a href="/admin/configuracion" class="menu-link">
                <span class="menu-icon">⚙️</span> Configuración
            </a>
        </nav>

        <div class="sidebar-footer">
            <div class="admin-profile">
                <div class="admin-avatar">AD</div>
                <div class="admin-info">
                    <strong>Administrador</strong>
                    <small>admin@ferreapp.com</small>
                </div>
            </div>
            <button class="btn-logout" @onclick="CerrarSesion">Cerrar Sesión</button>
        </div>
    </aside>

    <main class="ferreapp-main">
        @if (cargando)
        {
            <div class="loader-container">
                <div class="spinner"></div>
                <p>Cargando producto...</p>
            </div>
        }
        else if (producto == null)
        {
            <div class="premium-card text-center" style="margin-top: 50px;">
                <h2 style="color: #ef4444;">❌ No se encontró el producto</h2>
                <button class="btn-secondary" style="margin-top:20px;" @onclick="Cancelar">Volver al inventario</button>
            </div>
        }
        else
        {
            <EditForm Model="producto" OnSubmit="ActualizarProducto">
                
                <header class="topbar-header">
                    <div class="header-titles">
                        <h1>Editar: @producto.Nombre</h1>
                        <p>Actualiza la información, precios o imagen de este producto.</p>
                    </div>
                    <div class="header-actions">
                        <button type="button" class="btn-secondary" @onclick="Cancelar">Cancelar</button>
                        <button type="submit" class="btn-primary">💾 Guardar cambios</button>
                    </div>
                </header>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="alert-error">⚠️ @mensajeError</div>
                }

                <div class="form-layout-grid">

                    <div class="form-col-left">
                        
                        <div class="premium-card">
                            <div class="card-header-with-action">
                                <h3>Información Básica</h3>
                                <label class="checkbox-toggle">
                                    <input type="checkbox" @bind="habilitarEdicionId" />
                                    <span>¿Modificar Nombre y SKU?</span>
                                </label>
                            </div>

                            <div class="form-group mt-3">
                                <label>Nombre del producto *</label>
                                <input type="text" @bind="producto.Nombre" required 
                                       disabled="@(!habilitarEdicionId)" 
                                       class="custom-input @(habilitarEdicionId ? "" : "input-locked")" />
                            </div>

                            <div class="form-group mt-3">
                                <label>SKU / Código *</label>
                                <input type="text" @bind="producto.Sku" required 
                                       disabled="@(!habilitarEdicionId)" 
                                       class="custom-input @(habilitarEdicionId ? "" : "input-locked")" />
                            </div>

                            <div class="form-group mt-3">
                                <label>Categoría</label>
                                <select class="custom-input" @bind="producto.Categoria">
                                    <option value="Materiales">Materiales</option>
                                    <option value="Herramientas">Herramientas</option>
                                    <option value="Plomería">Plomería</option>
                                    <option value="Electricidad">Electricidad</option>
                                    <option value="Pinturas">Pinturas</option>
                                    <option value="Acabados">Acabados</option>
                                </select>
                            </div>

                            <div class="form-group mt-3">
                                <label>Descripción *</label>
                                <textarea @bind="producto.Descripcion" required class="custom-input" rows="4"></textarea>
                            </div>
                        </div>

                        <div class="premium-card mt-4">
                            <h3>Precios e Inventario</h3>
                            <div class="grid-3-cols mt-3">
                                <div class="form-group">
                                    <label>Precio Compra (RD$)</label>
                                    <input type="number" step="0.01" @bind="producto.PrecioCompra" required class="custom-input" />
                                </div>
                                <div class="form-group">
                                    <label>Precio Venta (RD$)</label>
                                    <input type="number" step="0.01" @bind="producto.Precio" required class="custom-input" />
                                </div>
                                <div class="form-group">
                                    <label>Stock Físico</label>
                                    <input type="number" @bind="producto.Stock" required class="custom-input" />
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="form-col-right">
                        
                        <div class="premium-card text-center">
                            <h3>Imagen del producto</h3>
                            
                            @if (!string.IsNullOrEmpty(producto.ImagenUrl))
                            {
                                <div class="image-preview">
                                    <img src="images/@producto.ImagenUrl" onerror="this.src='images/default.png'" />
                                    <span class="badge-img">Imagen Actual</span>
                                </div>
                            }

                            <div class="file-drop-area mt-3">
                                <InputFile OnChange="CargarImagen" class="file-input-hidden" />
                                <div class="icon-cloud">☁️</div>
                                <p><strong>@nombreArchivoVista</strong></p>
                                <small>Haz clic para subir otra foto</small>
                            </div>
                        </div>

                        <div class="premium-card mt-4">
                            <h3>Análisis de Rentabilidad</h3>
                            
                            <div class="rentability-stats mt-3">
                                <div class="stat-box">
                                    <small>COMPRA</small>
                                    <strong>RD$ @producto.PrecioCompra.ToString("N2")</strong>
                                </div>
                                <div class="stat-box">
                                    <small>VENTA</small>
                                    <strong>RD$ @producto.Precio.ToString("N2")</strong>
                                </div>
                                <div class="stat-box">
                                    <small>MARGEN</small>
                                    <strong style="color: #10b981;">@CalcularMargen().ToString("N0")%</strong>
                                </div>
                            </div>

                            <div class="profit-chart mt-4">
                                <div class="profit-circle-outer" style="background: conic-gradient(#3b82f6 0% @(CalcularMargen())%, #f1f5f9 @(CalcularMargen())% 100%);">
                                    <div class="profit-circle-inner">
                                        <h2>@CalcularMargen().ToString("N0")%</h2>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>

                </div>
            </EditForm>
        }
    </main>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Producto producto;
    private bool cargando = true;
    private string mensajeError = "";
    private string nombreArchivoVista = "Cambiar imagen del producto";
    private bool habilitarEdicionId = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cargando = true;
            var resultado = await ProductoService.ObtenerProductoPorIdAsync(Id);
            if (resultado != null)
            {
                producto = resultado;
                if (!string.IsNullOrEmpty(producto.ImagenUrl))
                {
                    nombreArchivoVista = "✔️ " + producto.ImagenUrl;
                }
            }
            else
            {
                mensajeError = "No se encontró el producto.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private decimal CalcularMargen()
    {
        if (producto == null || producto.Precio <= 0 || producto.PrecioCompra >= producto.Precio)
            return 0;
        return ((producto.Precio - producto.PrecioCompra) / producto.Precio) * 100;
    }

    private void CargarImagen(InputFileChangeEventArgs e)
    {
        if (e.File != null)
        {
            nombreArchivoVista = "✔️ " + e.File.Name;
            producto.ImagenUrl = e.File.Name;
        }
    }

    private async Task ActualizarProducto()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(producto.Nombre) || producto.Precio <= 0)
            {
                mensajeError = "Por favor, completa los campos obligatorios (*).";
                return;
            }
            await ProductoService.ActualizarProductoAsync(producto);
            Navigation.NavigateTo("/admin/gestionar-productos");
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo actualizar: " + ex.Message;
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/admin/gestionar-productos");
    private void CerrarSesion() { AuthService.CerrarSesion(); Navigation.NavigateTo("/"); }
}

<style>
    /* RESET Y VARIABLES (Basado en el Dashboard real) */
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { background-color: #f4f7fe; color: #1e293b; }
    
    .ferreapp-admin-layout { display: flex; min-height: 100vh; }

    /* SIDEBAR EXACTO AL DASHBOARD */
    .ferreapp-sidebar { width: 260px; background-color: #0b1527; color: white; display: flex; flex-direction: column; padding: 25px 20px; }
    .sidebar-logo { display: flex; align-items: center; gap: 12px; margin-bottom: 40px; }
    .logo-icon-bg { background-color: #f59e0b; padding: 8px 12px; border-radius: 10px; }
    .logo-icon { font-size: 20px; color: white; }
    .logo-text h2 { font-size: 20px; margin: 0; color: white; font-weight: 700; }
    .logo-text span { font-size: 11px; color: #f59e0b; letter-spacing: 1px; text-transform: uppercase; }
    
    .sidebar-menu { display: flex; flex-direction: column; gap: 5px; flex-grow: 1; }
    .menu-link { display: flex; align-items: center; gap: 12px; padding: 12px 15px; color: #94a3b8; text-decoration: none; border-radius: 10px; font-weight: 500; font-size: 15px; transition: 0.3s; }
    .menu-link:hover { color: white; background-color: rgba(255,255,255,0.05); }
    .menu-link.active { background-color: #1e293b; color: white; border-left: 4px solid #f59e0b; border-radius: 0 10px 10px 0; }
    
    .sidebar-footer { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; }
    .admin-profile { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; }
    .admin-avatar { width: 40px; height: 40px; background-color: #3b82f6; border-radius: 10px; display: flex; justify-content: center; align-items: center; font-weight: bold; }
    .admin-info strong { display: block; font-size: 14px; }
    .admin-info small { color: #94a3b8; font-size: 12px; }
    .btn-logout { width: 100%; padding: 10px; background: transparent; border: 1px solid rgba(255,255,255,0.2); color: white; border-radius: 8px; cursor: pointer; transition: 0.3s; }
    .btn-logout:hover { background: rgba(255,255,255,0.1); }

    /* CONTENIDO PRINCIPAL */
    .ferreapp-main { flex: 1; padding: 40px; overflow-y: auto; }
    
    .topbar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
    .header-titles h1 { font-size: 28px; font-weight: 800; color: #0f172a; margin-bottom: 5px; }
    .header-titles p { color: #64748b; font-size: 15px; }
    
    .header-actions { display: flex; gap: 15px; }
    .btn-primary, .btn-secondary { padding: 12px 24px; border-radius: 12px; font-weight: 600; font-size: 14px; cursor: pointer; border: none; transition: 0.2s; }
    .btn-primary { background-color: #0f172a; color: white; box-shadow: 0 4px 10px rgba(15, 23, 42, 0.2); }
    .btn-primary:hover { background-color: #f59e0b; color: #0f172a; }
    .btn-secondary { background-color: white; border: 1px solid #cbd5e1; color: #475569; }
    .btn-secondary:hover { background-color: #f1f5f9; }

    /* TARJETAS Y FORMULARIO */
    .form-layout-grid { display: grid; grid-template-columns: 1.8fr 1fr; gap: 25px; }
    .premium-card { background-color: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 25px rgba(0,0,0,0.02); }
    .premium-card h3 { font-size: 18px; font-weight: 700; color: #0f172a; margin-bottom: 20px; }
    
    .card-header-with-action { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
    .checkbox-toggle { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #3b82f6; cursor: pointer; background: #eff6ff; padding: 8px 12px; border-radius: 8px; }
    
    .form-group label { display: block; font-size: 13px; font-weight: 600; color: #475569; margin-bottom: 8px; }
    .custom-input { width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1; border-radius: 12px; font-size: 14px; color: #0f172a; background-color: white; outline: none; transition: 0.3s; }
    .custom-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
    .input-locked { background-color: #f8fafc; color: #94a3b8; cursor: not-allowed; border-color: #e2e8f0; }
    
    .grid-3-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .mt-3 { margin-top: 15px; }
    .mt-4 { margin-top: 25px; }
    .text-center { text-align: center; }

    /* IMAGEN Y RENTABILIDAD */
    .image-preview { position: relative; display: inline-block; padding: 15px; border: 1px solid #e2e8f0; border-radius: 16px; margin-bottom: 15px; }
    .image-preview img { max-width: 100%; height: 140px; object-fit: contain; }
    .badge-img { position: absolute; bottom: -10px; left: 50%; transform: translateX(-50%); background: #1e293b; color: white; font-size: 11px; padding: 4px 12px; border-radius: 20px; font-weight: 600; }
    
    .file-drop-area { position: relative; border: 2px dashed #cbd5e1; border-radius: 16px; padding: 25px 15px; background-color: #f8fafc; transition: 0.3s; cursor: pointer; }
    .file-drop-area:hover { border-color: #3b82f6; background-color: #eff6ff; }
    .file-input-hidden { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    .icon-cloud { font-size: 32px; color: #3b82f6; margin-bottom: 10px; }
    .file-drop-area p { color: #0f172a; font-size: 14px; margin-bottom: 5px; }
    
    .rentability-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .stat-box { background-color: #f8fafc; border: 1px solid #e2e8f0; padding: 12px; border-radius: 12px; text-align: center; }
    .stat-box small { display: block; font-size: 11px; color: #64748b; font-weight: 700; margin-bottom: 5px; }
    .stat-box strong { font-size: 15px; color: #0f172a; }

    .profit-chart { display: flex; justify-content: center; align-items: center; padding: 20px 0; }
    .profit-circle-outer { width: 160px; height: 160px; border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: 0 10px 20px rgba(59, 130, 246, 0.1); }
    .profit-circle-inner { width: 120px; height: 120px; background-color: white; border-radius: 50%; display: flex; justify-content: center; align-items: center; box-shadow: inset 0 2px 5px rgba(0,0,0,0.05); }
    .profit-circle-inner h2 { font-size: 28px; font-weight: 800; color: #0f172a; margin: 0; }

    /* UTILIDADES */
    .alert-error { background-color: #fef2f2; color: #dc2626; padding: 15px; border-radius: 12px; border: 1px solid #fecaca; font-weight: 600; margin-bottom: 25px; }
    .loader-container { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 50vh; }
    .spinner { width: 45px; height: 45px; border: 4px solid #e2e8f0; border-top: 4px solid #3b82f6; border-radius: 50%; animation: spin 1s linear infinite; margin-bottom: 15px; }
    @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    @@media (max-width: 1024px) {
        .form-layout-grid { grid-template-columns: 1fr; }
        .ferreapp-sidebar { width: 80px; padding: 25px 10px; }
        .logo-text, .menu-link text, .admin-info { display: none; }
        .sidebar-logo { justify-content: center; }
        .menu-link { justify-content: center; padding: 15px; }
    }
</style>