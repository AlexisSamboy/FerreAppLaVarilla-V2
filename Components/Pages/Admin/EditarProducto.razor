        margin-top: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        font-size: 14px;
        color: #333;
    }

    input, select, textarea {
