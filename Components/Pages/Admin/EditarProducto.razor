@page "/admin/editar-producto/{Id:int}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using FerreAppLaVarilla.UI.Models

@attribute [Authorize(Roles = "Admin")]

@inject FerreAppLaVarilla.UI.Services.ProductoService ProductoService
@inject NavigationManager Navigation
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService

<PageTitle>Editar Producto - FerreAppLaVarilla</PageTitle>

<div class="admin-layout">

    <aside class="sidebar">
        <div class="logo">
            <span class="logo-icon">⚡</span>
            <div>
                <h2>FerreApp<span>LaVarilla</span></h2>
                <p>Panel de Administración</p>
            </div>
        </div>

        <nav class="menu">
            <a href="/panel-admin" class="menu-item">📊 Dashboard</a>
            <a href="/admin/agregar-producto" class="menu-item">➕ Nuevo Producto</a>
            <a href="/productos" class="menu-item active">📦 Ver Catálogo</a>
        </nav>

        <button class="logout-btn" @onclick="CerrarSesion">
            Cerrar sesión
        </button>
    </aside>

    <main class="main-content">

        @if (cargando)
        {
            <div class="loading-container">
                <div class="spinner"></div>
                <h2>⏳ Recuperando información de SQL Server...</h2>
            </div>
        }
        else if (producto == null)
        {
            <div style="text-align: center; margin-top: 50px;">
                <h2 style="color: #d32f2f;">❌ Error: No se encontró el producto</h2>
                <button class="cancel-btn" style="margin-top:20px;" @onclick="Cancelar">Volver al catálogo</button>
            </div>
        }
        else
        {
            <EditForm Model="producto" OnSubmit="ActualizarProducto">

                <header class="topbar">
                    <div class="left-topbar">
                        <div class="menu-toggle">☰</div>
                        <input type="text" class="search-box" placeholder="Buscar..." />
                    </div>

                    <div class="right-topbar">
                        <div class="admin-user">
                            <div class="avatar">👤</div>
                            <div>
                                <strong>Administrador</strong>
                                <p>admin@ferreapp.com</p>
                            </div>
                        </div>
                    </div>
                </header>

                <section class="page-header">
                    <div>
                        <h1>Editar Producto: @producto.Nombre</h1>
                        <p>Actualiza la información del producto de forma rápida</p>
                    </div>

                    <div class="header-buttons">
                        <button type="button" class="cancel-btn" @onclick="Cancelar">
                            Cancelar
                        </button>

                        <button type="submit" class="save-btn">
                            💾 Guardar cambios
                        </button>
                    </div>
                </section>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="error-box">
                        ⚠️ @mensajeError
                    </div>
                }

                <section class="form-grid">

                    <div class="left-column">

                        <div class="card">
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                                <h2>Información básica</h2>
                                
                                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px; font-weight: bold; color: #0b3d91;">
                                    <input type="checkbox" @bind="habilitarEdicionId" style="width: auto;" />
                                    ¿Modificar Nombre y SKU?
                                </label>
                            </div>

                            <div class="form-row">
                                <div class="form-group">
                                    <label>Nombre del producto *</label>
                                    <input type="text" 
                                           @bind="producto.Nombre" 
                                           disabled="@(!habilitarEdicionId)" 
                                           class="@(habilitarEdicionId ? "" : "disabled-input")"
                                           required />
                                </div>

                                <div class="form-group">
                                    <label>SKU / Código *</label>
                                    <input type="text" 
                                           @bind="producto.Sku" 
                                           disabled="@(!habilitarEdicionId)" 
                                           class="@(habilitarEdicionId ? "" : "disabled-input")"
                                           required />
                                </div>
                            </div>

                            <div class="form-group">
                                <label>Descripción *</label>
                                <textarea @bind="producto.Descripcion" required></textarea>
                            </div>
                        </div>

                        <div class="card">
                            <h2>Precios e inventario</h2>

                            <div class="form-row three">
                                <div class="form-group">
                                    <label>Precio compra (RD$)</label>
                                    <input type="number" step="0.01" @bind="producto.PrecioCompra" required />
                                </div>

                                <div class="form-group">
                                    <label>Precio venta (RD$)</label>
                                    <input type="number" step="0.01" @bind="producto.Precio" required />
                                </div>

                                <div class="form-group">
                                    <label>Stock</label>
                                    <input type="number" @bind="producto.Stock" required />
                                </div>
                            </div>
                        </div>

                    </div>

                    <div class="right-column">

                        <div class="card">
                            <h2>Imagen del producto</h2>

                            <div class="upload-box" style="position: relative; border: 2px dashed #2f80ed; background: #f0f4ff; padding: 25px; text-align: center; border-radius: 12px; cursor: pointer;">
                                <InputFile OnChange="CargarImagen" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;" />
                                <div class="upload-icon" style="font-size: 36px; color: #2f80ed; margin-bottom: 8px;">☁</div>
                                <p><strong>@nombreArchivoVista</strong></p>
                                <small style="color: #666; font-size: 11px;">Haz clic aquí para cambiar la imagen actual (Opcional)</small>
                            </div>
                            <p style="font-size: 11px; color: gray; margin-top: 10px; text-align:center;">Imagen guardada: <strong>@producto.ImagenUrl</strong></p>
                        </div>

                        <div class="card">
                            <h2>Análisis de rentabilidad</h2>

                            <div class="mini-stats">
                                <div class="mini-box">
                                    <small>Compra</small>
                                    <strong>$@producto.PrecioCompra.ToString("N2")</strong>
                                </div>

                                <div class="mini-box">
                                    <small>Venta</small>
                                    <strong>$@producto.Precio.ToString("N2")</strong>
                                </div>

                                <div class="mini-box">
                                    <small>Margen</small>
                                    <strong>@CalcularMargen().ToString("N0")%</strong>
                                </div>
                            </div>

                            <div class="profit-circle"
                                 style="@($"background: conic-gradient(#8b5cf6 0% {CalcularMargen():N0}%, #ececec {CalcularMargen():N0}% 100%);")">

                                <div class="circle-inner">
                                    <h3>@CalcularMargen().ToString("N0")%</h3>
                                </div>
                            </div>
                        </div>

                    </div>

                </section>

            </EditForm>
        }

    </main>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Producto producto;
    private bool cargando = true;
    private string mensajeError = "";
    private string nombreArchivoVista = "Cambiar imagen del producto";
    private bool habilitarEdicionId = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            cargando = true;
            var resultado = await ProductoService.ObtenerProductoPorIdAsync(Id);

            if (resultado != null)
            {
                producto = resultado;
                // Cargamos el nombre actual de la imagen para que se vea en el visor
                if (!string.IsNullOrEmpty(producto.ImagenUrl))
                {
                    nombreArchivoVista = "✔️ " + producto.ImagenUrl;
                }
            }
            else
            {
                mensajeError = "No se encontró el producto en la base de datos.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = "Error al cargar: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }

    private decimal CalcularMargen()
    {
        if (producto == null || producto.Precio <= 0)
            return 0;

        return ((producto.Precio - producto.PrecioCompra) / producto.Precio) * 100;
    }

    private void CargarImagen(InputFileChangeEventArgs e)
    {
        if (e.File != null)
        {
            nombreArchivoVista = "✔️ " + e.File.Name;
            producto.ImagenUrl = e.File.Name;
        }
    }

    private async Task ActualizarProducto()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(producto.Nombre) || producto.Precio <= 0)
            {
                mensajeError = "Por favor, completa los campos obligatorios.";
                return;
            }

            await ProductoService.ActualizarProductoAsync(producto);
            Navigation.NavigateTo("/productos");
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo guardar: " + ex.Message;
        }
    }

    private void Cancelar() => Navigation.NavigateTo("/productos");
    private void CerrarSesion() { AuthService.CerrarSesion(); Navigation.NavigateTo("/"); }
}

<style>
