@page "/admin/gestionar-productos"
@rendermode InteractiveServer
@using FerreAppLaVarilla.UI.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject FerreAppLaVarilla.UI.Services.ProductoService ProductoService
@inject NavigationManager Navigation
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService

<PageTitle>Gestión de Productos - FerreApp La Varilla</PageTitle>

<div class="admin-container">
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <div class="logo-icon">⚡</div>
            <div class="logo-text">
                <h2>FerreApp</h2>
                <span>La Varilla</span>
            </div>
        </div>
        <nav class="sidebar-nav">
            <a href="/panel-admin" class="nav-link"><span>🏠</span> Inicio</a>
            <a href="/admin/pedidos" class="nav-link"><span>🛒</span> Pedidos</a>
            <a href="/admin/gestionar-productos" class="nav-link active"><span>📦</span> Productos</a>
            <a href="/admin/clientes" class="nav-link"><span>👤</span> Clientes</a>
            <a href="/admin/reportes" class="nav-link"><span>📊</span> Reportes</a>
            <a href="/admin/configuracion" class="nav-link"><span>⚙️</span> Configuración</a>
        </nav>
        <div class="sidebar-footer">
            <div class="admin-pill">
                <div class="avatar">AD</div>
                <div class="admin-info">
                    <strong>Administrador</strong>
                    <small>admin@ferreapp.com</small>
                </div>
            </div>
            <button class="btn-logout-minimal" @onclick="CerrarSesion">Cerrar Sesión</button>
        </div>
    </aside>

    <main class="admin-main">
        <header class="admin-topbar">
            <div class="welcome-text">
                <h1>Gestión de Productos 📦</h1>
                <p>Control de inventario, precios y existencias.</p>
            </div>
            <div class="topbar-actions">
                <button class="btn-action primary" @onclick='() => Navigation.NavigateTo("/admin/agregar-producto")'>
                    ➕ Nuevo Producto
                </button>
            </div>
        </header>

        <div class="data-card">
            <div class="table-toolbar">
                <div class="filters-group">
                    <div class="filter-item">
                        <label>Categoría</label>
                        <select class="admin-input-sm" @bind="filtroCategoria" @bind:event="oninput">
                            <option value="">Todas</option>
                            <option value="Materiales">Materiales</option>
                            <option value="Herramientas">Herramientas</option>
                            <option value="Plomería">Plomería</option>
                            <option value="Electricidad">Electricidad</option>
                        </select>
                    </div>
                    <div class="filter-item">
                        <label>Estado de Stock</label>
                        <select class="admin-input-sm" @bind="filtroStock" @bind:event="oninput">
                            <option value="">Todos</option>
                            <option value="bajo">Stock Bajo (&lt; 10)</option>
                            <option value="ok">Con Stock</option>
                        </select>
                    </div>
                </div>
                <div class="search-box">
                    <input type="text" placeholder="Buscar producto o SKU..." class="admin-input" @bind="terminoBusqueda" @bind:event="oninput" />
                </div>
            </div>

            @if (productos == null)
            {
                <div class="loader-container">
                    <div class="custom-spinner"></div>
                    <p>Cargando inventario...</p>
                </div>
            }
            else if (!ProductosPaginados.Any())
            {
                <div class="empty-state">
                    <p>No se encontraron productos con estos filtros.</p>
                </div>
            }
            else
            {
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th width="60">Img</th>
                            <th>Cod. / SKU</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Stock</th>
                            <th>Precio</th>
                            <th style="text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in ProductosPaginados)
                        {
                            <tr>
                                <td>
                                    <div class="table-img-container">
                                        <img src="images/@(string.IsNullOrEmpty(p.ImagenUrl) ? "default.png" : p.ImagenUrl)" onerror="this.src='images/default.png'" />
                                    </div>
                                </td>
                                <td><strong>@p.Sku</strong></td>
                                <td>@p.Nombre</td>
                                <td><span class="badge category">@(string.IsNullOrEmpty(p.Categoria) ? "General" : p.Categoria)</span></td>
                                <td>
                                    <span class="badge @(p.Stock < 10 ? "pendiente" : "entregado")">
                                        @p.Stock uds
                                    </span>
                                </td>
                                <td><strong>RD$ @p.Precio.ToString("N2")</strong></td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <button class="btn-icon-action edit" title="Editar" @onclick='() => Navigation.NavigateTo($"/admin/editar-producto/{p.Id}")'>✏️</button>
                                    <button class="btn-icon-action delete" title="Eliminar" @onclick="() => Borrar(p.Id)">🗑️</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="pagination-container">
    <span class="pagination-info">Mostrando @InicioPaginacion a @FinPaginacion de @TotalProductosFiltrados productos</span>
    <div class="pagination-controls">
        <button class="btn-page" disabled="@(PaginaActual == 1)" @onclick="PaginaAnterior">Anterior</button>
        
        @{
            // Lógica para mostrar solo 5 botones a la vez
            int maxPaginasVisibles = 5;
            int startPage = Math.Max(1, PaginaActual - (maxPaginasVisibles / 2));
            int endPage = Math.Min(TotalPaginas, startPage + maxPaginasVisibles - 1);
            
            if (endPage - startPage + 1 < maxPaginasVisibles)
            {
                startPage = Math.Max(1, endPage - maxPaginasVisibles + 1);
            }
        }

        @if (startPage > 1)
        {
            <button class="btn-page" @onclick="() => IrAPagina(1)">1</button>
            @if (startPage > 2) { <span class="pagination-ellipsis">...</span> }
        }

        @for (int i = startPage; i <= endPage; i++)
        {
            int numPagina = i;
            <button class="btn-page @(PaginaActual == numPagina ? "active" : "")" @onclick="() => IrAPagina(numPagina)">@numPagina</button>
        }

        @if (endPage < TotalPaginas)
        {
            @if (endPage < TotalPaginas - 1) { <span class="pagination-ellipsis">...</span> }
            <button class="btn-page" @onclick="() => IrAPagina(TotalPaginas)">@TotalPaginas</button>
        }

        <button class="btn-page" disabled="@(PaginaActual == TotalPaginas || TotalPaginas == 0)" @onclick="PaginaSiguiente">Siguiente</button>
    </div>
</div>
            }
        </div>
    </main>
</div>

@code {
    private List<Producto>? productos;
    
    // Filtros
    private string terminoBusqueda = "";
    private string filtroCategoria = "";
    private string filtroStock = "";

    // Paginación
    private int PaginaActual = 1;
    private int ItemsPorPagina = 10; // Muestra 10 productos por página

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        productos = await ProductoService.ObtenerProductosAsync();
    }

    private async Task Borrar(int id)
    {
        await ProductoService.EliminarProductoAsync(id);
        await CargarDatos();
    }

    // LÓGICA DE FILTRADO
    private IEnumerable<Producto> ProductosFiltrados
    {
        get
        {
            if (productos == null) return Enumerable.Empty<Producto>();

            var query = productos.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(terminoBusqueda))
            {
                query = query.Where(p => 
                    (p.Nombre != null && p.Nombre.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)) || 
                    (p.Sku != null && p.Sku.Contains(terminoBusqueda, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(filtroCategoria))
            {
                query = query.Where(p => p.Categoria == filtroCategoria);
            }

            if (filtroStock == "bajo")
            {
                query = query.Where(p => p.Stock < 10);
            }
            else if (filtroStock == "ok")
            {
                query = query.Where(p => p.Stock >= 10);
            }

            return query;
        }
    }

    // LÓGICA DE PAGINACIÓN
    private int TotalProductosFiltrados => ProductosFiltrados.Count();
    private int TotalPaginas => (int)Math.Ceiling(TotalProductosFiltrados / (double)ItemsPorPagina);
    private int InicioPaginacion => TotalProductosFiltrados == 0 ? 0 : ((PaginaActual - 1) * ItemsPorPagina) + 1;
    private int FinPaginacion => Math.Min(PaginaActual * ItemsPorPagina, TotalProductosFiltrados);

    private IEnumerable<Producto> ProductosPaginados
    {
        get
        {
            // Si el filtro reduce los resultados, asegurarnos de no estar en una página vacía
            if (PaginaActual > TotalPaginas && TotalPaginas > 0)
            {
                PaginaActual = TotalPaginas;
            }
            else if (TotalPaginas == 0)
            {
                PaginaActual = 1;
            }

            return ProductosFiltrados
                .Skip((PaginaActual - 1) * ItemsPorPagina)
                .Take(ItemsPorPagina);
        }
    }

    private void PaginaAnterior() { if (PaginaActual > 1) PaginaActual--; }
    private void PaginaSiguiente() { if (PaginaActual < TotalPaginas) PaginaActual++; }
    private void IrAPagina(int pagina) { PaginaActual = pagina; }

    private void CerrarSesion()
    {
        AuthService.CerrarSesion();
        Navigation.NavigateTo("/");
    }
}

<style>
    /* Estilos Globales heredados de AdminTheme */
    @((MarkupString)FerreAppLaVarilla.UI.Services.AdminTheme.EstilosGlobales)

    /* Ajustes específicos para la Tabla de Productos */
    .table-toolbar { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 25px; gap: 20px; background: #f8fafc; padding: 15px; border-radius: 12px; border: 1px solid #e2e8f0; }
    .filters-group { display: flex; gap: 15px; }
    .filter-item label { display: block; font-size: 12px; font-weight: 700; color: #64748b; margin-bottom: 5px; }
    .admin-input-sm { padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 8px; outline: none; font-size: 13px; min-width: 150px; }
    .search-box .admin-input { min-width: 250px; }

    .table-img-container { width: 45px; height: 45px; background: white; border: 1px solid #e2e8f0; border-radius: 8px; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 2px; }
    .table-img-container img { max-width: 100%; max-height: 100%; object-fit: contain; }

    .badge.category { background: #e2e8f0; color: #475569; }
    
    .btn-icon-action { width: 35px; height: 35px; border-radius: 8px; border: 1px solid #e2e8f0; background: white; cursor: pointer; transition: 0.2s; display: inline-flex; align-items: center; justify-content: center; margin-left: 5px; }
    .btn-icon-action.edit:hover { background: #eff6ff; border-color: #3b82f6; }
    .btn-icon-action.delete:hover { background: #fef2f2; border-color: #ef4444; }

    /* Estilos Paginación */
    .pagination-container { display: flex; justify-content: space-between; align-items: center; margin-top: 25px; padding-top: 20px; border-top: 1px solid #e2e8f0; }
    .pagination-info { font-size: 13px; color: #64748b; font-weight: 500; }
    .pagination-controls { display: flex; gap: 5px; }
    .btn-page { padding: 8px 14px; border: 1px solid #e2e8f0; background: white; color: #475569; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 13px; transition: 0.2s; }
    .btn-page:hover:not(:disabled) { background: #f1f5f9; }
    .btn-page.active { background: #0b1527; color: white; border-color: #0b1527; }
    .btn-page:disabled { opacity: 0.5; cursor: not-allowed; }
    
    .empty-state { text-align: center; padding: 50px; color: #64748b; font-weight: 500; }
</style>