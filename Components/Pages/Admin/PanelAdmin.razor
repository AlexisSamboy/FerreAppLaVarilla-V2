@page "/panel-admin-home"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@using FerreAppLaVarilla.UI.Data
@using FerreAppLaVarilla.UI.Models

@attribute [Authorize(Roles = "Admin")]

@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService
@inject ApplicationDbContext _context

<PageTitle>Panel de Administración - FerreApp La Varilla</PageTitle>

@if (mostrarModalReporte)
{
    <div class="modal-overlay">
        <div class="premium-modal bounce-in">
            <div class="modal-header-flex">
                <h3>Descargar Reporte</h3>
                <button class="btn-close-minimal" @onclick="CerrarModalReporte">✕</button>
            </div>
            
            <div class="modal-content">
                <p style="color: #64748b; font-size: 14px; margin-bottom: 20px;">
                    Selecciona los datos y el formato que deseas exportar.
                </p>

                <label style="font-weight: 600; color: #0f172a; font-size: 14px;">Origen de datos:</label>
                <select class="custom-input" @bind="tablaReporte" style="margin-bottom: 15px; width: 100%;">
                    <option value="Pedidos">📊 Tabla de Pedidos</option>
                    <option value="Productos">📦 Inventario de Productos</option>
                    <option value="Clientes">👥 Directorio de Clientes</option>
                </select>

                <label style="font-weight: 600; color: #0f172a; font-size: 14px;">Formato de archivo:</label>
                <select class="custom-input" @bind="formatoReporte" style="width: 100%;">
                    <option value="Excel">🟩 Archivo Excel (.xlsx)</option>
                    <option value="CSV">📄 Archivo CSV (.csv)</option>
                </select>
            </div>

            <div class="modal-footer-flex mt-4">
                <button class="btn-action primary" style="width: 100%;" @onclick="ProcesarDescarga">
                    📥 Generar y Descargar
                </button>
            </div>
        </div>
    </div>
}

<div class="admin-layout">

    <aside class="sidebar @(menuOculto ? "oculto" : "")">
        <div class="logo">
            <div class="logo-icon">⚡</div>
            <div>
                <h2>FerreApp<span>LaVarilla</span></h2>
                <p>Panel de Administración</p>
            </div>
        </div>

        <nav class="menu">
            <NavLink class="menu-item" href="/panel-admin" Match="NavLinkMatch.All">
                <span class="menu-icon">📊</span> Dashboard
            </NavLink>
            <NavLink class="menu-item" href="/admin/pedidos">
                <span class="menu-icon">🛒</span> Pedidos
            </NavLink>
            <NavLink class="menu-item" href="/admin/gestionar-productos">
                <span class="menu-icon">📦</span> Productos
            </NavLink>
            <NavLink class="menu-item" href="/admin/clientes">
                <span class="menu-icon">👥</span> Clientes
            </NavLink>
            <NavLink class="menu-item" href="/admin/usuarios">
                <span class="menu-icon">👤</span> Usuarios
            </NavLink>
            <NavLink class="menu-item" href="/admin/despacho">
                <span class="menu-icon">🚚</span> Despacho
            </NavLink>
            <NavLink class="menu-item" href="/admin/configuracion">
                <span class="menu-icon">⚙️</span> Configuración
            </NavLink>
        </nav>

        <button class="logout-btn" @onclick="CerrarSesion">
            Cerrar Sesión
        </button>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div class="left-topbar">
                <div class="menu-toggle" @onclick="ToggleMenu">☰</div>
                <input type="text" placeholder="Buscar en el sistema..." class="search-box" />
            </div>

            <div class="right-topbar">
                <span class="notification">🔔</span>
                <div class="admin-user">
                    <div class="avatar">👤</div>
                    <div>
                        <strong>Administrador</strong>
                        <p style="margin: 0; font-size: 13px; color: #64748b;">admin@ferreapp.com</p>
                    </div>
                </div>
            </div>
        </header>

        <section class="welcome">
            <h1>¡Bienvenido, Administrador!</h1>
            <p>Aquí tienes un resumen general de tu tienda en tiempo real.</p>
        </section>

        <section class="stats-grid">
            <div class="stat-card">
                <h3>Pedidos Totales</h3>
                <h2>@totalPedidos</h2>
                <span>Actualizado hoy</span>
            </div>
            
            <div class="stat-card">
                <h3>Productos en Stock</h3>
                <h2>@totalProductos</h2>
                <span>En inventario</span>
            </div>
            
            <div class="stat-card">
                <h3>Clientes Registrados</h3>
                <h2>@totalClientes</h2>
                <span>En base de datos</span>
            </div>
            
            <div class="stat-card">
                <h3>Ventas Totales (Completadas)</h3>
                <h2 style="color: #0b3d91;">RD$ @ventasTotales.ToString("N2")</h2>
                <span>Ingresos reales</span>
            </div>
        </section>

        <section class="charts">
            <div class="chart-box large">
                <h3>Ventas de los últimos 7 días</h3>
                <div class="dynamic-bar-chart">
                    @if (datosVentas7Dias != null && datosVentas7Dias.Any())
                    {
                        @foreach (var dia in datosVentas7Dias)
                        {
                            var alturaPorcentaje = maxVenta7Dias > 0 ? (dia.Total / maxVenta7Dias) * 100 : 0;
                            <div class="bar-wrapper">
                                <div class="bar-tooltip">RD$ @dia.Total.ToString("N0")</div>
                                <div class="bar" style="height: @(alturaPorcentaje)%;"></div>
                                <span class="bar-label">@dia.Fecha.ToString("ddd")</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p style="text-align: center; color: #94a3b8; margin-top: 50px;">No hay datos suficientes.</p>
                    }
                </div>
            </div>
            
            <div class="chart-box">
                <h3>Estado de Pedidos</h3>
                <div class="status-list">
                    @foreach (var estado in desgloseEstados)
                    {
                        var porcentaje = totalPedidos > 0 ? ((decimal)estado.Cantidad / totalPedidos) * 100 : 0;
                        <div class="status-row">
                            <div class="status-info">
                                <strong>@estado.Estado.ToString()</strong>
                                <span>@estado.Cantidad pedidos</span>
                            </div>
                            <div class="progress-bg">
                                <div class="progress-fill @estado.Estado.ToString().ToLower()" style="width: @(porcentaje)%;"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <section class="tables">
            <div class="table-box">
                <h3>Últimos Pedidos</h3>
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Estado</th>
                            <th>Fecha</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (pedidosRecientes != null && pedidosRecientes.Any())
                        {
                            @foreach (var pedido in pedidosRecientes)
                            {
                                <tr>
                                    <td><strong>#PED-@pedido.Id</strong></td>
                                    <td>
                                        <span class="badge @pedido.Estado.ToString().ToLower()">@pedido.Estado</span>
                                    </td>
                                    <td>@pedido.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    <td style="font-weight: bold;">RD$ @pedido.Total.ToString("N2")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" style="text-align:center; color: #94a3b8;">No hay pedidos recientes</td></tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-box">
                <h3>Acciones Rápidas</h3>
                <div class="quick-actions-grid">
                    <button class="action-btn primary" @onclick='() => Navigation.NavigateTo("/admin/pedidos")'>
                        🛒 Ver todos los pedidos
                    </button>
                    <button class="action-btn warning" @onclick='() => Navigation.NavigateTo("/admin/agregar-producto")'>
                        ➕ Agregar Nuevo Producto
                    </button>
                    <button class="action-btn light" @onclick='() => Navigation.NavigateTo("/admin/clientes")'>
                        👥 Directorio de Clientes
                    </button>
                    <button class="action-btn success" @onclick="AbrirModalReporte">
                        📥 Descargar Reporte
                    </button>
                </div>
            </div>
        </section>

    </main>
</div>

@code {
    private bool menuOculto = true;
    private void ToggleMenu() => menuOculto = !menuOculto;

    private bool mostrarModalReporte = false;
    private string tablaReporte = "Pedidos";
    private string formatoReporte = "Excel";

    private void AbrirModalReporte() => mostrarModalReporte = true;
    private void CerrarModalReporte() => mostrarModalReporte = false;

    private void ProcesarDescarga()
    {
        Console.WriteLine($"Exportando {tablaReporte} en {formatoReporte}...");
        CerrarModalReporte();
    }

    private int totalPedidos = 0;
    private int totalProductos = 0;
    private int totalClientes = 0;
    private decimal ventasTotales = 0m;
    
    private List<Pedido> pedidosRecientes = new();
    private List<VentaDia> datosVentas7Dias = new();
    private List<EstadoDesglose> desgloseEstados = new();
    private decimal maxVenta7Dias = 1m;

    public class VentaDia { public DateTime Fecha { get; set; } public decimal Total { get; set; } }
    public class EstadoDesglose { public EstadoPedido Estado { get; set; } public int Cantidad { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            totalClientes = await _context.Usuarios.CountAsync(u => u.Rol == "Cliente");
            totalProductos = await _context.Productos.CountAsync();
            totalPedidos = await _context.Pedidos.CountAsync();
            
            ventasTotales = await _context.Pedidos
                .Where(p => p.Estado != EstadoPedido.Cancelado)
                .SumAsync(p => p.Total);

            pedidosRecientes = await _context.Pedidos
                .OrderByDescending(p => p.FechaCreacion)
                .Take(4)
                .ToListAsync();

            var fechaInicio = DateTime.Today.AddDays(-6);
            var pedidosUltimaSemana = await _context.Pedidos
                .Where(p => p.FechaCreacion >= fechaInicio && p.Estado != EstadoPedido.Cancelado)
                .ToListAsync();

            for (int i = 6; i >= 0; i--)
            {
                var dia = DateTime.Today.AddDays(-i);
                var totalDia = pedidosUltimaSemana.Where(p => p.FechaCreacion.Date == dia).Sum(p => p.Total);
                datosVentas7Dias.Add(new VentaDia { Fecha = dia, Total = totalDia });
            }
            
            maxVenta7Dias = datosVentas7Dias.Any() ? datosVentas7Dias.Max(v => v.Total) : 0;
            if (maxVenta7Dias == 0) maxVenta7Dias = 1;

            desgloseEstados = await _context.Pedidos
                .GroupBy(p => p.Estado)
                .Select(g => new EstadoDesglose { Estado = g.Key, Cantidad = g.Count() })
                .OrderByDescending(e => e.Cantidad)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error SQL en Dashboard: {ex.Message}");
        }
    }

    private void CerrarSesion()
    {
        AuthService.CerrarSesion();
        Navigation.NavigateTo("/");
    }
}

<style>
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: "Segoe UI", system-ui, sans-serif; }
    body { background: #f5f7fa; }
    
    .admin-layout { display: flex; min-height: 100vh; overflow-x: hidden; }

    .sidebar { 
        width: 280px; 
        min-width: 280px; 
        background: #0b1527; 
        color: white; 
        padding: 30px 20px; 
        display: flex; 
        flex-direction: column; 
        position: sticky; 
        top: 0; 
        height: 100vh; 
        transition: margin-left 0.4s cubic-bezier(0.4, 0, 0.2, 1); 
    }

    .sidebar.oculto { margin-left: -280px; }

    .logo { display: flex; gap: 15px; align-items: center; margin-bottom: 40px; }
    
    .logo-icon { 
        background: #f59e0b; 
        width: 55px; 
        height: 55px; 
        border-radius: 14px; 
        font-size: 28px; 
        display: flex; 
        align-items: center; 
        justify-content: center;
        box-shadow: 0 4px 10px rgba(245, 158, 11, 0.3);
    }
    
    .logo h2 { font-size: 24px; margin: 0; color: white; font-weight: 800; line-height: 1.2; }
    .logo span { font-size: 11px; color: #f59e0b; letter-spacing: 2px; text-transform: uppercase; display: block; }

    .menu { display: flex; flex-direction: column; gap: 8px; flex-grow: 1; }
    
    .menu-item { display: flex; align-items: center; gap: 15px; padding: 14px 20px; color: #94a3b8 !important; text-decoration: none !important; border-radius: 14px; transition: 0.3s; font-size: 15px !important; font-weight: 500; position: relative; }
    .menu-item:hover { color: white !important; background: rgba(255,255,255,0.05); }
    .menu-item.active { background: rgba(245, 158, 11, 0.1) !important; color: #f59e0b !important; font-weight: 700; }
    .menu-item.active::before { content: ""; position: absolute; left: 0; width: 4px; height: 50%; background: #f59e0b; border-radius: 0 4px 4px 0; }

    .logout-btn { 
        margin-top: auto; 
        background: rgba(239, 68, 68, 0.1); 
        border: 1px solid rgba(239, 68, 68, 0.3); 
        color: #fca5a5; 
        padding: 14px; 
        border-radius: 12px; 
        cursor: pointer; 
        font-weight: bold; 
        transition: 0.3s; 
    }
    .logout-btn:hover { background: #ef4444; border-color: #ef4444; color: white; box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4); }

    .main-content { flex: 1; padding: 35px 45px; background: #fafbfd; overflow-y: auto; transition: width 0.4s; }
    
    .topbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 40px; }
    .left-topbar { display: flex; align-items: center; gap: 20px; }
    .menu-toggle { font-size: 24px; cursor: pointer; color: #0d1b2a; padding: 5px; border-radius: 8px; transition: 0.2s; }
    .menu-toggle:hover { background: #e2e8f0; }
    .search-box { width: 400px; padding: 12px 18px; border: 1px solid #e2e8f0; border-radius: 12px; outline: none; background: white; font-size: 14px; }
    
    .right-topbar { display: flex; align-items: center; gap: 25px; }
    .notification { font-size: 22px; cursor: pointer; }
    .admin-user { display: flex; align-items: center; gap: 15px; }
    .avatar { width: 42px; height: 42px; background: #e2e8f0; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 18px; }

    .welcome { margin-bottom: 35px; }
    .welcome h1 { font-size: 32px; color: #0f172a; font-weight: 800; }
    .welcome p { color: #64748b; margin-top: 5px; font-size: 15px; }

    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 25px; margin-bottom: 35px; }
    .stat-card { background: white; padding: 25px; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.02); border: 1px solid #f8fafc; }
    .stat-card h3 { color: #64748b; margin-bottom: 12px; font-size: 14px; text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-card h2 { font-size: 32px; margin-bottom: 8px; color: #0f172a; font-weight: 800; }
    .stat-card span { color: #10b981; font-size: 13px; font-weight: 600; }

    /* CHARTS DYNAMICS ACOTADOS */
    .charts { display: grid; grid-template-columns: 2fr 1fr; gap: 25px; margin-bottom: 35px; }
    .chart-box { background: white; padding: 30px; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.02); border: 1px solid #f8fafc; min-height: 250px; }
    .chart-box h3 { color: #0f172a; font-size: 18px; margin-bottom: 25px; font-weight: 700; }
    
    /* REDUCCIÓN DE TAMAÑO DE LA GRÁFICA AQUÍ */
    .dynamic-bar-chart { display: flex; align-items: flex-end; justify-content: space-between; height: 150px; padding-top: 15px; margin-top: 10px; }
    .bar-wrapper { display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; width: 10%; position: relative; }
    .bar { width: 100%; background: linear-gradient(to top, #3b82f6, #60a5fa); border-radius: 6px 6px 0 0; transition: 0.5s all ease; min-height: 5px; }
    .bar:hover { background: linear-gradient(to top, #2563eb, #3b82f6); cursor: pointer; }
    .bar-label { margin-top: 12px; font-size: 12px; color: #64748b; text-transform: uppercase; font-weight: 600; }
    .bar-tooltip { position: absolute; top: -30px; background: #0f172a; color: white; padding: 4px 8px; border-radius: 6px; font-size: 11px; opacity: 0; transition: 0.2s; white-space: nowrap; pointer-events: none; }
    .bar-wrapper:hover .bar-tooltip { opacity: 1; transform: translateY(-5px); }

    .status-list { display: flex; flex-direction: column; gap: 20px; }
    .status-row { width: 100%; }
    .status-info { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 14px; }
    .status-info strong { color: #0f172a; }
    .status-info span { color: #64748b; font-weight: 600; }
    .progress-bg { width: 100%; height: 8px; background: #f1f5f9; border-radius: 10px; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: 10px; transition: 1s width ease-out; }
    
    .progress-fill.completado, .progress-fill.entregado { background: #10b981; }
    .progress-fill.pendiente { background: #f59e0b; }
    .progress-fill.enruta { background: #3b82f6; }
    .progress-fill.cancelado { background: #ef4444; }

    .tables { display: grid; grid-template-columns: 2fr 1fr; gap: 25px; }
    .table-box { background: white; padding: 30px; border-radius: 20px; box-shadow: 0 10px 25px rgba(0,0,0,0.02); border: 1px solid #f8fafc; }
    .table-box h3 { color: #0f172a; font-size: 18px; margin-bottom: 20px; font-weight: 700; }
    
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 16px 12px; border-bottom: 1px solid #f1f5f9; color: #334155; font-size: 14px; }
    th { color: #64748b; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    
    .badge { padding: 6px 12px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; }
    .badge.entregado, .badge.completado { background: #dcfce7; color: #166534; }
    .badge.pendiente { background: #fef3c7; color: #b45309; }
    .badge.enruta { background: #dbeafe; color: #1e40af; }
    .badge.cancelado { background: #fee2e2; color: #991b1b; }

    .quick-actions-grid { display: flex; flex-direction: column; gap: 15px; }
    .action-btn { width: 100%; padding: 16px; border-radius: 14px; border: none; font-size: 14px; font-weight: 700; cursor: pointer; transition: 0.3s; text-align: left; padding-left: 25px; }
    .action-btn.primary { background: #0b1527; color: white; }
    .action-btn.primary:hover { background: #1e293b; }
    .action-btn.warning { background: #f59e0b; color: #0f172a; }
    .action-btn.warning:hover { background: #d97706; color: white; }
    .action-btn.light { background: white; border: 2px solid #e2e8f0; color: #0f172a; }
    .action-btn.light:hover { background: #f8fafc; border-color: #cbd5e1; }
    
    .action-btn.success { background: #10b981; color: white; box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2); }
    .action-btn.success:hover { background: #059669; }

    .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(11, 21, 39, 0.7); display: flex; align-items: center; justify-content: center; z-index: 2000; backdrop-filter: blur(4px); }
    .premium-modal { background: white; padding: 30px; border-radius: 24px; width: 450px; box-shadow: 0 25px 50px rgba(0,0,0,0.2); }
    .modal-header-flex { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
    .modal-header-flex h3 { margin: 0; font-size: 20px; color: #0b1527; font-weight: 800;}
    .btn-close-minimal { background: none; border: none; font-size: 20px; cursor: pointer; color: #64748b; transition: 0.2s; }
    .btn-close-minimal:hover { color: #ef4444; }
    .custom-input { padding: 14px 16px; border: 1px solid #e2e8f0; border-radius: 12px; outline: none; font-size: 15px; background: #f8fafc; transition: 0.3s; margin-top: 8px; }
    .custom-input:focus { border-color: #3b82f6; background: white; box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1); }
    .btn-action.primary { background: #0b1527; color: white; border: none; padding: 16px; border-radius: 12px; font-weight: 700; cursor: pointer; transition: 0.3s; font-size: 15px; }
    .btn-action.primary:hover { background: #f59e0b; color: #0b1527; }
    
    .bounce-in { animation: bounceIn 0.3s ease-out; }
    @@keyframes bounceIn { 0% { transform: scale(0.9); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
</style>