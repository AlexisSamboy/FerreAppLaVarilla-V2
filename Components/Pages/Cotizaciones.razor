@page "/cotizaciones"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Data
@using FerreAppLaVarilla.UI.Services

@attribute [Authorize(Roles = "Admin,Cajero")]

@inject ApplicationDbContext _context
@inject NavigationManager Navigation
@inject PdfService PdfService
@inject IJSRuntime JS

<PageTitle>Cotizaciones - FerreApp</PageTitle>

<div class="business-layout">

    <aside class="sidebar">
        <div class="logo-section">
            <div class="logo-icon">⚡</div>
            <div>
                <h1>FerreApp</h1>
                <span>La Varilla</span>
            </div>
        </div>
 <nav class="sidebar-menu">
            <NavLink class="menu-item" href="PuntoDeVenta" Match="NavLinkMatch.All">
                🛒 Punto de Venta
            </NavLink>
            <NavLink class="menu-item" href="cotizaciones">
                📄 Cotizaciones
            </NavLink>
            <NavLink class="menu-item" href="Clientes">
                👥 Clientes
            </NavLink>
            <NavLink class="menu-item" href="Productos">
                📦 Productos
            </NavLink>
            <NavLink class="menu-item" href="Inventario">
                📊 Inventario
            </NavLink>
            <NavLink class="menu-item" href="Reportes">
                📈 Reportes
            </NavLink>
            <NavLink class="menu-item" href="facturas">
                🧾 Facturas
            </NavLink>
        </nav>
    </aside>

    <main class="main-content">

        <header class="topbar">
            <div>
                <h2>Gestión de Cotizaciones</h2>
                <p>Administración y conversión de cotizaciones</p>
            </div>
            
            <div class="topbar-right">
                <button class="new-btn" @onclick='() => Navigation.NavigateTo("/PuntoDeVenta")'>
    ➕ Nueva Cotización
</button>
            </div>
        </header>

        <div class="filters">
            <input type="text"
                   placeholder="🔍 Buscar cliente..."
                   @bind="textoBusqueda"
                   @bind:event="oninput" />
        </div>

        <section class="table-section">
            <div class="table-container">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th># Cotización</th>
                            <th>Cliente</th>
                            <th>Fecha</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (cotizaciones == null)
                        {
                            <tr>
                                <td colspan="6" class="text-center" style="padding: 40px;">Cargando...</td>
                            </tr>
                        }
                        else if (!CotizacionesFiltradas().Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center" style="padding: 40px;">No hay cotizaciones registradas.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var cot in CotizacionesFiltradas())
                            {
                                <tr>
                                    <td><strong>COT-@cot.Id.ToString("D4")</strong></td>
                                    <td>@cot.Cliente?.NombreCompleto</td>
                                    <td>@cot.FechaCreacion.ToString("dd/MM/yyyy")</td>
                                    
                                    @{
                                        var subtotal = cot.Articulos?.Sum(x => x.PrecioUnitario * x.Cantidad) ?? 0;
                                        var totalConItbis = subtotal + (subtotal * 0.18m);
                                    }
                                    
                                    <td><strong>RD$ @totalConItbis.ToString("N2")</strong></td>
                                    
                                    <td>
                                        <span class="estado-pill @(cot.Estado == EstadoPedido.Completado ? "estado-completado" : "estado-pendiente")">
                                            @cot.Estado
                                        </span>
                                    </td>
                                    
                                    <td class="text-center action-cell">
                                        <button class="action-btn view" title="Ver Detalle" @onclick="() => VerDetalle(cot)">
                                            👁
                                        </button>
                                        <button class="action-btn convert" title="Convertir a Factura" @onclick="() => ConvertirAFactura(cot)">
                                            🧾
                                        </button>
                                        <button class="action-btn delete" title="Eliminar" @onclick="() => EliminarCotizacion(cot.Id)">
                                            🗑
                                        </button>
                                        
                                        <button class="action-btn print" title="Imprimir PDF" @onclick="() => GenerarYAbrirCotizacionPdf(cot)">
                                            📄
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

@if (mostrarModal)
{
    <div class="modal-overlay">
        <div class="cot-modal">
            <div class="modal-header">
                <h2>Nueva Cotización Rápida</h2>
                <button class="close-btn" @onclick="CerrarModal">✖</button>
            </div>

            <div class="modal-body">
                <div class="input-group">
                    <label>Cliente</label>
                    <input type="text" @bind="clienteNombre" placeholder="Nombre cliente" />
                </div>
                <div class="input-group">
                    <label>Teléfono</label>
                    <input type="text" @bind="clienteTelefono" placeholder="809..." />
                </div>
                <div class="input-group">
                    <label>Dirección</label>
                    <textarea @bind="clienteDireccion" placeholder="Ciudad, Provincia..."></textarea>
                </div>
                <div class="input-group">
                    <label>Notas</label>
                    <textarea @bind="notasCotizacion" placeholder="Información adicional..."></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button class="cancel-btn" @onclick="CerrarModal">Cancelar</button>
                <button class="save-btn" @onclick="GuardarCotizacion">💾 Generar Base</button>
            </div>
        </div>
    </div>
}

@code {
    private List<Pedido> cotizaciones = new();
    private bool mostrarModal = false;
    private string textoBusqueda = "";
    private string clienteNombre = "";
    private string clienteTelefono = "";
    private string clienteDireccion = "";
    private string notasCotizacion = "";

    protected override async Task OnInitializedAsync()
    {
        await CargarCotizaciones();
    }

    private async Task CargarCotizaciones()
    {
        cotizaciones = await _context.Pedidos
            .Include(x => x.Cliente)
            .Include(x => x.Articulos)
                .ThenInclude(a => a.Producto)
            .Where(x => x.TipoDocumento == "Cotizacion")
            .OrderByDescending(x => x.Id)
            .ToListAsync();
    }

    private IEnumerable<Pedido> CotizacionesFiltradas()
    {
        if (string.IsNullOrWhiteSpace(textoBusqueda))
            return cotizaciones;

        return cotizaciones.Where(x =>
            x.Cliente != null &&
            x.Cliente.NombreCompleto.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));
    }

    private void AbrirModalNueva() => mostrarModal = true;

    private void CerrarModal()
    {
        mostrarModal = false;
        LimpiarCampos();
    }

    private void LimpiarCampos()
    {
        clienteNombre = "";
        clienteTelefono = "";
        clienteDireccion = "";
        notasCotizacion = "";
    }

    private async Task GuardarCotizacion()
    {
        try
        {
            var clienteDB = new Cliente
            {
                NombreCompleto = string.IsNullOrWhiteSpace(clienteNombre) ? "Cliente General" : clienteNombre,
                CedulaRNC = "N/A",
                Telefono = string.IsNullOrWhiteSpace(clienteTelefono) ? "N/A" : clienteTelefono,
                DireccionEntrega = string.IsNullOrWhiteSpace(clienteDireccion) ? "N/A" : clienteDireccion
            };

            _context.Clientes.Add(clienteDB);
            await _context.SaveChangesAsync();

            var nuevaCotizacion = new Pedido
            {
                FechaCreacion = DateTime.Now,
                ClienteId = clienteDB.Id,
                Estado = EstadoPedido.Pendiente,
                TipoDocumento = "Cotizacion",
                RequiereDelivery = false,
                Articulos = new List<DetallePedido>()
            };

            _context.Pedidos.Add(nuevaCotizacion);
            await _context.SaveChangesAsync();

            await CargarCotizaciones();
            CerrarModal();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void VerDetalle(Pedido cot)
    {
        Navigation.NavigateTo($"/cotizacion-detalle/{cot.Id}");
    }

    private async Task ConvertirAFactura(Pedido cot)
    {
        cot.TipoDocumento = "Factura";
        cot.Estado = EstadoPedido.Completado;
        
        _context.Pedidos.Update(cot);
        await _context.SaveChangesAsync();
        await CargarCotizaciones();
    }

    private async Task EliminarCotizacion(int id)
    {
        var cot = await _context.Pedidos.FindAsync(id);
        if (cot != null)
        {
            _context.Pedidos.Remove(cot);
            await _context.SaveChangesAsync();
            await CargarCotizaciones();
        }
    }

    // MÉTODO PARA GENERAR EL PDF
    private async Task GenerarYAbrirCotizacionPdf(Pedido cotizacionDb)
    {
        try
        {
            var subtotal = cotizacionDb.Articulos?.Sum(a => a.PrecioUnitario * a.Cantidad) ?? 0;
            var itbis = subtotal * 0.18m;

            var modeloCotizacionPdf = new Factura
            {
                NumeroFactura = $"COT-{cotizacionDb.Id:D6}", 
                Cliente = cotizacionDb.Cliente?.NombreCompleto ?? "Cliente General",
                CedulaRnc = cotizacionDb.Cliente?.CedulaRNC ?? "N/A",
                Fecha = cotizacionDb.FechaCreacion,
                Subtotal = subtotal,
                Itbis = itbis,
                Detalles = cotizacionDb.Articulos?.Select(a => new DetalleFactura
                {
                    Producto = a.Producto?.Nombre ?? "Producto Desconocido",
                    Cantidad = a.Cantidad,
                    Precio = a.PrecioUnitario,
                    Subtotal = a.PrecioUnitario * a.Cantidad
                }).ToList() ?? new List<DetalleFactura>()
            };

            var pdfBytes = PdfService.GenerarCotizacionPdf(modeloCotizacionPdf);
            var base64 = Convert.ToBase64String(pdfBytes);

            await JS.InvokeVoidAsync("abrirPdfEnPestana", base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar Cotización PDF: {ex.Message}");
        }
    }
}

