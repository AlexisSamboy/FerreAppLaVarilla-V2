@page "/registro"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext _context
@inject NavigationManager Navigation

<PageTitle>Crear Cuenta - FerreApp La Varilla</PageTitle>

<div class="main-auth-container">
    <div class="glass-card">
        
        <div class="auth-sidebar">
            <div class="auth-sidebar-content">
                <div class="brand-zone">
                    <div class="logo-bolt">⚡</div>
                    <div class="brand-names">
                        <h1>FerreApp</h1>
                        <h2>LaVarilla</h2>
                    </div>
                </div>
                
                <p class="tagline">FERRETERÍA • CONSTRUCCIÓN • HOGAR</p>
                <div class="yellow-line"></div>
                
                <p class="auth-description">
                    Crea tu cuenta y accede a nuestro catálogo, realiza compras, gestiona tus pedidos y mucho más.
                </p>

                <div class="warehouse-illustration">
                    <img src="/images/pasillos.png" alt="Ferreteria">
                </div>

                <div class="features-footer">
                    <div class="feature">
                        <span>🛡️</span>
                        <p>Compra<br>segura</p>
                    </div>
                    <div class="feature">
                        <span>📦</span>
                        <p>Amplio<br>inventario</p>
                    </div>
                    <div class="feature">
                        <span>🎧</span>
                        <p>Soporte<br>dedicado</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="auth-form-section">
            <div class="form-container">
                <div class="form-header">
                    <h2>Crear Cuenta</h2>
                    <p>Regístrate como nuevo cliente</p>
                </div>

                <EditForm Model="@modelo" OnValidSubmit="ProcesarRegistro">
                    <DataAnnotationsValidator />

                    @if (!string.IsNullOrEmpty(mensajeError))
                    {
                        <div class="alert error">@mensajeError</div>
                    }

                    <div class="inputs-grid">
                        <div class="input-box">
                            <label>Nombre completo</label>
                            <div class="field">
                                <span class="input-icon">👤</span>
                                <InputText @bind-Value="modelo.NombreCompleto" placeholder="Ingresa tu nombre completo" />
                            </div>
                            <ValidationMessage For="@(() => modelo.NombreCompleto)" class="validation-msg" />
                        </div>

                        <div class="input-box">
                            <label>Cédula / RNC</label>
                            <div class="field">
                                <span class="input-icon">🪪</span>
                                <InputText @bind-Value="modelo.CedulaRNC" placeholder="Ingresa tu cédula o RNC" />
                            </div>
                            <ValidationMessage For="@(() => modelo.CedulaRNC)" class="validation-msg" />
                        </div>

                        <div class="input-box">
                            <label>Correo electrónico</label>
                            <div class="field">
                                <span class="input-icon">✉️</span>
                                <InputText @bind-Value="modelo.Correo" placeholder="Ingresa tu correo electrónico" />
                            </div>
                            <ValidationMessage For="@(() => modelo.Correo)" class="validation-msg" />
                        </div>

                        <div class="input-box">
                            <label>Número de teléfono</label>
                            <div class="field">
                                <span class="input-icon">📞</span>
                                <InputText @bind-Value="modelo.Telefono" placeholder="Ingresa tu número de teléfono" />
                            </div>
                            <ValidationMessage For="@(() => modelo.Telefono)" class="validation-msg" />
                        </div>

                        <div class="input-box full-width">
                            <label>Dirección</label>
                            <div class="field">
                                <span class="input-icon">📍</span>
                                <InputText @bind-Value="modelo.Direccion" placeholder="Ingresa tu dirección completa" />
                            </div>
                            <ValidationMessage For="@(() => modelo.Direccion)" class="validation-msg" />
                        </div>

                        <div class="input-box">
                            <label>Contraseña</label>
                            <div class="field">
                                <span class="input-icon">🔒</span>
                                <InputText @bind-Value="modelo.Password" type="password" placeholder="Crea una contraseña" />
                            </div>
                            <ValidationMessage For="@(() => modelo.Password)" class="validation-msg" />
                        </div>

                        <div class="input-box">
                            <label>Confirmar contraseña</label>
                            <div class="field">
                                <span class="input-icon">🔒</span>
                                <InputText @bind-Value="modelo.ConfirmPassword" type="password" placeholder="Confirma tu contraseña" />
                            </div>
                            <ValidationMessage For="@(() => modelo.ConfirmPassword)" class="validation-msg" />
                        </div>
                    </div>

                    <div class="terms">
                        <InputCheckbox @bind-Value="modelo.AceptaTerminos" id="terms" />
                        <label for="terms">Acepto los <a href="#">términos y condiciones</a> y la <a href="#">política de privacidad</a></label>
                    </div>
                    
                    @if (mostrarAlertaTerminos)
                    {
                        <p class="validation-msg" style="margin-top: -10px; margin-bottom: 10px;">Debes aceptar los términos para continuar.</p>
                    }

                    <button type="submit" class="btn-register" disabled="@cargando">
                        @(cargando ? "Procesando..." : "👤 Crear Cuenta")
                    </button>

                    <div class="login-link">
                        <p>¿Ya tienes una cuenta?</p>
                        <button type="button" class="btn-login-outline" @onclick='() => Navigation.NavigateTo("/login")'>
                            ➡️ Iniciar Sesión
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private RegistroViewModel modelo = new();
    private bool cargando = false;
    private string? mensajeError;
    private bool mostrarAlertaTerminos = false;

    public class RegistroViewModel
    {
        [Required(ErrorMessage = "Requerido")] 
        public string NombreCompleto { get; set; } = "";
        
        [Required(ErrorMessage = "Requerido")] 
        public string CedulaRNC { get; set; } = "";
        
        [Required(ErrorMessage = "Requerido")] 
        [EmailAddress(ErrorMessage = "Correo inválido")] 
        public string Correo { get; set; } = "";
        
        [Required(ErrorMessage = "Requerido")] 
        public string Telefono { get; set; } = "";
        
        [Required(ErrorMessage = "Requerido")] 
        public string Direccion { get; set; } = "";
        
        [Required(ErrorMessage = "Requerido")] 
        [MinLength(6, ErrorMessage = "Mín. 6 caracteres")]
        public string Password { get; set; } = "";
        
        [Required(ErrorMessage = "Requerido")] 
        [Compare("Password", ErrorMessage = "No coinciden")] 
        public string ConfirmPassword { get; set; } = "";
        
        public bool AceptaTerminos { get; set; }
    }

    private async Task ProcesarRegistro()
    {
        if (!modelo.AceptaTerminos)
        {
            mostrarAlertaTerminos = true;
            return;
        }

        mostrarAlertaTerminos = false;
        cargando = true;
        mensajeError = null;

        try
        {
            // 1. Verificar si el correo ya existe
            var existeUsuario = await _context.Usuarios.AnyAsync(u => u.CorreoElectronico == modelo.Correo);
            if (existeUsuario)
            {
                mensajeError = "Ya existe una cuenta con este correo electrónico.";
                cargando = false;
                return;
            }

            // 2. Guardar Usuario (Para el Login)
            var user = new Usuario
            {
                NombreCompleto = modelo.NombreCompleto,
                CorreoElectronico = modelo.Correo,
                Password = modelo.Password,
                Rol = "Cliente"
            };
            _context.Usuarios.Add(user);

            // 3. Guardar Cliente (Para Facturación)
            var cliente = new Cliente
            {
                NombreCompleto = modelo.NombreCompleto,
                CedulaRNC = modelo.CedulaRNC,
                Telefono = modelo.Telefono,
                DireccionEntrega = modelo.Direccion,
                CorreoElectronico = modelo.Correo // Esta propiedad ya la agregaste a tu modelo
            };
            _context.Clientes.Add(cliente);

            // Guardamos ambos
            await _context.SaveChangesAsync();
            
            // Redirigimos
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            mensajeError = "Error al crear la cuenta. Intente de nuevo.";
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }
}

<style>
    /* ==============================================
       SUPERPOSICIÓN TOTAL (Tapa el MainLayout default)
    ============================================== */
    .main-auth-container {
        position: fixed;
        top: 0; left: 0; width: 100vw; height: 100vh;
        background: radial-gradient(circle at center, #1e3a8a 0%, #0f172a 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        font-family: 'Segoe UI', system-ui, sans-serif;
    }

    /* LA TARJETA CON EFECTO GLASS */
    .glass-card {
        width: 1100px;
        height: 700px;
        background: rgba(255, 255, 255, 0.98);
        border-radius: 30px;
        display: flex;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    /* PANEL IZQUIERDO (AZUL) */
    .auth-sidebar {
        flex: 1;
        background: #021b46;
        color: white;
        padding: 50px;
        position: relative;
        display: flex;
        flex-direction: column;
    }
    
    .auth-sidebar-content {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .brand-zone { display: flex; align-items: center; gap: 15px; margin-bottom: 20px; }
    .logo-bolt {
        font-size: 40px; background: #fbce07; color: #021b46;
        width: 60px; height: 60px; border-radius: 15px;
        display: flex; align-items: center; justify-content: center;
    }
    .brand-names h1 { margin: 0; font-size: 36px; font-weight: 800; line-height: 1; color: white; }
    .brand-names h2 { margin: 0; font-size: 24px; color: #fbce07; font-weight: 400; }

    .tagline { font-size: 11px; letter-spacing: 2px; color: #94a3b8; margin: 10px 0; }
    .yellow-line { width: 60px; height: 4px; background: #fbce07; margin-bottom: 25px; }
    .auth-description { font-size: 14px; line-height: 1.6; color: #cbd5e1; margin-bottom: 25px; }

    .warehouse-illustration {
        flex: 1; opacity: 0.2;
        background: #000;
        border-radius: 20px; overflow: hidden;
    }
    .warehouse-illustration img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%); }

    .features-footer { display: flex; justify-content: space-between; margin-top: 25px; }
    .feature { text-align: center; }
    .feature span { font-size: 24px; display: block; margin-bottom: 5px; }
    .feature p { font-size: 12px; color: #94a3b8; line-height: 1.2; margin: 0;}

    /* PANEL DERECHO (BLANCO) */
    .auth-form-section { flex: 1.5; padding: 40px 50px; display: flex; align-items: center; }
    .form-container { width: 100%; }
    .form-header { text-align: center; margin-bottom: 30px; }
    .form-header h2 { font-size: 32px; font-weight: 800; color: #0f172a; margin: 0 0 5px 0; }
    .form-header p { color: #64748b; font-size: 15px; margin: 0;}

    .inputs-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px 20px;
    }
    .full-width { grid-column: span 2; }

    .input-box label { display: block; font-size: 13px; font-weight: 600; color: #1e293b; margin-bottom: 6px; }
    .field {
        position: relative;
        display: flex;
        align-items: center;
    }
    
    .input-icon { position: absolute; left: 15px; font-size: 16px; color: #94a3b8; }
    
    .field input {
        width: 100%; padding: 12px 15px 12px 42px;
        border: 1px solid #e2e8f0; border-radius: 10px;
        background: #f8fafc; font-size: 14px; outline: none; transition: 0.3s;
        color: #334155;
    }
    .field input:focus { border-color: #1e3a8a; box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.1); background: white;}

    .validation-msg { color: #dc2626; font-size: 12px; margin-top: 4px; display: block; }
    .alert.error { background: #fef2f2; color: #dc2626; padding: 10px; border-radius: 8px; margin-bottom: 20px; font-size: 14px; border: 1px solid #fecaca; text-align:center;}

    .terms { margin: 20px 0; display: flex; align-items: center; gap: 10px; font-size: 13px; color: #64748b; }
    .terms input { width: 16px; height: 16px; cursor: pointer;}
    .terms a { color: #2563eb; text-decoration: none; font-weight: 600; }

    .btn-register {
        width: 100%; background: #021b46; color: white; border: none;
        padding: 14px; border-radius: 10px; font-weight: 700; font-size: 15px;
        cursor: pointer; transition: 0.2s; margin-bottom: 20px;
    }
    .btn-register:hover { background: #052c6d; transform: translateY(-2px); }
    .btn-register:disabled { opacity: 0.7; cursor: not-allowed; transform: none;}

    .login-link { text-align: center; border-top: 1px solid #e2e8f0; padding-top: 20px; }
    .login-link p { font-size: 14px; color: #64748b; margin-bottom: 15px; }
    .btn-login-outline {
        width: 100%; background: white; color: #021b46; border: 1px solid #021b46;
        padding: 12px; border-radius: 10px; font-weight: 600; cursor: pointer; transition: 0.2s;
    }
    .btn-login-outline:hover { background: #f1f5f9; }

    /* RESPONSIVE */
    @@media(max-width: 1150px) {
        .glass-card { width: 95%; height: auto; min-height: 90vh; }
    }
    @@media(max-width: 900px) {
        .auth-sidebar { display: none; }
        .glass-card { width: 90%; max-width: 500px; min-height: auto; }
        .inputs-grid { grid-template-columns: 1fr; }
        .full-width { grid-column: 1; }
        .auth-form-section { padding: 30px; }
    }
</style>