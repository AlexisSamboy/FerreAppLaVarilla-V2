@page "/facturas"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore
@using FerreAppLaVarilla.UI.Models
@using FerreAppLaVarilla.UI.Data
@using FerreAppLaVarilla.UI.Services

@inject ApplicationDbContext _context
@inject PdfService PdfService
@inject IJSRuntime JS

<PageTitle>Historial de Facturas - FerreApp</PageTitle>

<div class="business-layout">

    <aside class="sidebar">
        <div class="logo-section">
            <div class="logo-icon">⚡</div>
            <div>
                <h1>FerreApp</h1>
                <span>La Varilla</span>
            </div>
        </div>

        <nav class="sidebar-menu">
            <NavLink class="menu-item" href="PuntoDeVenta">
                🛒 Punto de Venta
            </NavLink>
            <NavLink class="menu-item" href="cotizaciones">
                📄 Cotizaciones
            </NavLink>
            <NavLink class="menu-item" href="Clientes">
                👥 Clientes
            </NavLink>
            <NavLink class="menu-item" href="Productos">
                📦 Productos
            </NavLink>
            <NavLink class="menu-item" href="Inventario">
                📊 Inventario
            </NavLink>
            <NavLink class="menu-item" href="Reportes">
                📈 Reportes
            </NavLink>
            <NavLink class="menu-item active" href="facturas">
                🧾 Facturas
            </NavLink>
        </nav>
    </aside>

    <main class="main-content">
        
        <header class="topbar">
            <div>
                <h2>Historial de Facturas</h2>
                <p>Registro de todas las ventas procesadas en el sistema</p>
            </div>
            
            <div class="topbar-right">
                <div class="info-box">
                    <small>Hora Actual</small>
                    <strong>@DateTime.Now.ToString("hh:mm tt")</strong>
                </div>
                <div class="user-box">
                    <div class="avatar">👨</div>
                    <div>
                        <strong>Administrador</strong>
                        <p>Gestión</p>
                    </div>
                </div>
            </div>
        </header>

        <section class="table-section">
            <div class="table-container">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>N° Factura</th>
                            <th>Cliente</th>
                            <th>Fecha y Hora</th>
                            <th>Total</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (listaFacturas == null)
                        {
                            <tr>
                                <td colspan="5" class="text-center" style="padding: 40px;">
                                    Cargando facturas...
                                </td>
                            </tr>
                        }
                        else if (!listaFacturas.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center" style="padding: 40px;">
                                    No hay facturas registradas en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var pedido in listaFacturas)
                            {
                                <tr>
                                    <td><strong>FAC-@pedido.Id.ToString("D4")</strong></td>
                                    <td>@(pedido.Cliente?.NombreCompleto ?? "Cliente General")</td>
                                    <td>@pedido.FechaCreacion.ToString("dd/MM/yyyy • hh:mm tt")</td>
                                    
                                    @{
                                        var totalVenta = pedido.Articulos?.Sum(a => a.PrecioUnitario * a.Cantidad) ?? 0;
                                        var totalConItbis = totalVenta + (totalVenta * 0.18m);
                                    }
                                    
                                    <td><strong class="text-success">RD$ @totalConItbis.ToString("N2")</strong></td>
                                    <td class="text-center">
                                        <button class="pdf-btn" @onclick="() => GenerarYAbrirPdf(pedido)">
                                            📄 Ver PDF
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

    </main>
</div>

@code {
    private List<Pedido>? listaFacturas;

    protected override async Task OnInitializedAsync()
    {
        listaFacturas = await _context.Pedidos
            .Include(p => p.Cliente)
            .Include(p => p.Articulos)
                .ThenInclude(a => a.Producto)
            .Where(p => p.TipoDocumento == "Factura")
            .OrderByDescending(p => p.Id)
            .ToListAsync();
    }

    private async Task GenerarYAbrirPdf(Pedido pedidoDb)
    {
        try
        {
            var subtotal = pedidoDb.Articulos?.Sum(a => a.PrecioUnitario * a.Cantidad) ?? 0;
            var itbis = subtotal * 0.18m;

            var modeloFacturaPdf = new Factura
            {
                NumeroFactura = $"FAC-{pedidoDb.Id:D4}",
                Cliente = pedidoDb.Cliente?.NombreCompleto ?? "Cliente General",
                CedulaRnc = pedidoDb.Cliente?.CedulaRNC ?? "N/A",
                Fecha = pedidoDb.FechaCreacion,
                Subtotal = subtotal,
                Itbis = itbis,
                Detalles = pedidoDb.Articulos?.Select(a => new DetalleFactura
                {
                    Producto = a.Producto?.Nombre ?? "Producto Desconocido",
                    Cantidad = a.Cantidad,
                    Precio = a.PrecioUnitario,
                    Subtotal = a.PrecioUnitario * a.Cantidad
                }).ToList() ?? new List<DetalleFactura>()
            };

            var pdfBytes = PdfService.GenerarFactura(modeloFacturaPdf);
            var base64 = Convert.ToBase64String(pdfBytes);

            await JS.InvokeVoidAsync("abrirPdfEnPestana", base64);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al generar PDF: {ex.Message}");
        }
    }
}

