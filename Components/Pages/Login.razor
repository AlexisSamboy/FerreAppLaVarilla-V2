@page "/login"
@rendermode InteractiveServer
@using FerreAppLaVarilla.UI.Data
@using FerreAppLaVarilla.UI.Services
@inject ApplicationDbContext DbContext
@inject AutenticacionService AuthService
@inject NavigationManager Navigation

<PageTitle>Login - FerreAppLaVarilla</PageTitle>

<div class="login-page">

    <!-- PANEL IZQUIERDO -->
    <section class="left-panel">

        <div class="overlay"></div>

        <div class="left-content">

            <div class="logo">
                <span class="icon">⚡</span>
                <h1>
                    FerreApp<span>LaVarilla</span>
                </h1>
            </div>

            <div class="hero-text">
                <h2>
                    Tu ferretería <br />
                    de confianza, <br />
                    <span>siempre contigo.</span>
                </h2>

                <div class="line"></div>

                <p>
                    Inicia sesión para acceder a nuestros productos,
                    ofertas y gestionar tus pedidos de manera fácil y rápida.
                </p>
            </div>

            <div class="features">
                <div class="feature">🛡️ Productos de calidad</div>
                <div class="feature">🚚 Envíos rápidos</div>
                <div class="feature">🎧 Atención personalizada</div>
            </div>

            <div class="footer-text">
                © 2026 FerreAppLaVarilla. Todos los derechos reservados.
            </div>

        </div>

    </section>

    <!-- PANEL DERECHO -->
    <section class="right-panel">

        <div class="login-card">

            <div class="login-icon">🔒</div>

            <EditForm Model="this" OnValidSubmit="IniciarSesion">
                <div class="form-group">
                    <label>Correo electrónico</label>
                    <InputText @bind-Value="correo" placeholder="Ingresa tu correo" class="form-control" />
                </div>

                <div class="form-group">
                    <label>Contraseña</label>
                    <InputText type="password" @bind-Value="clave" placeholder="Ingresa tu contraseña" class="form-control" />
                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="error-message" style="background: #ffebee; color: #d32f2f; padding: 10px; border-radius: 6px; margin-bottom: 20px; font-weight: 600; text-align: center;">
                        ⚠️ @mensajeError
                    </div>
                }

                <div class="options">
                    <label><input type="checkbox" /> Recordarme</label>
                    <a href="#">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="login-btn">
                    Iniciar sesión
                </button>
            </EditForm>

        </div>

    </section>
@code {
    private string correo = "";
    private string clave = "";
    private string mensajeError = "";

    private void IniciarSesion()
    {
        // 1. Buscamos en la base de datos si hay un usuario con ese correo y clave
        var usuario = DbContext.Usuarios.FirstOrDefault(
    u => u.Correo == correo && u.Password == clave
);

        if (usuario != null)
        {
            // 2. Si lo encuentra, le decimos al Guardián que inicie la sesión con su Rol
            AuthService.MarcarUsuarioComoAutenticado(usuario);
            
            // 3. Lo redirigimos a la página de inicio
            Navigation.NavigateTo("/");
        }
        else
        {
            // 4. Si no lo encuentra, mostramos un error
            mensajeError = "Correo o contraseña incorrectos. Intenta de nuevo.";
        }
    }
}

</div>

<style>

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI';
    }

    body {
        background: #f5f7fa;
    }

    /* CONTENEDOR GENERAL */

    .login-page {
        display: flex;
        min-height: 100vh;
    }

    /* PANEL IZQUIERDO */

    .left-panel {
        width: 48%;
        background: url('images/login-bg.jpg') center/cover no-repeat;
        position: relative;
        display: flex;
        align-items: center;
        padding: 60px;
        color: white;
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: rgba(4, 20, 45, 0.82);
    }

    .left-content {
        position: relative;
        z-index: 2;
        width: 100%;
    }

    .logo {
        display: flex;
        align-items: center;
        margin-bottom: 60px;
    }

    .icon {
        font-size: 34px;
        margin-right: 12px;
    }

    .logo h1 {
        font-size: 38px;
        font-weight: 700;
    }

    .logo span {
        color: #f4b400;
    }

    .hero-text h2 {
        font-size: 58px;
        line-height: 1.15;
        margin-bottom: 25px;
    }

        .hero-text h2 span {
            color: #f4b400;
        }

    .line {
        width: 80px;
        height: 4px;
        background: #f4b400;
        border-radius: 20px;
        margin-bottom: 30px;
    }

    .hero-text p {
        font-size: 22px;
        line-height: 1.7;
        max-width: 600px;
        margin-bottom: 50px;
    }

    /* FEATURES */

    .features {
        display: flex;
        gap: 25px;
        margin-bottom: 60px;
        flex-wrap: wrap;
    }

    .feature {
        background: rgba(255,255,255,.08);
        padding: 18px 20px;
        border-radius: 14px;
        font-size: 16px;
        backdrop-filter: blur(8px);
    }

    .footer-text {
        font-size: 15px;
        opacity: .9;
    }

    /* PANEL DERECHO */

    .right-panel {
        width: 52%;
        background: #f7f8fc;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 50px;
    }

    .login-card {
        width: 100%;
        max-width: 620px;
        background: white;
        border-radius: 24px;
        padding: 60px;
        box-shadow: 0 10px 35px rgba(0,0,0,.05);
    }

    .login-icon {
        width: 90px;
        height: 90px;
        margin: auto;
        background: #f5f7fa;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 42px;
        margin-bottom: 30px;
    }

    .login-card h2 {
        text-align: center;
        font-size: 42px;
        color: #0d1b2a;
        margin-bottom: 12px;
    }

    .subtitle {
        text-align: center;
        color: #666;
        font-size: 18px;
        margin-bottom: 40px;
    }

    .form-group {
        margin-bottom: 25px;
    }

        .form-group label {
            display: block;
            margin-bottom: 10px;
            font-weight: 600;
            color: #222;
        }

        .form-group input {
            width: 100%;
            padding: 18px;
            border: 1px solid #ddd;
            border-radius: 12px;
            font-size: 15px;
            outline: none;
        }

            .form-group input:focus {
                border-color: #0d1b2a;
            }

    /* OPCIONES */

    .options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        font-size: 15px;
    }

        .options a {
            color: #0d1b2a;
            text-decoration: none;
            font-weight: 600;
        }

    /* BOTONES */

    .login-btn {
        width: 100%;
        background: linear-gradient(to right, #071a2f, #0d1b2a);
        color: white;
        border: none;
        padding: 18px;
        border-radius: 12px;
        font-size: 17px;
        font-weight: 600;
        cursor: pointer;
        margin-bottom: 35px;
    }

    .divider {
        text-align: center;
        color: #777;
        margin-bottom: 20px;
        font-size: 15px;
    }

    .register-btn {
        width: 100%;
        background: white;
        border: 1px solid #ddd;
        padding: 18px;
        border-radius: 12px;
        font-size: 16px;
        cursor: pointer;
        font-weight: 600;
    }

        .register-btn:hover {
            background: #fafafa;
        }

</style>
```
