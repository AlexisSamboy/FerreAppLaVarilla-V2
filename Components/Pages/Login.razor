@page "/login"
@rendermode InteractiveServer

@using FerreAppLaVarilla.UI.Data
@using FerreAppLaVarilla.UI.Services
@using Microsoft.AspNetCore.Components.Forms

@inject ApplicationDbContext DbContext
@inject AutenticacionService AuthService
@inject NavigationManager Navigation

<PageTitle>Login - FerreAppLaVarilla</PageTitle>

<div class="login-page">

    <!-- PANEL IZQUIERDO -->
    <section class="left-panel">

        <div class="overlay"></div>

        <div class="left-content">

            <div class="logo">
                <span class="icon">⚡</span>

                <h1>
                    FerreApp<span>LaVarilla</span>
                </h1>
            </div>

            <div class="hero-text">

                <h2>
                    Tu ferretería <br />
                    de confianza, <br />
                    <span>siempre contigo.</span>
                </h2>

                <div class="line"></div>

                <p>
                    Compra materiales, herramientas y productos
                    de construcción desde cualquier lugar.
                </p>

            </div>

            <div class="features">

                <div class="feature">
                    🛡️ Productos garantizados
                </div>

                <div class="feature">
                    🚚 Entregas rápidas
                </div>

                <div class="feature">
                    🎧 Atención personalizada
                </div>

            </div>

            <div class="footer-text">
                © 2026 FerreAppLaVarilla
            </div>

        </div>

    </section>

    <!-- PANEL DERECHO -->

    <section class="right-panel">

        <div class="login-card">

            <div class="login-icon">
                🔒
            </div>

            <h2>Bienvenido</h2>

            <p class="subtitle">
                Inicia sesión para continuar
            </p>

            <EditForm Model="this" OnValidSubmit="IniciarSesion">

                <DataAnnotationsValidator />

                <div class="form-group">

                    <label>Correo electrónico</label>

                    <InputText @bind-Value="correo"
                               class="form-control"
                               placeholder="Ingresa tu correo" />

                </div>

                <div class="form-group">

                    <label>Contraseña</label>

                    <InputText type="password"
                               @bind-Value="clave"
                               class="form-control"
                               placeholder="Ingresa tu contraseña" />

                </div>

                @if (!string.IsNullOrEmpty(mensajeError))
                {
                    <div class="error-message">
                        ⚠️ @mensajeError
                    </div>
                }

                <div class="options">

                    <label class="remember">
                        <input type="checkbox" />
                        Recordarme
                    </label>

                    <a href="#">
                        ¿Olvidaste tu contraseña?
                    </a>

                </div>

                <button type="submit"
                        class="login-btn"
                        disabled="@cargando">

                    @if (cargando)
                    {
                        <span>Ingresando...</span>
                    }
                    else
                    {
                        <span>Iniciar sesión</span>
                    }

                </button>

            </EditForm>

            <div class="divider">
                ¿No tienes cuenta?
            </div>

            <button class="register-btn"
                    @onclick="IrARegistro">

                Crear cuenta nueva

            </button>

        </div>

    </section>

</div>

@code {

    private string correo = "";
    private string clave = "";

    private string mensajeError = "";

    private bool cargando = false;

    private async Task IniciarSesion()
    {
        cargando = true;

        mensajeError = "";

        await Task.Delay(1000);

        var usuario = DbContext.Usuarios.FirstOrDefault(
            u => u.Correo == correo &&
                 u.Password == clave
        );

        if (usuario != null)
        {
            AuthService.MarcarUsuarioComoAutenticado(usuario);

            if (usuario.Rol == "Admin")
            {
                Navigation.NavigateTo("/panel-admin");
            }
            else
            {
                Navigation.NavigateTo("/");
            }
        }
        else
        {
            mensajeError = "Correo o contraseña incorrectos.";
        }

        cargando = false;
    }

    private void IrARegistro()
    {
        Navigation.NavigateTo("/registro");
    }

}