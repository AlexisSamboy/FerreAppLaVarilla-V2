@page "/productos"
@rendermode InteractiveServer

@using FerreAppLaVarilla.UI.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject FerreAppLaVarilla.UI.Services.ProductoService ProductoService
@inject FerreAppLaVarilla.UI.Services.CarritoService CarritoService
@inject FerreAppLaVarilla.UI.Services.AutenticacionService AuthService
@inject NavigationManager Navigation

<PageTitle>Catálogo - FerreApp La Varilla</PageTitle>

@if (mostrarToast)
{
    <div class="modern-toast slide-in">
        <div class="toast-icon">✅</div>
        <div class="toast-text">
            <strong>¡Agregado al carrito!</strong>
            <p>@productoAgregadoNombre (@cantidadAgregada unds.)</p>
        </div>
    </div>
}

<div class="premium-catalog-page">

    <header class="top-navbar">
        <div class="nav-brand" @onclick='() => Navigation.NavigateTo("/")' style="cursor: pointer;">
            <div class="brand-icon">⚡</div>
            <div class="brand-text">
                <h1>FerreApp<span>LaVarilla</span></h1>
                <p>Ferretería Inteligente</p>
            </div>
        </div>

        <nav class="nav-links">
            <a href="/">Inicio</a>
            <a href="/productos" class="active">Productos</a>
            <a href="#">Ofertas</a>
            <a href="#">Nosotros</a>

            <AuthorizeView Roles="Admin">
                <Authorized>
                    <a href="/panel-admin" class="admin-link">⚙️ Panel Admin</a>
                </Authorized>
            </AuthorizeView>
        </nav>

        <div class="nav-auth">
            <AuthorizeView>
                <Authorized>
                    <div class="user-pill">
                        <div class="avatar">👤</div>
                        <div class="user-info">
                            <strong>@context.User.Identity?.Name</strong>
                            <small>Sesión activa</small>
                        </div>
                    </div>
                    <button class="btn-cart-nav" @onclick='() => Navigation.NavigateTo("/carrito")'>🛒 Mi Carrito</button>
                    <button class="btn-logout" @onclick="CerrarSesion">Salir</button>
                </Authorized>
                <NotAuthorized>
                    <button class="btn-login" @onclick='() => Navigation.NavigateTo("/login")'>Iniciar sesión</button>
                    <button class="btn-cart-nav" @onclick='() => Navigation.NavigateTo("/carrito")'>🛒 Ver carrito</button>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </header>

    <section class="catalog-hero small-hero">
        <div class="hero-content">
            <h1>Productos Ferreteros</h1>
        </div>
    </section>

    <main class="catalog-main">
        
        <div class="filters-bar">
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="text" placeholder="Buscar herramientas, materiales, SKU..." @bind="textoBusqueda" @bind:event="oninput" @onkeyup="AplicarFiltros" class="search-input" />
            </div>

            <div class="category-pills">
                @foreach (var cat in categoriasDefecto)
                {
                    <button class="cat-pill @(categoriaSeleccionada == cat ? "active" : "")" @onclick="() => SeleccionarCategoria(cat)">
                        @cat
                    </button>
                }
            </div>
        </div>

        <div class="products-container">
            @if (productosMostrar == null)
            {
                <div class="state-box">
                    <div class="spinner"></div>
                    <p>Cargando catálogo...</p>
                </div>
            }
            else if (!productosMostrar.Any())
            {
                <div class="state-box">
                    <span class="state-icon">📦</span>
                    <h3>No se encontraron productos</h3>
                    <p>Intenta con otros filtros.</p>
                </div>
            }
            else
            {
                <div class="modern-grid">
                    @foreach (var vm in productosMostrar)
                    {
                        <div class="modern-card">
                            <div class="card-img-box">
                                <img src="images/@(string.IsNullOrEmpty(vm.Producto.ImagenUrl) ? "default.png" : vm.Producto.ImagenUrl)" 
                                     alt="@vm.Producto.Nombre" 
                                     onerror="this.src='images/default.png'" />
                                
                                @if (vm.Producto.Stock <= 0)
                                {
                                    <span class="badge-out">Agotado</span>
                                }
                            </div>

                            <div class="card-body">
                                <p class="sku-text">SKU: @vm.Producto.Sku</p>
                                <h3 class="product-title">@vm.Producto.Nombre</h3>
                                
                                <div class="price-row">
                                    <h2 class="price-tag">RD$ @vm.Producto.Precio.ToString("N2")</h2>
                                    <span class="stock-text">Stock: @vm.Producto.Stock</span>
                                </div>

                                <div class="card-footer">
                                    <div class="qty-selector">
                                        <button @onclick="() => { if(vm.Cantidad > 1) vm.Cantidad--; }">-</button>
                                        <input type="number" @bind="vm.Cantidad" min="1" max="@vm.Producto.Stock" />
                                        <button @onclick="() => { if(vm.Cantidad < vm.Producto.Stock) vm.Cantidad++; }">+</button>
                                    </div>

                                    <button class="btn-add-cart" disabled="@(vm.Producto.Stock <= 0)" @onclick="() => AgregarAlCarrito(vm)">
                                        🛒 Agregar
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if(totalPaginas > 1)
                {
                    <div class="pagination-bar">
                        <button class="page-btn" disabled="@(paginaActual == 1)" @onclick="PaginaAnterior">Anterior</button>
                        <span class="page-info">Página <strong>@paginaActual</strong> de @totalPaginas</span>
                        <button class="page-btn" disabled="@(paginaActual == totalPaginas)" @onclick="PaginaSiguiente">Siguiente</button>
                    </div>
                }
            }
        </div>
    </main>
</div>

@code {
    public class ProductoCatalogoVM {
        public required Producto Producto { get; set; }
        public int Cantidad { get; set; } = 1;
    }

    private List<Producto>? listaCompleta;
    private List<ProductoCatalogoVM>? productosMostrar;
    private string textoBusqueda = "";
    private string categoriaSeleccionada = "Todos";
    private List<string> categoriasDefecto = new() { "Todos", "Acabados", "Construcción", "Electricidad", "Herramientas", "Plomería" };

    private int paginaActual = 1;
    private int productosPorPagina = 12;
    private int totalPaginas = 1;

    private bool mostrarToast = false;
    private string productoAgregadoNombre = "";
    private int cantidadAgregada = 0;

    protected override async Task OnInitializedAsync()
    {
        listaCompleta = await ProductoService.ObtenerProductosAsync();
        AplicarFiltros();
    }

    private void SeleccionarCategoria(string cat)
    {
        categoriaSeleccionada = cat;
        paginaActual = 1; 
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        if (listaCompleta == null) return;
        var query = listaCompleta.Where(p => p.Activo).AsEnumerable();

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
            query = query.Where(p => p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

        var filtrados = query.ToList();
        totalPaginas = (int)Math.Ceiling((double)filtrados.Count / productosPorPagina);
        
        productosMostrar = filtrados
            .Skip((paginaActual - 1) * productosPorPagina)
            .Take(productosPorPagina)
            .Select(p => new ProductoCatalogoVM { Producto = p, Cantidad = 1 })
            .ToList();
    }

    private void PaginaAnterior() { if (paginaActual > 1) { paginaActual--; AplicarFiltros(); } }
    private void PaginaSiguiente() { if (paginaActual < totalPaginas) { paginaActual++; AplicarFiltros(); } }

    private async Task AgregarAlCarrito(ProductoCatalogoVM vm)
    {
        CarritoService.AgregarProducto(vm.Producto, vm.Cantidad);
        productoAgregadoNombre = vm.Producto.Nombre;
        cantidadAgregada = vm.Cantidad;
        mostrarToast = true;
        vm.Cantidad = 1; 
        StateHasChanged();
        
        // El Toast se ocultará automáticamente en 3 segundos
        await Task.Delay(3000);
        mostrarToast = false;
        StateHasChanged();
    }

    private void CerrarSesion() { AuthService.CerrarSesion(); Navigation.NavigateTo("/", true); }
}

<style>
    /* VARIABLES Y NAVBAR */
    .premium-catalog-page { font-family: 'Segoe UI', sans-serif; background-color: #f8fafc; min-height: 100vh; }
    .top-navbar { background: #0b1527; color: white; display: flex; justify-content: space-between; align-items: center; padding: 15px 40px; position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
    .nav-brand { display: flex; align-items: center; gap: 12px; }
    .brand-icon { width: 40px; height: 40px; background: #f4b400; color: #0b1527; display: flex; align-items: center; justify-content: center; border-radius: 10px; font-size: 20px; font-weight: bold; }
    .brand-text h1 { margin: 0; font-size: 22px; font-weight: 800; }
    .brand-text h1 span { color: #f4b400; }
    .brand-text p { margin: 0; font-size: 11px; color: #94a3b8; text-transform: uppercase; }

    .nav-links { display: flex; gap: 25px; }
    .nav-links a { color: #cbd5e1; text-decoration: none; font-weight: 600; font-size: 15px; }
    .nav-links a.active { color: #f4b400; }

    .nav-auth { display: flex; align-items: center; gap: 15px; }
    .btn-login { background: transparent; border: 1px solid rgba(255,255,255,0.3); color: white; padding: 8px 18px; border-radius: 10px; cursor: pointer; font-weight: 600; }
    
    .btn-cart-nav { background: #f4b400; border: none; color: #0b1527; padding: 8px 18px; border-radius: 10px; font-weight: 700; cursor: pointer; transition: 0.2s; }
    .btn-cart-nav:hover { background: #e0a600; transform: translateY(-2px); }

    .btn-logout { background: transparent; border: none; color: #ef4444; font-weight: 600; cursor: pointer; margin-left: 10px; }

    .user-pill { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,0.05); padding: 5px 15px 5px 5px; border-radius: 30px; border: 1px solid rgba(255,255,255,0.1); }
    .user-pill .avatar { width: 35px; height: 35px; background: #3b82f6; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; }
    .user-info { display: flex; flex-direction: column; }
    .user-info strong { font-size: 13px; line-height: 1.2; color: white; }
    .user-info small { font-size: 11px; color: #94a3b8; }

    /* HERO REDUCIDO */
    .small-hero { background: #0b1527; padding: 40px 20px; text-align: center; border-bottom: 5px solid #f4b400; }
    .hero-badge { display: inline-block; background: rgba(244, 180, 0, 0.15); color: #f4b400; padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 700; margin-bottom: 15px; }
    .small-hero h1 { color: white; font-size: 32px; font-weight: 800; margin: 0; }
    .btn-solid-yellow { background: #f4b400; color: #0b1527; border: none; padding: 12px 30px; border-radius: 12px; font-weight: 700; cursor: pointer; font-size: 16px; transition: 0.2s; }
    .btn-solid-yellow:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(244,180,0,0.3);}

    /* CATALOGO Y FILTROS */
    .catalog-main { max-width: 1250px; margin: 0 auto; padding: 40px 20px; }
    .filters-bar { background: white; padding: 20px; border-radius: 20px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px;}
    .search-box { position: relative; width: 100%; }
    .search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 18px;}
    .search-input { width: 100%; padding: 14px 20px 14px 45px; border: 1px solid #cbd5e1; border-radius: 12px; outline: none; transition: 0.2s; }
    .search-input:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
    
    .category-pills { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 5px; scrollbar-width: none; }
    .cat-pill { background: #f1f5f9; border: none; padding: 10px 20px; border-radius: 20px; font-weight: 600; cursor: pointer; white-space: nowrap; color: #475569; transition: 0.2s;}
    .cat-pill:hover { background: #e2e8f0; color: #0f172a;}
    .cat-pill.active { background: #0b1527; color: white; }

    /* GRID Y CARD */
    .modern-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; }
    .modern-card { background: white; border-radius: 20px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; overflow: hidden; transition: 0.3s; }
    .modern-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.05); border-color: #cbd5e1;}
    .card-img-box { height: 200px; padding: 20px; display: flex; align-items: center; justify-content: center; background: white; position: relative; border-bottom: 1px solid #f1f5f9;}
    .card-img-box img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .badge-out { position: absolute; top: 15px; right: 15px; background: #fee2e2; color: #dc2626; padding: 4px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; border: 1px solid #fecaca;}
    
    .card-body { padding: 20px; flex: 1; display: flex; flex-direction: column; }
    .sku-text { font-size: 12px; color: #94a3b8; margin: 0 0 5px 0; }
    .product-title { font-size: 16px; font-weight: 700; margin: 0 0 15px 0; color: #0b1527; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;}
    .price-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; }
    .price-tag { color: #16a34a; font-weight: 800; font-size: 22px; margin: 0; }
    .stock-text { font-size: 12px; color: #64748b; font-weight: 600; background: #f1f5f9; padding: 4px 8px; border-radius: 8px;}

    /* FOOTER CARD (CANTIDAD + BOTÓN) */
    .card-footer { display: flex; gap: 10px; margin-top: auto; padding-top: 15px; border-top: 1px solid #f1f5f9; }
    .qty-selector { display: flex; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
    .qty-selector button { width: 35px; border: none; background: #f8fafc; font-weight: bold; cursor: pointer; color: #475569; font-size: 16px; transition: 0.2s;}
    .qty-selector button:hover { background: #e2e8f0; color: #0f172a;}
    .qty-selector input { width: 45px; text-align: center; border: none; border-left: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; font-weight: bold; font-size: 15px; -moz-appearance: textfield; color: #0f172a;}
    .btn-add-cart { flex: 1; background: #0b1527; color: white; border: none; border-radius: 10px; font-weight: 600; cursor: pointer; font-size: 14px; transition: 0.2s;}
    .btn-add-cart:hover { background: #f4b400; color: #0b1527; }
    .btn-add-cart:disabled { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; }

    /* PAGINACIÓN */
    .pagination-bar { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 40px; }
    .page-btn { background: white; border: 1px solid #cbd5e1; padding: 10px 20px; border-radius: 12px; font-weight: 600; cursor: pointer; transition: 0.2s; color: #0f172a;}
    .page-btn:hover:not(:disabled) { background: #f8fafc; border-color: #94a3b8; }
    .page-btn:disabled { background: #f1f5f9; color: #94a3b8; cursor: not-allowed; border-color: #e2e8f0; }
    .page-info { font-size: 15px; color: #475569; }

    /* ESTADOS (Cargando / Vacío) */
    .state-box { text-align: center; padding: 60px 20px; background: white; border-radius: 20px; border: 1px dashed #cbd5e1; }
    .state-icon { font-size: 40px; margin-bottom: 15px; display: block; }
    .state-box h3 { margin: 0 0 10px 0; color: #0f172a; }
    .state-box p { margin: 0; color: #64748b; }
    .spinner { width: 40px; height: 40px; border: 4px solid #f1f5f9; border-top: 4px solid #f4b400; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px auto; }
    @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    /* TOAST MODERNO */
    .modern-toast { position: fixed; bottom: 30px; right: 30px; background: white; border-left: 5px solid #10b981; border-radius: 12px; padding: 15px 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); z-index: 2000; border-top: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; min-width: 250px;}
    .toast-icon { font-size: 24px; }
    .toast-text { flex: 1; }
    .toast-text strong { display: block; color: #0f172a; font-size: 15px; margin-bottom: 3px; }
    .toast-text p { margin: 0; color: #475569; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px;}
    
    .slide-in { animation: slideIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    @@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    /* RESPONSIVE */
    @@media (max-width: 900px) {
        .nav-links { display: none; }
        .modern-grid { grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); }
    }
</style>