@page "/productos"
@rendermode InteractiveServer

@using FerreAppLaVarilla.UI.Models
@inject FerreAppLaVarilla.UI.Services.ProductoService ProductoService
@inject FerreAppLaVarilla.UI.Services.CarritoService CarritoService
@inject NavigationManager Navigation

<PageTitle>Productos - FerreAppLaVarilla</PageTitle>

<!-- TOAST FLOTANTE -->
@if (mostrarToast)
{
    <div class="toast-overlay">

        <div class="toast-cart animate-toast">

            <div class="toast-icon">
                ✅
            </div>

            <div class="toast-content">

                <strong>
                    Producto agregado al carrito
                </strong>

                <p>
                    @productoAgregadoNombre
                </p>

            </div>

            <button class="toast-close"
                    @onclick="CerrarToast">

                ✖

            </button>

        </div>

    </div>
}

<div class="productos-page">

    <!-- HERO -->
    <section class="productos-hero">

        <div class="hero-overlay"></div>

        <div class="hero-content">

            <div class="hero-text">

                <span class="hero-tag">
                    ⚡ Ferretería Profesional
                </span>

                <h1>
                    Catálogo de Productos
                </h1>

                <p>
                    Encuentra herramientas, materiales y soluciones
                    para cada etapa de tu proyecto.
                </p>

            </div>

            <div class="hero-actions">

                <button class="back-btn"
                        @onclick='() => Navigation.NavigateTo("/")'>

                    🏠 Inicio

                </button>

                <button class="cart-btn"
                        @onclick='() => Navigation.NavigateTo("/carrito")'>

                    🛒 Carrito

                </button>

            </div>

        </div>

    </section>

    <!-- FILTROS -->
    <section class="filters-section">

        <div class="search-box">

            <input type="text"
                   placeholder="Buscar productos..." />

        </div>

        <div class="filters">

            <button class="filter active">
                Todos
            </button>

            <button class="filter">
                Herramientas
            </button>

            <button class="filter">
                Electricidad
            </button>

            <button class="filter">
                Plomería
            </button>

            <button class="filter">
                Pinturas
            </button>

        </div>

    </section>

    <!-- PRODUCTOS -->

    <section class="products-container">

        @if (listaProductos == null)
        {
            <div class="loading">

                <div class="spinner"></div>

                <h3>Cargando productos...</h3>

            </div>
        }
        else if (!listaProductos.Any())
        {
            <div class="empty-products">

                <h2>No hay productos registrados</h2>

                <p>
                    Agrega productos desde el panel administrativo.
                </p>

            </div>
        }
        else
        {
            <div class="products-grid">

                @foreach (var producto in listaProductos)
                {
                    <div class="product-card">

                        <div class="product-image-container">

                            <img src="images/@(string.IsNullOrEmpty(producto.ImagenUrl) ? "default.png" : producto.ImagenUrl)"
                                 alt="@producto.Nombre"
                                 class="product-image"
                                 onerror="this.src='images/default.png'" />

                            <div class="stock-badge @(producto.Stock <= 0 ? "danger" : "")">

                                @(producto.Stock > 0 ? "Disponible" : "Agotado")

                            </div>

                        </div>

                        <div class="product-info">

                            <h3>@producto.Nombre</h3>

                            <p class="sku">
                                SKU: @producto.Sku
                            </p>

                            <p class="description">
                                @producto.Descripcion
                            </p>

                            <div class="price-section">

                                <div>

                                    <span class="price-label">
                                        Precio
                                    </span>

                                    <h2>
                                        RD$ @producto.Precio.ToString("N2")
                                    </h2>

                                </div>

                                <div class="stock">
                                    Stock: @producto.Stock
                                </div>

                            </div>

                            <div class="product-actions">

                                <button class="add-cart-btn"
                                        @onclick="() => AgregarAlCarrito(producto)"
                                        disabled="@(producto.Stock <= 0)">

                                    🛒 Añadir

                                </button>

                                <button class="details-btn">

                                    👁 Ver

                                </button>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </section>

</div>

@code {

    private List<Producto>? listaProductos;

    private bool mostrarToast = false;

    private string productoAgregadoNombre = "";

    protected override async Task OnInitializedAsync()
    {
        listaProductos = await ProductoService.ObtenerProductosAsync();
    }

    private async Task AgregarAlCarrito(Producto producto)
    {
        CarritoService.AgregarProducto(producto, 1);

        productoAgregadoNombre = producto.Nombre;

        mostrarToast = true;

        StateHasChanged();

        await Task.Delay(3500);

        mostrarToast = false;

        StateHasChanged();
    }

    private void CerrarToast()
    {
        mostrarToast = false;
    }
}