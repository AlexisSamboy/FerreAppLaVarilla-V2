@page "/productos"
@rendermode InteractiveServer

@using FerreAppLaVarilla.UI.Models
@inject FerreAppLaVarilla.UI.Services.ProductoService ProductoService
@inject FerreAppLaVarilla.UI.Services.CarritoService CarritoService
@inject NavigationManager Navigation

<PageTitle>Catálogo - FerreApp La Varilla</PageTitle>

@if (mostrarToast)
{
    <div class="modern-toast slide-in">
        <div class="toast-icon">✅</div>
        <div class="toast-text">
            <strong>¡Agregado al carrito!</strong>
            <p>@productoAgregadoNombre</p>
        </div>
        <button class="toast-close" @onclick="CerrarToast">✖</button>
    </div>
}

<div class="public-catalog-page">

    <section class="catalog-hero">
        <div class="hero-content">
            <span class="hero-badge">⚡ Ferretería Profesional</span>
            <h1>Catálogo de Productos</h1>
            <p>Encuentra herramientas, materiales y soluciones para cada etapa de tu proyecto.</p>
            
            <div class="hero-actions">
                <button class="btn-outline-light" @onclick='() => Navigation.NavigateTo("/")'>🏠 Volver al Inicio</button>
                <button class="btn-solid-yellow" @onclick='() => Navigation.NavigateTo("/carrito")'>🛒 Ver mi Carrito</button>
            </div>
        </div>
    </section>

    <main class="catalog-main">
        
        <div class="filters-bar">
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="text" placeholder="Buscar productos por nombre..." @bind="textoBusqueda" @bind:event="oninput" @onkeyup="AplicarFiltros" class="search-input" />
            </div>

            <div class="category-pills">
                @foreach (var cat in categoriasDefecto)
                {
                    <button class="cat-pill @(categoriaSeleccionada == cat ? "active" : "")" @onclick="() => SeleccionarCategoria(cat)">
                        @cat
                    </button>
                }
            </div>
        </div>

        <div class="products-container">
            @if (productosMostrar == null)
            {
                <div class="state-box">
                    <div class="spinner"></div>
                    <p>Cargando catálogo...</p>
                </div>
            }
            else if (!productosMostrar.Any())
            {
                <div class="state-box">
                    <span class="state-icon">📦</span>
                    <h3>No se encontraron productos</h3>
                    <p>Intenta usar otros términos de búsqueda o cambiar de categoría.</p>
                </div>
            }
            else
            {
                <div class="modern-grid">
                    @foreach (var producto in productosMostrar)
                    {
                        <div class="modern-card">
                            <div class="card-img-box">
                                <img src="images/@(string.IsNullOrEmpty(producto.ImagenUrl) ? "default.png" : producto.ImagenUrl)" 
                                     alt="@producto.Nombre" 
                                     onerror="this.src='images/default.png'" />
                                
                                @if (producto.Stock <= 0)
                                {
                                    <span class="badge-out">Agotado</span>
                                }
                                else if (producto.Stock <= producto.StockMinimo)
                                {
                                    <span class="badge-low">Pocas unidades</span>
                                }
                            </div>

                            <div class="card-body">
                                <p class="sku-text">SKU: @producto.Sku</p>
                                <h3 class="product-title" title="@producto.Nombre">@producto.Nombre</h3>
                                
                                <div class="price-row">
                                    <h2 class="price-tag">RD$ @producto.Precio.ToString("N2")</h2>
                                </div>

                                <div class="card-footer">
                                    <span class="stock-text">Disp: @producto.Stock</span>
                                    <button class="btn-add-cart" disabled="@(producto.Stock <= 0)" @onclick="() => AgregarAlCarrito(producto)">
                                        @(producto.Stock > 0 ? "🛒 Agregar" : "Sin Stock")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if(totalPaginas > 1)
                {
                    <div class="pagination-bar">
                        <button class="page-btn" disabled="@(paginaActual == 1)" @onclick="PaginaAnterior">Anterior</button>
                        <span class="page-info">Página <strong>@paginaActual</strong> de @totalPaginas</span>
                        <button class="page-btn" disabled="@(paginaActual == totalPaginas)" @onclick="PaginaSiguiente">Siguiente</button>
                    </div>
                }
            }
        </div>

    </main>
</div>

@code {
    // Datos
    private List<Producto>? listaCompleta;
    private List<Producto>? productosMostrar;
    
    // Filtros
    private string textoBusqueda = "";
    private string categoriaSeleccionada = "Todos";
    private List<string> categoriasDefecto = new() { "Todos", "Acabados", "Construcción", "Electricidad", "Herramientas", "Plomería" };

    // Paginación
    private int paginaActual = 1;
    private int productosPorPagina = 12; // Muestra 12 productos por página
    private int totalPaginas = 1;

    // Toast
    private bool mostrarToast = false;
    private string productoAgregadoNombre = "";

    protected override async Task OnInitializedAsync()
    {
        // Simulamos carga para UX (opcional, puedes quitarlo)
        await Task.Delay(300);
        listaCompleta = await ProductoService.ObtenerProductosAsync();
        AplicarFiltros();
    }

    // --- LÓGICA DE FILTROS Y PAGINACIÓN ---
    private void SeleccionarCategoria(string cat)
    {
        categoriaSeleccionada = cat;
        paginaActual = 1; 
        AplicarFiltros();
    }

    private void AplicarFiltros()
    {
        if (listaCompleta == null) return;

        var query = listaCompleta.Where(p => p.Activo).AsEnumerable();

        if (categoriaSeleccionada != "Todos")
        {
            query = query.Where(p => p.Categoria != null && p.Categoria.Equals(categoriaSeleccionada, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrWhiteSpace(textoBusqueda))
        {
            query = query.Where(p => p.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) || 
                                     p.Sku.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));
        }

        var filtrados = query.ToList();
        
        totalPaginas = (int)Math.Ceiling((double)filtrados.Count / productosPorPagina);
        if (totalPaginas == 0) totalPaginas = 1;
        if (paginaActual > totalPaginas) paginaActual = 1;

        productosMostrar = filtrados
            .Skip((paginaActual - 1) * productosPorPagina)
            .Take(productosPorPagina)
            .ToList();
    }

    private void PaginaAnterior() { if (paginaActual > 1) { paginaActual--; AplicarFiltros(); } }
    private void PaginaSiguiente() { if (paginaActual < totalPaginas) { paginaActual++; AplicarFiltros(); } }

    // --- LÓGICA DE CARRITO ---
    private async Task AgregarAlCarrito(Producto producto)
    {
        CarritoService.AgregarProducto(producto, 1);
        productoAgregadoNombre = producto.Nombre;
        mostrarToast = true;
        
        StateHasChanged();
        await Task.Delay(3000);
        mostrarToast = false;
        StateHasChanged();
    }

    private void CerrarToast() => mostrarToast = false;
}

<style>
    /* =========================================
       DISEÑO BASE (Estilo Premium FerreApp)
    ========================================= */
    .public-catalog-page { background: #f5f7fb; min-height: 100vh; font-family: 'Segoe UI', system-ui, sans-serif; }

    /* HERO SECTION */
    .catalog-hero { background: #0b1527; padding: 60px 20px; text-align: center; color: white; border-bottom: 5px solid #f4b400; }
    .hero-badge { background: rgba(244, 180, 0, 0.15); color: #f4b400; padding: 6px 16px; border-radius: 20px; font-size: 13px; font-weight: 700; display: inline-block; margin-bottom: 15px; border: 1px solid rgba(244, 180, 0, 0.3);}
    .hero-content h1 { font-size: 40px; font-weight: 800; margin: 0 0 10px 0; }
    .hero-content p { font-size: 16px; color: #94a3b8; max-width: 600px; margin: 0 auto 30px auto; }
    
    .hero-actions { display: flex; justify-content: center; gap: 15px; }
    .btn-outline-light { background: transparent; border: 1px solid rgba(255,255,255,0.3); color: white; padding: 12px 24px; border-radius: 12px; font-weight: 600; cursor: pointer; transition: 0.2s; }
    .btn-outline-light:hover { background: rgba(255,255,255,0.1); }
    .btn-solid-yellow { background: #f4b400; color: #0b1527; border: none; padding: 12px 24px; border-radius: 12px; font-weight: 700; cursor: pointer; transition: 0.2s; }
    .btn-solid-yellow:hover { background: #e0a600; transform: translateY(-2px); }

    /* MAIN CONTENT */
    .catalog-main { max-width: 1200px; margin: 0 auto; padding: 40px 20px; }

    /* BÚSQUEDA Y FILTROS */
    .filters-bar { background: white; padding: 20px; border-radius: 20px; box-shadow: 0 5px 20px rgba(0,0,0,0.03); margin-bottom: 30px; border: 1px solid #e2e8f0; display: flex; flex-direction: column; gap: 20px;}
    .search-box { position: relative; width: 100%; }
    .search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: 18px;}
    .search-input { width: 100%; padding: 16px 20px 16px 50px; border: 1px solid #cbd5e1; border-radius: 14px; font-size: 16px; outline: none; transition: 0.2s; background: #f8fafc; box-sizing: border-box;}
    .search-input:focus { border-color: #3b82f6; background: white; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
    
    .category-pills { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 5px; scrollbar-width: none; }
    .cat-pill { background: #f1f5f9; border: none; color: #475569; padding: 10px 20px; border-radius: 20px; font-size: 14px; font-weight: 600; cursor: pointer; transition: 0.2s; white-space: nowrap; }
    .cat-pill:hover { background: #e2e8f0; color: #0f172a;}
    .cat-pill.active { background: #0b1527; color: white; }

    /* GRID DE PRODUCTOS */
    .modern-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 25px; }
    
    .modern-card { background: white; border-radius: 20px; border: 1px solid #e2e8f0; overflow: hidden; transition: 0.3s; display: flex; flex-direction: column; }
    .modern-card:hover { border-color: #cbd5e1; box-shadow: 0 15px 30px rgba(0,0,0,0.06); transform: translateY(-5px); }

    .card-img-box { position: relative; background: white; height: 200px; padding: 20px; display: flex; align-items: center; justify-content: center; border-bottom: 1px solid #f1f5f9;}
    .card-img-box img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .badge-out { position: absolute; top: 15px; right: 15px; background: #fee2e2; color: #dc2626; padding: 4px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; border: 1px solid #fecaca;}
    .badge-low { position: absolute; top: 15px; right: 15px; background: #fef3c7; color: #d97706; padding: 4px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; border: 1px solid #fde68a;}

    .card-body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
    .sku-text { font-size: 12px; color: #94a3b8; margin: 0 0 5px 0; }
    .product-title { font-size: 16px; font-weight: 700; color: #0f172a; margin: 0 0 15px 0; line-height: 1.3; flex: 1; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .price-row { margin-bottom: 15px; }
    .price-tag { font-size: 22px; font-weight: 800; color: #16a34a; margin: 0; }

    .card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: 15px; border-top: 1px solid #f1f5f9;}
    .stock-text { font-size: 13px; font-weight: 600; color: #475569; }
    .btn-add-cart { background: #0b1527; color: white; border: none; padding: 10px 16px; border-radius: 10px; font-weight: 600; cursor: pointer; transition: 0.2s; font-size: 13px;}
    .btn-add-cart:hover { background: #f4b400; color: #0b1527; }
    .btn-add-cart:disabled { background: #e2e8f0; color: #94a3b8; cursor: not-allowed; }

    /* PAGINACIÓN */
    .pagination-bar { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 40px; }
    .page-btn { background: white; border: 1px solid #cbd5e1; padding: 10px 20px; border-radius: 12px; font-weight: 600; color: #0f172a; cursor: pointer; transition: 0.2s;}
    .page-btn:hover:not(:disabled) { background: #f8fafc; border-color: #94a3b8; }
    .page-btn:disabled { background: #f1f5f9; color: #94a3b8; cursor: not-allowed; border-color: #e2e8f0; }
    .page-info { font-size: 15px; color: #475569; }

    /* ESTADOS VACÍOS / CARGA */
    .state-box { text-align: center; padding: 60px 20px; background: white; border-radius: 20px; border: 1px dashed #cbd5e1; }
    .state-icon { font-size: 40px; margin-bottom: 15px; display: block; }
    .state-box h3 { margin: 0 0 10px 0; color: #0f172a; }
    .state-box p { margin: 0; color: #64748b; }
    .spinner { width: 40px; height: 40px; border: 4px solid #f1f5f9; border-top: 4px solid #f4b400; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px auto; }
    @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

    /* TOAST MODERNO */
    .modern-toast { position: fixed; bottom: 30px; right: 30px; background: white; border-left: 5px solid #10b981; border-radius: 12px; padding: 15px 20px; display: flex; align-items: center; gap: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); z-index: 10000; border-top: 1px solid #e2e8f0; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; min-width: 300px;}
    .toast-icon { font-size: 24px; }
    .toast-text { flex: 1; }
    .toast-text strong { display: block; color: #0f172a; font-size: 15px; margin-bottom: 3px; }
    .toast-text p { margin: 0; color: #475569; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px;}
    .toast-close { background: transparent; border: none; font-size: 14px; color: #94a3b8; cursor: pointer; }
    .toast-close:hover { color: #dc2626; }
    
    .slide-in { animation: slideIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
    @@keyframes slideIn { from { transform: translateX(100%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

    /* RESPONSIVE */
    @@media (max-width: 768px) {
        .hero-actions { flex-direction: column; }
        .modern-grid { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
    }
</style>